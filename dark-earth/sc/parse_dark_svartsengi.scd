// So: no `var` at the top, no `s`, no Synth/Bus/Buffer, no path or read idiom, no randomness. Tables and
// functions only. Every constant lives in ~svkK; the numbers are DESIGN §4's initial constants unless the
// comment says "W2 tuning", and each of those is listed in lab/notes/2026-10-20_W2_sound_engine.md for Miguel.

// ---------------------------------------------------------------- THE constants --
~svkK = (
    // ---- shared (CONTRACT §1) -------------------------------------------------------------
    TRANSPOSE: 250,                    // seismic Hz × 250 = audio Hz, every layer (R1)
    SR_SEIS: 100,                      // MELH HH* sample rate, Hz
    RING: 262144,                      // Ground ring frames per channel (CONTRACT §5)
    BLOCK: 16384,                      // want/fill block, frames (16 blocks per ring)
    bands: [[0.1, 1], [1, 5], [5, 15], [15, 45]],   // micro · tremor · mid · vt, seismic Hz

    // ---- level mix (DESIGN §4.5). Columns = the page's weights w0..w4 =
    //      [minutes, hours, day, cycle, sequence]; a component's gain = Σ w_k × row_k.
    //      The Swarm row of the table is split into its four renderings.
    mix: (
        // v0.11 (Body v2, DESIGN §4.0): the spectroscopic body and the eruption strike are the default sound
        body2:        [0.25, 0.3, 0.8, 1.0, 1.0],   // W2: the body at every level; at hours/minutes (the regime room) it
                                                    //   sits under the Ground, as DESIGN §4.5's Body row (0.3 at hours)
        strike:       [0.3, 0.6,  1.0, 1.0, 1.0],   // W2: the eruption strike, strongest above hours
        // retired from the default mix (v0.11), kept for comparison: the Tension voices, the 4-band Body,
        // the stand-alone Array and Rumble (their old rows are in ~svkK[\mixLegacy])
        tension:      [0, 0, 0, 0, 0],
        body:         [0, 0, 0, 0, 0],
        swarmTexture: [0,   0,    0,   0,   0.6],   // the pulse train (rate → pitch → noise band)
        swarmGrain:   [0,   0,    1.0, 0,   0  ],   // one pulsaret per catalogue event
        swarmBell:    [0,   0,    1.0, 1.0, 0  ],   // M ≥ 2 at fc × 250 (DESIGN §4.3: cycle AND day)
        swarmTick:    [0.3, 0.4,  0,   0,   0  ],   // a dry tick at each catalogue onset, over the Ground
        ground:       [1.0, 1.0,  0.3, 0,   0  ],
        array:        [0, 0, 0, 0, 0],
        rumble:       [0, 0, 0, 0, 0]
    ),
    mixLegacy: (tension: [0, 0.15, 0.3, 0.6, 1.0], body: [0, 0.3, 0.6, 0.8, 0.8],
                array: [0, 0.3, 0.8, 0.9, 1.0], rumble: [0, 0.3, 0.9, 1.0, 1.0]),
    // v0.12 the sound-tab faders (/svk_mix body strike swarm bells ground, 0–1 each, 1 at boot): each scales its
    // components' zoom-level gains multiplicatively; the legend's solo holds are not faded (they explain a layer)
    faderMap: (body: [\body2, \body], strike: [\strike], swarm: [\swarmTexture, \swarmGrain, \swarmTick],
               bells: [\swarmBell], ground: [\ground]),
    faderOrder: [\body, \strike, \swarm, \bells, \ground],
    legacyVoices: false,               // v0.11: the retired voices are not even spawned (CPU, the web build); true =
                                       //   spawn them for an A/B (their mix rows must then be set back from mixLegacy)
    spaceOn: false,                    // v0.11: the v0.10 FDN space is retired; the body's room comb is the room
    fdnSend: 0,                        // v0.11.7: NO FDN (Miguel: "your rewilding way"); the comb is the room. The A/B
    fdnSendLow: 0.15,                  //   variant (0.15, dev /svk_fdn) stays in code only

    // ---- Body v2 (v0.11; DESIGN §4.0, R5; CONTRACT §9): the constants are re_wilding's, everything else is data --
    body2Amp: 0.58,                    // re_wilding's drone level (\rwContinuous droneAmp 0.58)
    body2ExAmp: 0.03,                  // the bow: (PinkNoise + 1.5·Dust) × 0.03 at bow_db 0 (re_wilding)
    body2DustAmp: 1.5,
    body2Glide: 4.0,                   // gains glide over 4 s (Lag, 60 dB time), as re_wilding
    body2Fade: 4.0,                    // a room change: 4-s crossfade between two body instances (DESIGN §4.0)
    body2CombDecay: [0.10, 0.45],      // combDecay = 0.10 + 0.45 · pressure, s (re_wilding); rest = mid-travel 0.325
    body2Overtone: 0.85,               // W2: ring × 0.85^(harm−1) for harm ≥ 2 (a little shorter, QNM-like; §9.1)
    body2KindTrimDb: [0, 0, -15],      // W2 tuning (sequence, cycle, regime): the regime rooms are bowed at full strength
                                       //   (bow_db 0, CONTRACT §9.2) while the deformation rooms follow the inflow (−7…−23 dB);
                                       //   −15 dB keeps the hours mix as Miguel's favourite clip: the Ground in front, the
                                       //   body low underneath (calibrated on the Ground-to-rest balance, see the notes)
    body2BowNeutralDb: -10.65,         // v0.11.8: a null bow_neutral_db (cycle_2, cycle_3) → sequence_0's −10.65 dB
    body2CombLo: 35,                   // v0.11.3: each room's comb folded by octaves into 35–140 Hz (re_wilding's register)
    body2CombHi: 140,
    body2Pans: (deform: [-0.5, 0.5, 0], regime: [0, -0.5, 0.5]),   // W2: the 12-mode blocks (SKSH/SENG/THOB · Z/N/E)
    body2Veil: 1,                      // gap 2 → veiled (shorter rings, darker)
    roomSend: (swarm: 0.25, grain: 0.25, bell: 0.25, strike: 0.25, tick: 0, ground: 0),   // into the comb (re_wilding's clave
                                       //   send 0.25); ticks and the Ground stay dry (the evidence and its claim)
    strikeAmp: 0.35,                   // W2: the eruption strike at size 1 (−9 dB at size 0)
    strikeDecay: [3.0, 9.0],           // W2: ring 3 s at size 0 → 9 s at size 1
    strikeMinHz: 30,                   // W2: the room's lowest mode, raised by octaves to ≥ 30 Hz

    // ---- one deep shared space (v0.10, \svkSpace): an 8-line FDN, dark and long. Every voice sends into it
    spaceT60: 7,                       // W2: decay time, s (low/mid; the loop's lowpass makes the highs die sooner)
    spaceDamp: 2800,                   // W2: the loop's lowpass, Hz (dark)
    spaceWet: 0.5,                     // W2: the space's return level
    spacePre: 0.02,                    // pre-delay, s
    send: (tension: 0.3, deform: 0.45, body: 0.4, swarm: 0.15, grain: 0.25, tick: 0.04, bell: 0.55,
           groundZ: 0.25, groundH: 0.12, groundT: 0.5, rumble: 0.3),   // W2: per-voice sends (Array: per station)

    // ---- Tension (DESIGN §4.1, REOPENED v0.3: two encodings behind one switch; Miguel chooses by ear) --------
    tensionEncoding: \C,               // v0.10: T-C is the default (Miguel: "go with T-C"); \A and \B stay behind
                                       //   /svk_tension_mode 0|1|2
    tensionALo: 110,                   // T-A pitch = 110 · 3^u_abs: SKSH Up on the whole-sequence scale, 110–330 Hz
    tensionAHi: 330,
    tensionARangeMm: 1008,             // T-A FALLBACK only, for a sender without v0.8's ref_abs: the span of u_abs's
                                       //   scale in mm (v0.8 §5.0: SKSH_u_ds min–max, −339.41 … 668.97), to put
                                       //   above_last_start_mm on it. From v0.8 the page sends ref_abs and this is
                                       //   unused (it was 837, the p01–p99 span, until W1's v0.8 rebuild)
    tensionRefRel: 0.1,                // T-A reference tone amplitude = 0.1 × tensionAmp: measured ≈ 10 dB under the
                                       //   bowed voice (whose filtered output is far below its `amp`): quiet, held
    waitBeatHz: 1.5,                   // T-A the wait: the voice's twin beats at 1.5 Hz × wait_rel (0 just after a
                                       //   fall; 1.5 Hz at the longest earlier wait; 5 Hz at today's 3.32) …
    waitRough: 0.2,                    //   … and past 1.0 (new territory) roughness grows: 33 Hz AM depth
    waitRoughMax: 0.5,                 //   0.2 × (wait_rel − 1), capped at 0.5
    tensionBaseHz: 110,                // T-B pitch = 110 · 2^recharge_frac (no claim that the octave is a trigger)
    // T-C "the deformation mode" (v0.9, DESIGN §4.1, FINDINGS F7): the eruption cycle's own frequency, its shape, its
    //   inflow. A second fixed transposition (R1): deformation cycles move up DEFORM_OCTAVES, seismic ones 250×.
    DEFORM_OCTAVES: 30,                // f0 = 2^30 / (cycle_period_d · 86400): 26 d → 478 Hz · 131 d → 95 · 435 d → 28.6
    deformAmp: 0.3,                    // W2 tuning: level at mix gain 1 and inflow_rel 1 (level-matched, see below)
    deformFloorDb: -30,                // the envelope in dB (coordinator, v0.9): level = 20·log10(inflow_rel), so the
                                       //   whole-sequence max (7.45 mm/d, 2023-12-23) is 0 dB, 2024's 0.64 is −3.9 dB and
                                       //   today's 0.067 is −23.5 dB, the quietest the mode has been. W2: floored at
                                       //   −30 dB so it never vanishes; the floor sits below every real value
    // (the v0.9 "carrier lift" — partials tilted toward the top below 110 Hz — is REMOVED: Miguel did not like it,
    //  2026-10-20. T-C plays its measured partials h1–h6 as they are.)
    deformRise: 0.1,                   // f0 lag going up (a new, shorter cycle after an eruption), s
    deformFall: 1.4,                   // f0 lag going down (the cycle lengthening as the wait grows), s
    deformStrike: 1.0,                 // the re-strike at each eruption: +6 dB, brighter, and a long ringdown tail …
    deformTauD: 231,                   //   … scaled from the inflow's decay time τ ≈ 231 d (FINDINGS F7) at …
    deformTauSecPerDay: 0.03,          //   … 0.03 s per day: a 6.9-s ringdown (v0.10, W2), then the inflow level
    deformCents: [2.0, 3.0, 3.7, 4.4, 5.2, 6.1],   // v0.10: each partial doubled a few cents sharp: slow beating
    // the three encodings level-matched (Miguel compares sound, not loudness): multipliers on each one's amp.
    //   Measured 2026-10-20 on Tension-only plays of the whole sequence (dev/render/out_v09, _cal_tension_solo_*),
    //   W1's v0.9 L0, the dB envelope and carrier lift in place: T-A −21.0, T-B −23.0, T-C −20.4 LUFS → referred
    //   to T-A: B × 10^(2.0/20) = 1.26, C × 10^(−0.6/20) = 0.93
    tensionLevel: (A: 1.0, B: 1.26, C: 0.93),
    tensionAmp: 0.48,                  // W2 tuning: level at mix gain 1 (the_ending renders ≈ −21 LUFS, T-B alone)
    tensionRise: 0.12,                 // pitch lag going UP, s (60 dB time, on log2 f): follows the recharge
    tensionFall: 1.4,                  // pitch lag going DOWN, s: every drop is heard as a glide, never a step
    fallDrop: 0.25,                    // v0.1/0.2 senders only (no wait_rel): a drop of recharge_frac > this = a fall
    scrapeAmp: 0.5,                    // the bow-scrape at the onset of each fall
    pressNeutral: 0.3,                 // bow pressure when u_rate is null (interpolated days, gap = 2)

    // ---- Body (DESIGN §4.2) -----------------------------------------------------------------
    // mode-group centres = the bands' geometric centres × TRANSPOSE = 79 / 559 / 2165 / 6495 Hz (~svkBodyCentres)
    bodySpread: [0.965, 1.0, 1.038],   // three partials a few percent apart per group (one DynKlank each, L/C/R)
    bodySpreadAmp: [0.7, 1.0, 0.6],
    bodyRing: [4.5, 2.8, 1.6, 0.9],    // v0.10: longer ring per group, s (was 1.8 / 1.1 / 0.6 / 0.35)
    bodyCal: [0.416, 1.0, 2.036, 4.138],  // W2 tuning: per-group gain so that each band ALONE (legend hold, e 0.8)
                                       //   has equal K-weighted loudness (BS.1770). Measured 2026-10-20 at cal 1:
                                       //   micro −17.6 · tremor −27.1 · mid −36.4 · vt −43.3 dBFS RMS (pink excitation
                                       //   and Ringz gain tilt the body 26 dB toward the bottom); K-weighted, referred
                                       //   to tremor. Equal-excitation normalisation acts on the gains BEFORE this
    bodyContrastLo: 0.3,               // contrast term k(c) = 0.3 + 1.4·c  (c = room percentile; 0.5 → 1.0)
    bodyContrastSpan: 1.4,
    bodyRangeDb: 24,                   // loudness: max(e_abs) 0 → −24 dB, 1 → 0 dB (R2: absolute)
    bodyAmp: 0.32,                     // W2 tuning: level at mix gain 1 and e = 1 (v0.10: 0.5 → 0.32, −4 dB, to
                                       //   offset the 2.5× longer ring times: a noise-driven resonator gains ≈ +4 dB)
    bodyExAmp: 0.02,                   // excitation: pink noise …
    bodyDust: 2.5,                     //   … plus sparse Dust (per s) …
    bodyDustAmp: 0.6,                  //   … at this level relative to the noise

    // ---- Swarm (DESIGN §4.3) ----------------------------------------------------------------
    swarmAmp: 0.6,                     // W2 tuning: texture level at mix gain 1, mmax_abs = 1
    swarmMmaxDb: 12,                   // texture loudness: mmax_abs 0 → −12 dB, 1 → 0 dB (R2: absolute)
    swarmPulseRef: 20,                 // above 20 Hz the train keeps the power it has at 20 Hz (the synth divides
                                       //   by sqrt(rate·d / (20·dur)), d = the pulsaret length actually played);
                                       //   below it every tick is the same level (sparse = quieter overall)
    swarmNoiseLo: 700,                 // pulse train → noise band crossfade, Hz (DESIGN: "above ~800 Hz")
    swarmNoiseHi: 1000,
    swarmNoiseCap: 8000,               // the noise band's centre follows the rate, capped here (DESIGN)
    swarmNoiseRq: 0.6,
    swarmNoiseCal: 1.25,               // W2 tuning: noise band level matched to the train (+2 dB, measured on the
                                       //   0.5 → 4000 Hz sweep: train −38.5, band −40.4 dBFS RMS at cal 1)
    swarmFfShallow: 2400,              // depth → register: the pulsaret's carrier, shallow (depth_abs 0) …
    swarmFfOct: 2,                     //   … falling 2 octaves to 600 Hz at depth_abs 1 (deeper = lower)
    swarmWood: 2.76,                   // the inharmonic partial (re_wilding's woodblock), × the carrier
    swarmDurMin: 0.006,                // pulsaret length 6–30 ms: b-value darkness → longer (DESIGN)
    swarmDurMax: 0.030,
    depthKmRange: [1.0, 8.0],          // FALLBACK only, for an event without v0.8's depth_abs: depth_km on 1–8 km

    // ---- events: grains, ticks, bells -------------------------------------------------------
    eventMRef: 2.0,                    // magnitude at which an event's grain/tick is at its nominal level
    grainAmp: 0.25,                    // W2 tuning
    grainDbPerM: 6,                    // W2 tuning: +6 dB per magnitude unit (the true energy step is 15 dB)
    grainDurMin: 0.006,                // grain length 6 ms at M ≤ 1 …
    grainDurMax: 0.030,                //   … to 30 ms at M ≥ 4 (a 2-s quake at 250× is an 8-ms grain)
    tickAmp: 0.12,                     // W2 tuning
    tickDbPerM: 4,
    tickFf: 3600,                      // a high, dry wood tick (2.76 partial), 4 ms: the catalogue's claim
    tickDur: 0.004,
    bellMinM: 2.0,                     // bells only for M ≥ 2 (DESIGN §4.3)
    bellAmp: 0.1,                      // W2 tuning: M2 bell level; +5 dB per magnitude, capped at 0.5 (≈ M4.9)
    bellDbPerM: 5,
    bellAmpMax: 0.5,
    bellDecay0: 4.0,                   // v0.10 ring time: 4 s at M2, +2.5 s per magnitude (M4.9 ≈ 11 s): bells ring
    bellDecayPerM: 2.5,                //   into each other through the shared space (was 1.5 + 1.25/M)
    dedupS: 3.0,                       // an id_hash seen again within 3 s (lookahead overlap) is not re-fired

    // ---- Ground (DESIGN §4.4) ---------------------------------------------------------------
    groundAmp: 2.5,                    // ring samples = counts / the record's peak |x| for the channel (CONTRACT
                                       //   v0.7 §5.1 d; MELH peaks 6.87–7.38 M counts, so the E/N balance moves
                                       //   ≤ 0.6 dB). This is the gain at x = 1. W2 tuning: puts the MELH swarm (Z)
                                       //   near −25 LUFS and the eruption 3-C near −15, against ≈ −21 for the
                                       //   synthesis at the sequence level (R2: absolute, one gain for every chan)
    groundLimit: 0.8,                  // the soft limiter: y = 0.8·tanh(x / 0.8) (≈ linear below −10 dBFS)
    groundHpHz: 20,                    // the gentle highpass, audio Hz
    groundTiltOct: 1.0,                // tilt detunes that corner by up to ±1 octave, slowly (lag 4 s)
    groundPan: [0, -0.5, 0.5],         // Z centre, N left, E right (East = right when facing north): with the
                                       //   tremor locked at ~73° the E component dominates, so it leans right
    groundSpeedMin: 10,
    groundSpeedMax: 5000,
    groundStartBlocks: 2,              // the reader starts once the first 2 blocks are in (1.3 s ahead at 250×)
    groundPreroll: 0.3,                // … or this long after the play, whichever is first (/svk_filled is advisory)
    groundSeekTol: 0.25,               // a /svk_ground play for the chan already playing, at the current playhead
                                       //   ± max(1 s, 0.25 s × ground_speed) of data, is a speed change, not a seek

    // ---- Array (v0.10, DESIGN §4.7): 9 sensors, SKSH · SENG · THOB × N · E · U ------------------
    arrayBase: [41.2, 49.0, 36.7],     // W2: per station, Hz (SKSH E1, SENG G1, THOB D1: THOB, nearest, lowest)
    arrayMult: [2, 3, 1],              // W2: × per component N, E, U → U 37–49 Hz, N 73–98, E 110–147 (≈ 25–150)
    arrayAz: [-55, 55, 0],             // W2 PROVISIONAL stage azimuths, deg (SKSH left/west, SENG right, THOB centre
                                       //   = nearest the source) until station coordinates arrive
    arrayAmp: 0.5,                     // W2 tuning: level at mix gain 1
    arrayExpo: 0.7,                    // excitation = |v|^0.7 (the slow inflation stays audible next to a fall)
    arrayDriftSemi: 1.0,               // U drifts the station's pitch ± 1 semitone (up = higher) …
    arrayBright: 0.5,                  //   … and its brightness (0.5 ± 0.5·v_u)
    arraySideE: 0.5,                   // E motion moves the station sideways (pan ± 0.5) …
    arrayNearN: 0.5,                   //   … N motion farther (+) / nearer (−): the send × (1 ± 0.5)
    arraySend: [0.45, 0.45, 0.3],      // W2: per station; THOB (nearest, 2.2× deflation) drier = nearer
    arrayRing: 4.5,                    // W2: the resonators' ring scale, s

    // ---- Rumble (v0.10, DESIGN §4.7): the catalogue's energy release ----------------------------
    rumbleFloorDb: -40,                // logE_abs 0 (a measured quiet, v0.10.2) → −40 dB: a near-silent floor …
    rumbleAmp: 0.25,                   //   … logE_abs 1 → 0 dB × this (R2: absolute, dB-linear in logE). W2 tuning:
                                       //   0.6 put the Nov 2023 roar on the −1 dBFS limiter, and the 14 Jan 2024 day
                                       //   (logE 0.96) held the zoom sweep at −12 LUFS; 0.25 keeps the roar the loudest
                                       //   layer without riding the limiter
    rumbleDens: [0.3, 14],             // n_abs 0 → 1 → bursts per s (squared: a swarm roars, a quiet day breathes)

    // ---- Ground placement (v0.10, \svkGroundRot) -----------------------------------------------
    groundRotLag: 0.3,                 // the polarization azimuth's smoothing, s (on the doubled angle)
    groundTiltAmp: 0.05,               // tilt → a slow sub-rumble (felt more than heard)

    // ---- perceptual legend (DESIGN §4.6) ----------------------------------------------------
    legendBellEvery: 2.5,              // a held bell rings again every 2.5 s
    legendTension: [0.5, 0.5, 1, 0, 0.5, 0, 0.5, nil],   // the defaults a hold starts from where the live row is a gap
    legendBody: [0.6, 0.6, 0.6, 0.6],  //   (a soloed layer must DEMO audibly, hugur's floor rule)
    legendSwarm: [40, 0.5, 0.5, 0.5],
    legendDeform: [131, 0.5, 1, 0.5, 0.33, 0.25, 0.2, 0.17, 0],   // T-C: a 131-d sawtooth-like cycle at half inflow
    legendRumble: [0.5, 0.5, 0],

    // ---- master ---------------------------------------------------------------------------------
    masterDefault: 0.8,
    limit: 0.89                        // the core's limiter ceiling (−1 dBFS)
);

// the Body's mode-group centres, derived (R1): geometric band centre × TRANSPOSE → 79.1 / 559.0 / 2165.1 / 6495.2 Hz
~svkBodyCentres = ~svkK[\bands].collect { |b| (b[0] * b[1]).sqrt * ~svkK[\TRANSPOSE] };
// per-mode arrays for \svkBody: index = p * 4 + b (partial p of group b), three DynKlanks of four (L, C, R)
~svkBodyFreqs = ~svkK[\bodySpread].collect { |r| ~svkBodyCentres * r }.flatten;
~svkBodyRings = ~svkK[\bodySpread].collect { ~svkK[\bodyRing] }.flatten;

// --------------------------------------------------------------- level mix --
// w = [w0..w4] from /svk_zoom (computed by the page, CONTRACT §3; SC never recomputes them) → component gains
~svkMixGains = { |w|
    var g = ();
    ~svkK[\mix].keysValuesDo { |k, row| g[k] = (row * w).sum.clip(0, 1) };
    g
};
// v0.12 /svk_mix args → the five faders (nil/NaN/missing → 1, clipped 0–1)
~svkCookFaders = { |args|
    var f = ();
    ~svkK[\faderOrder].do { |k, i| var x = (args ? [])[i];
        f[k] = if (x.isNumber and: { x.isNaN.not }) { x.asFloat.clip(0, 1) } { 1 } };
    f
};
// the zoom-level gains × the faders (faders nil = all 1)
~svkFaderGains = { |g, f|
    var out = g.copy;
    f !? { ~svkK[\faderMap].keysValuesDo { |fk, keys| keys.do { |k| out[k] !? { out[k] = out[k] * (f[fk] ? 1) } } } };
    out
};
// the legend's solo: every component 0 except the held layer's
~svkSoloGains = { |layer, qty|
    var g = ();
    ~svkK[\mix].keysDo { |k| g[k] = 0 };
    switch (layer)
    { 0 } { g[\tension] = 1 }
    { 1 } { g[\body] = 1 }
    { 2 } { if (qty == 4) { g[\swarmBell] = 1 } { g[\swarmTexture] = 1 } }
    { 3 } { g[\ground] = 1 }
    { 4 } { g[\array] = 1 }
    { 5 } { g[\rumble] = 1 }
    { 6 } { g[\body2] = 1 };
    g
};

// ----------------------------------------------------------------- Tension --
// row = [recharge_frac, u_rate_abs, phase, gap, wait_rel, above_last_start_mm, u_abs, ref_abs] (CONTRACT v0.8 §5.0;
// the last four are absent from older senders, and any null arrives as nil). The T-A reference tone sits at ref_abs
// (v0.8, the page's own scale); without it, at u_abs − above_last_start_mm / tensionARangeMm (the old stand-in). st = (rf:, phase:, wait:) of the previous live
// row, or nil (a re-apply or a legend hold: never a fall). mode = \A | \B (~svkK[\tensionEncoding] by default).
// gap 1 = no data → silent (R3); gap 2 = interpolated → veiled: the same pitch, breath instead of tone.
// A FALL is the onset of a magmatic deflation: phase turns 2, or wait_rel resets (days_since_fall restarts at every
// magmatic fall and never at a spike, so a cursor that steps over the deflation day still hears its fall, and a
// spike never does). A v0.2 sender (no wait_rel) falls back to a recharge_frac drop > fallDrop.
~svkCookTension = { |row, st, mode|
    var kc = ~svkK;
    var rf = row[0], u = row[1], phase = (row[2] ? 1).asInteger, gap = (row[3] ? 1).asInteger;
    var wait = row[4], above = row[5], uAbs = row[6], refAbs = row[7];
    var m = mode ? kc[\tensionEncoding];
    var pitchQ = if (m == \A) { uAbs } { rf };
    var silent = (gap == 1) or: { pitchQ.isNil and: { m != \C } };
    var prev = st ? ();
    var fall = silent.not and: { st.notNil } and: {
        ((phase == 2) and: { prev[\phase] != 2 })
        or: { wait.notNil and: { prev[\wait].notNil } and: { (prev[\wait] - wait) > 0.02 } and: { wait < 0.1 } }
        or: { wait.isNil and: { prev[\rf].notNil } and: { rf.notNil } and: { (prev[\rf] - rf) > kc[\fallDrop] } } };
    var span = kc[\tensionAHi] / kc[\tensionALo];
    var freqA = { |q| kc[\tensionALo] * (span ** q) };
    var refQ = refAbs ?? { if (above.notNil and: { uAbs.notNil }) { uAbs - (above / kc[\tensionARangeMm]) } { nil } };
    var hasRef = (m == \A) and: { refQ.notNil };
    (
        freq:   if (m == \A) { freqA.((uAbs ? 0).max(-0.5)) } { kc[\tensionBaseHz] * (2 ** (rf ? 0).max(0)) },
        refFreq: if (hasRef) { freqA.(refQ) } { 220 },
        refAmp: if (hasRef and: { silent.not }) { kc[\tensionAmp] * kc[\tensionRefRel] } { 0 },
        beatHz: if ((m == \A) and: { wait.notNil }) { kc[\waitBeatHz] * wait.max(0) } { 0 },
        rough:  if ((m == \A) and: { wait.notNil }) { (kc[\waitRough] * (wait - 1)).clip(0, kc[\waitRoughMax]) } { 0 },
        press:  if (gap == 2) { kc[\pressNeutral] } { (u ? kc[\pressNeutral]).clip(0, 1) },
        veil:   if (gap == 2) { 1 } { 0 },
        amp:    if (silent or: { m == \C }) { 0 } { kc[\tensionAmp] * (kc[\tensionLevel][m] ? 1) },
        scrape: if (fall) { 1 } { 0 },
        state:  if (silent) { st } { (rf: rf, phase: phase, wait: wait) }
    )
};

// ------------------------------------------------------- Tension T-C (v0.9) --
// row = [cycle_period_d, inflow_rel, h1 … h6, gap] (/svk_deform). Only T-C reads it (mode \C); in A/B it is silent.
// Pitch: the cycle's frequency moved up DEFORM_OCTAVES. Timbre: partials n·f0 at the cycle's own Fourier magnitudes
// h1…h6 as measured, equal-power normalised (the shape sets the colour, not the level). Envelope: the inflow in dB
// (the ringdown), floored. gap 1 or a null period → silent (R3); gap 2 → veiled. Eruptions re-strike it (the parser, from the
// Tension fall: phase-2 onset, hidden eruptions included).
// Caveat (legend): this pitch is the eruption cycle's frequency moved up 30 octaves; a property of the sequence,
// not a sound the ground makes.
~svkDeformF0 = { |periodD| (2 ** ~svkK[\DEFORM_OCTAVES]) / (periodD.max(0.5) * 86400) };
~svkCookDeform = { |row, mode|
    var kc = ~svkK;
    var period = row[0], inflow = row[1], gap = (row[8] ? 1).asInteger;
    var hNull = (row[2..7] ? []).every(_.isNil);          // W1: cyc_h* null where the cycle is mostly straight-line GNSS
    var h = (row[2..7] ? []).collect { |x| (x ? 0).max(0) }.extend(6, 0);
    var f0 = ~svkDeformF0.(period ? 131);
    var hl = h;                                            // the measured partials, untilted (carrier lift removed)
    var norm = hl.squared.sum.sqrt;
    var m = mode ? kc[\tensionEncoding];
    var silent = (m != \C) or: { gap == 1 } or: { period.isNil };
    var lvlDb = if (inflow.notNil and: { inflow > 0 }) { inflow.min(1).ampdb } { kc[\deformFloorDb] };
    (
        f0: f0,
        h: if (norm > 1e-6) { hl / norm } { [1, 0, 0, 0, 0, 0] },
        strikeDecay: kc[\deformTauD] * kc[\deformTauSecPerDay],
        amp: if (silent) { 0 } { kc[\deformAmp] * (kc[\tensionLevel][\C] ? 1) * lvlDb.max(kc[\deformFloorDb]).dbamp },
        // W2 reading of R3 (for approval): a known period with a NULL inflow (the 60-day fit lacks usable days, e.g.
        // around the hidden Jan/Feb 2024 eruptions) is VEILED at the floor — the pitch is known, its level is not —
        // rather than silent. The strict alternative (silent) is one line: add `or: { inflow.isNil }` to `silent`.
        veil: if ((gap == 2) or: { inflow.isNil } or: { hNull }) { 1 } { 0 }   // a null shape is a gap too (W1)
    )
};

// -------------------------------------------------------------------- Body --
// e = 4 abs energies, c = 4 room percentiles (micro, tremor, mid, vt), gap 1 = no waveform → silent.
// Balance: g_b = e_b × k(c_b), equal-excitation normalised (Σ g² = 1), so navigating changes WHAT the body rings
// with, not how loud (re_wilding). Loudness: from the loudest band's absolute energy (R2).
~svkCookBody = { |e, c, gap|
    var kc = ~svkK;
    var g = e.collect { |ei, i| ei.clip(0, 1) * (kc[\bodyContrastLo] + (kc[\bodyContrastSpan] * c[i].clip(0, 1))) };
    var norm = g.squared.sum.sqrt;
    var shape = if (norm > 1e-6) { g / norm } { 0 ! 4 };
    var level = e.collect(_.clip(0, 1)).maxItem;
    var amp = if ((gap.asInteger != 0) or: { norm <= 1e-6 }) { 0 } {
        (kc[\bodyRangeDb] * (level - 1)).dbamp * kc[\bodyAmp] };
    (
        amps: kc[\bodySpreadAmp].collect { |pa| shape * kc[\bodyCal] * pa }.flatten,
        amp: amp,
        shape: shape
    )
};

// ------------------------------------------------------------------- Swarm --
// The texture: a pulse train at the TRUE rate × speed (no remap). Depth → register (the pulsaret's carrier),
// b-value → darkness (low b = relatively more large quakes = darker and longer pulsarets), mmax → loudness.
~svkSwarmFf = { |depthAbs| ~svkK[\swarmFfShallow] * (2 ** (depthAbs.clip(0, 1) * ~svkK[\swarmFfOct]).neg) };
~svkCookSwarm = { |row|
    var kc = ~svkK;
    var rate = (row[0] ? 0).max(0), b = row[1] ? 0.5, depth = row[2] ? 0.5, mmax = row[3] ? 0.5, gap = row[4].asInteger;
    var dark = 1 - b.clip(0, 1);
    (
        rate: rate.max(0.01),
        ff: ~svkSwarmFf.(depth),
        dark: dark,
        dur: kc[\swarmDurMin] + ((kc[\swarmDurMax] - kc[\swarmDurMin]) * dark),
        amp: if ((gap != 0) or: { rate <= 0 }) { 0 } { kc[\swarmAmp] * (kc[\swarmMmaxDb] * (mmax.clip(0, 1) - 1)).dbamp }
    )
};

// Brune corner frequency, CONTRACT §2.4 (3 MPa, ML as Mw). The page sends fc_hz with every event (W1's column);
// this mirror exists ONLY for the legend's "bell at M2/M3/M4" holds, which carry a magnitude and no fc.
~svkBruneFc = { |mag|
    var m0 = 10 ** ((1.5 * mag) + 9.1);
    0.37 * 3500 * (((16 * 3e6) / (7 * m0)) ** (1/3))     // sclang has no operator precedence: keep the brackets
};

// one catalogue event → the voices it fires, given the current component gains. Returns [[defName, args], …].
// At hours/minutes a tick; at day a grain (and a bell when M ≥ 2); at cycle a bell (M ≥ 2). Level weights in
// between crossfade the renderings (DESIGN §4.5). The bell's pitch is fc × TRANSPOSE (R1).
~svkCookEvent = { |mag, depthKm, fcHz, pan, gains, depthAbsIn|
    var kc = ~svkK, out = List[];
    var dr = kc[\depthKmRange];
    // v0.8: depth_abs from the page (the manifest's range); else the old stand-in range on depth_km
    var depthAbs = (depthAbsIn ?? { ((depthKm ? 4) - dr[0]) / (dr[1] - dr[0]) }).clip(0, 1);
    var dm = mag - kc[\eventMRef];
    var p = pan.clip(-1, 1);
    if (gains[\swarmTick] > 0.001) {
        out.add([\svkTick, [\amp, kc[\tickAmp] * (kc[\tickDbPerM] * dm).dbamp.min(2) * gains[\swarmTick],
            \pan, p, \ff, kc[\tickFf], \dur, kc[\tickDur], \send, kc[\roomSend][\tick]]]);
    };
    if (gains[\swarmGrain] > 0.001) {
        out.add([\svkGrain, [\amp, kc[\grainAmp] * (kc[\grainDbPerM] * dm).dbamp.min(4) * gains[\swarmGrain],
            \pan, p, \ff, ~svkSwarmFf.(depthAbs),
            \dur, mag.linlin(1, 4, kc[\grainDurMin], kc[\grainDurMax]), \wood, kc[\swarmWood],
            \send, kc[\roomSend][\grain]]]);
    };
    if ((gains[\swarmBell] > 0.001) and: { mag >= kc[\bellMinM] } and: { fcHz.notNil and: { fcHz > 0 } }) {
        out.add([\svkBell, [\freq, fcHz * kc[\TRANSPOSE],
            \amp, (kc[\bellAmp] * (kc[\bellDbPerM] * (mag - kc[\bellMinM])).dbamp).min(kc[\bellAmpMax]) * gains[\swarmBell],
            \decay, kc[\bellDecay0] + (kc[\bellDecayPerM] * (mag - kc[\bellMinM])), \pan, p,
            \send, kc[\roomSend][\bell]]]);
    };
    out.asArray
};

// ------------------------------------------------------------------ Ground --
// ground_speed → the reader's rate in SOURCE frames per second (the synth divides by SampleRate.ir):
// 250× reads 25,000 MELH samples per second, so 0.1–45 Hz sound at 25 Hz–11.25 kHz.
~svkCookGround = { |speed, chan|
    var kc = ~svkK;
    (
        rate: kc[\SR_SEIS] * speed.clip(kc[\groundSpeedMin], kc[\groundSpeedMax]),
        pan: kc[\groundPan].clipAt(chan),
        amp: kc[\groundAmp]
    )
};
// tilt (−1…1, the page's normalised LM* tilt; no message carries it yet, see the notes) → highpass detune, octaves
~svkCookTilt = { |tilt| (tilt ? 0).clip(-1, 1) * ~svkK[\groundTiltOct] };
// the playhead: (day, sec) at the start of the ring + frames read → [day, sec] (CONTRACT §1: OSC has no float64)
~svkPlayhead = { |day0, sec0, frames|
    var t = sec0 + (frames / ~svkK[\SR_SEIS]);
    var dd = (t / 86400).floor;
    [day0 + dd.asInteger, t - (dd * 86400)]
};

// -------------------------------------------------------------- Array (v0.10) --
// row = [sksh_n, sksh_e, sksh_u, seng_n, seng_e, seng_u, thob_n, thob_e, thob_u, gap_sksh, gap_seng, gap_thob]
// (/svk_array: velocities signed −1…1 on their own asymmetric p01/p99, nullable; gaps 0/1/2). Per voice: excitation
// = |v|^0.7 (null → 0), pitch = base × component multiple, drifted by the station's U, brightness from U. Per station:
// pan = stage azimuth + E motion; send = base × (1 + 0.5·N) (north = farther); gap 1 → silent, gap 2 → veiled.
// An eruption (all U strongly negative) is heard as all nine falling: louder, lower, darker together.
~svkCookArray = { |row|
    var kc = ~svkK, ex = [], fq = [], br = [], pan = [], send = [], veil = [];
    3.do { |s|
        var vn = row[s * 3], ve = row[(s * 3) + 1], vu = row[(s * 3) + 2];
        var gap = (row[9 + s] ? 1).asInteger;
        var on = gap != 1;
        var drift = 2 ** (((vu ? 0).clip(-1, 1) * kc[\arrayDriftSemi]) / 12);
        [vn, ve, vu].do { |v, c|
            ex = ex.add(if (on and: { v.notNil }) { v.abs.clip(0, 1) ** kc[\arrayExpo] } { 0 });
            fq = fq.add(kc[\arrayBase][s] * kc[\arrayMult][c] * drift);
            br = br.add((kc[\arrayBright] + (0.5 * (vu ? 0).clip(-1, 1))).clip(0, 1));
        };
        pan = pan.add((kc[\arrayAz][s].degrad.sin + (kc[\arraySideE] * (ve ? 0).clip(-1, 1))).clip(-1, 1));
        send = send.add((kc[\arraySend][s] * (1 + (kc[\arrayNearN] * (vn ? 0).clip(-1, 1)))).clip(0, 1));
        veil = veil.add(if (gap == 2) { 1 } { 0 });
    };
    (ex: ex, fq: fq, br: br, pan: pan, send: send, veil: veil, amp: kc[\arrayAmp])
};

// ------------------------------------------------------------- Rumble (v0.10) --
// logE_abs, n_abs (0–1, nullable), gap. A day with no events arrives as 0/0/gap 0 (v0.10.2): a measured quiet → the
// floor. gap 1 = no catalogue coverage → silent. Level dB-linear in logE (R2: absolute); burst density from n_abs.
~svkCookRumble = { |logE, nAbs, gap|
    var kc = ~svkK;
    var e = (logE ? 0).clip(0, 1), n = (nAbs ? 0).clip(0, 1);
    (
        amp: if ((gap ? 1).asInteger == 1) { 0 } { kc[\rumbleAmp] * (kc[\rumbleFloorDb] * (1 - e)).dbamp },
        dens: kc[\rumbleDens][0] + ((kc[\rumbleDens][1] - kc[\rumbleDens][0]) * n.squared)
    )
};

// ------------------------------------------------------------ polarization (v0.10) --
// /svk_pol az_deg (0–180, axial), R (0–1, f1m), rect (0–1), nullable. A null azimuth keeps the last one; a null R is
// treated as 0 (no stable direction: the radial component sits in the centre).
~svkCookPol = { |az, r, rect, last|
    (az: az ? (last ? 0), polR: (r ? 0).clip(0, 1), rect: (rect ? 0).clip(0, 1))
};

// ---------------------------------------------------------- Body v2 (v0.11) --
// /svk_identity kind, id, n, comb_hz, n × [freq_hz, amp, ring_s, harm, detune], n × rest_gain [, room_gain] → the body.
// freq_hz is UNDETUNED (CONTRACT v0.11.4); SC applies the station detune: freq × (1 + detune), −0.04 / 0 / +0.04.
// ring × 0.85^(harm−1) (overtones a little shorter). The comb is FOLDED by whole octaves into 35–140 Hz (v0.11.3:
// re_wilding's comb register; the pitch class stays the data's; the modes stay at their true frequencies).
// lnorm = each mode's log-frequency position in the room (0 lowest … 1 highest, on the undetuned frequency): the
// seesaw's family axis, for the legend's θ hold.
~svkFoldComb = { |hz|
    var f = (hz ? 85).max(1e-3);
    while { f < ~svkK[\body2CombLo] } { f = f * 2 };
    while { f > ~svkK[\body2CombHi] } { f = f / 2 };
    f
};
~svkCookIdentity = { |kind, id, comb, modes, rest, roomGain, bowNeutralDb|
    var kc = ~svkK, n = modes.size;
    var pad = { |a, v| a.extend(36, v) };
    var lf = modes.collect { |m| m[0].max(1e-6).log };     // the seesaw's axis, on the undetuned frequency
    var lo = lf.minItem, hi = lf.maxItem;
    var combF = ~svkFoldComb.(comb);
    (
        kind: kind, id: id, n: n, comb: combF, combRaw: comb,
        roomGain: (roomGain ? 1).max(0) * kc[\body2KindTrimDb].clipAt(kind).dbamp,   // W1's room_gain × the kind trim
        bowNeutralDb: (bowNeutralDb ? kc[\body2BowNeutralDb]).clip(-30, 0),   // v0.11.7: the room's median measured bow
        freqs: pad.(modes.collect { |m| m[0] * (1 + (m[4] ? 0)) }, 100),
        amps: pad.(modes.collect { |m| (m[1] ? 0).max(0) }, 0),
        rings: pad.(modes.collect { |m| (m[2] ? 1) * (kc[\body2Overtone] ** ((m[3] ? 1) - 1).max(0)) }, 1),
        harm: pad.(modes.collect { |m| m[3] ? 1 }, 1),
        lnorm: pad.(lf.collect { |x| if (hi > lo) { (x - lo) / (hi - lo) } { 0 } }, 0),
        rest: pad.((rest ? []).collect { |g| g ? 1 }, 1).extend(36, 1),
        combDelay: 1 / combF,
        pans: if (kind == 2) { kc[\body2Pans][\regime] } { kc[\body2Pans][\deform] }
    )
};
// /svk_body2 theta, pressure, pin, gap, 36 × g (nullable → silent mode) → the body's state
~svkCookBody2 = { |theta, pressure, pin, gap, g|
    var kc = ~svkK;
    (
        gains: (g ? []).collect { |x| (x ? 0).max(0) }.extend(36, 0),
        pin: (pin ? 1).max(0),
        combDecay: kc[\body2CombDecay][0] + (kc[\body2CombDecay][1] * (pressure ? 0.5).clip(0, 1)),
        veil: if ((gap ? 0).asInteger == 2) { kc[\body2Veil] } { 0 },
        amp: if ((gap ? 0).asInteger == 1) { 0 } { kc[\body2Amp] }
    )
};
// /svk_bow bow_db (inflow in dB, floor −30 for MEASURED low inflow; regimes 0; nullable), dust_hz, gap (v0.11.8: W1's
// bow_gap, the inflow's own status — not the GNSS's) → the bow. gap 1 = no data → silent. gap 2 / a null bow_db
// (unknown inflow) plays the bow VEILED at the room's bow_neutral_db (Miguel: "keep it veiled where inflow is unknown",
// as T-C) — never at the floor, which means measured-low. Only the bow is veiled (the synth's bowVeil); the body's own
// veil is /svk_body2's gap (the GNSS).
~svkCookBow = { |bowDb, dustHz, gap, ident|
    var kc = ~svkK, g = (gap ? 0).asInteger;
    var neutral = (ident !? { |id| id[\bowNeutralDb] }) ? kc[\body2BowNeutralDb];
    (
        exAmp: case
            { g == 1 } { 0 }
            { bowDb.isNil } { kc[\body2ExAmp] * neutral.dbamp }
            { kc[\body2ExAmp] * bowDb.clip(-30, 0).dbamp },
        veil: if ((g != 1) and: { bowDb.isNil or: { g == 2 } }) { 1 } { 0 },
        dust: (dustHz ? 0.5).clip(0.5, 5)
    )
};
// the θ seesaw, W1's = re_wilding's (pipeline/body.py seesaw): tilt_m(θ) = 1 + s_m (1 − 2 l_m) cos(π θ),
// s_m = 0.5 + 0.5 l_m (l = lnorm). Low families lead at θ 0, high ones at θ 1. W1 bakes it into g (with normalisations
// and the k = 2 expansion); the legend's θ hold re-tilts the point's own g by (tilt(θ_hold) / tilt(θ_point))^2.
~svkSeesaw = { |theta, lnorm|
    lnorm.collect { |l| var s = 0.5 + (0.5 * l); 1 + (s * (1 - (2 * l)) * cos(pi * theta.clip(0, 1))) }
};
// /svk_strike size (0–1), kind (0 magmatic, 1 hidden) → the strike voice, at the room's lowest mode
~svkCookStrike = { |size, kind, ident|
    var kc = ~svkK, f = (ident !? { ident[\freqs].keep(ident[\n]).minItem } ? 40);
    var s = (size ? 0.5).clip(0, 1);
    while { f < kc[\strikeMinHz] } { f = f * 2 };
    [\svkStrike, [\freq, f, \amp, kc[\strikeAmp] * (9 * (s - 1)).dbamp, \size, s,
        \decay, kc[\strikeDecay][0] + ((kc[\strikeDecay][1] - kc[\strikeDecay][0]) * s),
        \veil, if ((kind ? 0).asInteger == 1) { 1 } { 0 }, \send, kc[\roomSend][\strike]]]
};

// ------------------------------------------------------------------ legend --
// /dark_legend layer qty value hold. A hold starts from the LIVE row on your own point, pushes ONE quantity to
// `value`, and solos that layer (~svkSoloGains). Returns the rows to cook with; the parser cooks them with the
// same functions as live navigation. Quantities (value = the raw quantity, as the legend text states it):
//   layer 0 Tension  qty 0 recharge_frac (T-B: 0 → 1 → 1.84) · 1 u_rate_abs (0–1) · 2 veil (value ignored)
//                    · 3 wait_rel (T-A: 0 → 1 → 3.32) · 4 above_last_start_mm (T-A: −41 … +206) · 5 u_abs (T-A: 0–1)
//                    · 6 cycle_period_d (T-C: 26 → 131 → 435) · 7 inflow_rel (T-C: 1 → 0.11) · 8 re-strike (T-C)
//                    (a hold of qty 6–8 sounds T-C whatever the switch says, so the row always demonstrates)
//                    (each encoding hears only the quantities it reads: the page offers the active one's rows)
//   layer 1 Body     qty 0–3 one band alone (micro, tremor, mid, vt) at e_abs = value
//   layer 2 Swarm    qty 0 rate_play_hz · 1 b_abs · 2 depth_abs · 3 mmax_abs · 4 a bell at magnitude = value
//   layer 3 Ground   qty 0 ground_speed (50 / 250 / 1000)
//   layer 4 Array    qty 0–8 one sensor voice (sksh_n … thob_u) at a signed velocity −1…1, the others resting (v0.10.3)
//   layer 5 Rumble   qty 0 logE_abs · 1 n_abs (v0.10.3)
//   layer 6 Body v2  qty 0 theta (0–1) · 1 pressure (0–1) · 2 the bow (bow_db, −30…0) · 10 + m mode m alone (v0.11; the
//                    parser applies these to the current room, with ~svkSeesaw / ~svkCookBody2 / ~svkCookBow)
~svkLegendRows = { |layer, qty, value, live|
    var kc = ~svkK, t, b, sw, d, ar, ru;
    t = if ((live[\tension][3] ? 1) == 1) { kc[\legendTension].copy } { live[\tension].copy };
    t = t.extend(8, nil);
    kc[\legendTension].do { |v, i| if (t[i].isNil) { t[i] = v } };   // an older row lacks the T-A fields
    b = if (live[\body][\gap] != 0) { (e: kc[\legendBody].copy, c: 0.5 ! 4, gap: 0) } {
        (e: live[\body][\e].copy, c: live[\body][\c].copy, gap: 0) };
    sw = if (live[\swarm][4] != 0) { kc[\legendSwarm] ++ [0] } { live[\swarm].copy };
    d = if ((live[\deform].isNil) or: { (live[\deform][8] ? 1) == 1 } or: { live[\deform][0].isNil }) {
        kc[\legendDeform].copy } { live[\deform].copy };
    switch (layer)
    { 0 } { switch (qty)
        { 0 } { t[0] = value.max(0); t[3] = 0 }
        { 1 } { t[1] = value.clip(0, 1); t[3] = 0 }
        { 2 } { t[3] = 2 }
        { 3 } { t[4] = value.max(0); t[3] = 0 }
        { 4 } {   // the reference follows the held distance, on the live point's own mm → u_abs scale
            t[7] = if (t[7].notNil and: { t[5].notNil } and: { t[5].abs > 1 } and: { (t[6] - t[7]).abs > 1e-6 }) {
                t[6] - (value * ((t[6] - t[7]) / t[5])) } { nil };
            t[5] = value; t[3] = 0 }
        { 5 } { t[6] = value; t[3] = 0 }
        { 6 } { d[0] = value.max(0.5); d[8] = 0 }          // T-C: the cycle period, days (26 → 131 → 435)
        { 7 } { d[1] = value.clip(0, 1); d[8] = 0 }        // T-C: inflow_rel (1.0 → 0.5 → 0.11)
        { 8 } { d[8] = 0 } }                               // T-C: a re-strike (the parser fires it)
    { 1 } { b[\e] = 0 ! 4; b[\e][qty.clip(0, 3)] = value.clip(0, 1); b[\c] = 0.5 ! 4 }
    { 2 } { if (qty < 4) { sw[qty] = value; sw[4] = 0 } };
    // v0.10.3: layer 4 array — that one sensor voice at `value` (signed −1…1), the others resting; layer 5 rumble
    ar = (0 ! 9) ++ [0, 0, 0];
    if (layer == 4) { ar[qty.clip(0, 8)] = value.clip(-1, 1) };
    ru = if ((live[\rumble].isNil) or: { (live[\rumble][2] ? 1) == 1 }) { kc[\legendRumble].copy } { live[\rumble].copy };
    if (layer == 5) { ru[qty.clip(0, 1)] = value.clip(0, 1); ru[2] = 0 };
    (tension: t, body: b, swarm: sw, deform: d, array: if (layer == 4) { ar } { live[\array] }, rumble: ru)
};
);

// ------------------------------------------------------------- replies (A6) --
// Everything SC says goes through ~svkSend, to the relay's OSC-in port: viz/.viz_ports.json "osc" (re-read every
// 3 s), else OSC_PORT_OVERRIDE, else 9061 (CONTRACT §5). A harness sets ~svkReplyTo before loading this file.
~svkVizPortsFile = vizPorts;
~svkRelayAt = -100;
~svkRelay = {
    var txt, m, port;
    if ((Main.elapsedTime - ~svkRelayAt) > 3) {
        ~svkRelayAt = Main.elapsedTime;
        port = ("OSC_PORT_OVERRIDE".getenv ? "9061").asInteger;
        if (~svkVizPortsFile.notNil and: { File.exists(~svkVizPortsFile) }) {
            txt = File.readAllString(~svkVizPortsFile);
            m = txt.findRegexp("\"osc\"\\s*:\\s*([0-9]+)");
            if (m.size >= 2) { port = m[1][1].asInteger };
        };
        ~svkRelayAddr = NetAddr("127.0.0.1", port);
    };
    ~svkRelayAddr
};
~svkSend = { |...args|
    (~svkReplyTo ?? { ~svkRelay.value }).sendMsg(*args);
};

// OSC has no null: a NaN (or a missing trailing arg from an older sender) is read as nil (R3: never a sound)
~svkNum = { |x| if (x.isNil or: { x.isNumber.not } or: { x.isNaN }) { nil } { x.asFloat } };

{
    var kc = ~svkK;
    var nb = (kc[\RING] / kc[\BLOCK]).asInteger;

    // --------------------------------------------- persistent server state --
    ~masterBus = ~masterBus ?? { var b = Bus.control(s, 1); b.set(kc[\masterDefault]); b };
    ~svkMixBus = ~svkMixBus ?? { Bus.audio(s, 2) };
    ~svkCoreBus = ~svkCoreBus ?? { Bus.audio(s, 2) };
    ~svkSpaceBus = ~svkSpaceBus ?? { Bus.audio(s, 2) };      // the voices' sends: v0.11 → INTO THE BODY'S ROOM COMB
    ~svkGroundBus = ~svkGroundBus ?? { Bus.audio(s, 3) };    // v0.10: the Ground's Z, N, E (mono each) → \svkGroundRot
    ~svkFdnBus = ~svkFdnBus ?? { Bus.audio(s, 2) };          // v0.11 A/B: Body v2's optional send into \svkSpace
    ~svkRings = ~svkRings ?? { 3.collect { Buffer.alloc(s, kc[\RING], 1) } };
    s.sync;
    ~svkVoiceGrp = ~svkVoiceGrp ?? { Group.head(s) };
    ~svkCoreGrp = ~svkCoreGrp ?? { Group.after(~svkVoiceGrp) };
    ~svkSpatialGrp = ~svkSpatialGrp ?? { Group.after(~svkCoreGrp) };
    s.sync;

    // -------------------------------------------------------------- state --
    // the LIVE rows exactly as the page last sent them (the legend's holds start from these)
    ~svk = ~svk ?? { (
        w: [0, 0, 0, 0, 1], zoom: 8, speed: 1, cursor: [0, 0, 4], mode: 0, tilt: 0,
        tMode: kc[\tensionEncoding], tState: nil, legend: nil,
        live: (
            tension: [nil, nil, 1, 1, nil, nil, nil, nil],
            deform: [nil, nil, 1, 0, 0, 0, 0, 0, 1],      // v0.9 /svk_deform: period, inflow, h1–h6, gap
            array: (nil ! 9) ++ [1, 1, 1],                // v0.10 /svk_array: 9 velocities + 3 station gaps
            rumble: [nil, nil, 1],                        // v0.10 /svk_rumble: logE_abs, n_abs, gap
            body2: [0, 0.5, 1, 1, nil ! 36],              // v0.11 /svk_body2: theta, pressure, pin, gap, 36 g (gap 1 until data)
            bow: [-30, 0.5, 1],                           // v0.11 /svk_bow: bow_db, dust_hz, gap
            body: (e: 0 ! 4, c: 0.5 ! 4, gap: 1),
            swarm: [0, 0.5, 0.5, 0.5, 1]
        ),
        seen: (), count: (), pol: nil, ident: nil
    ) };
    ~svkG = ~svkG ?? { Array.newClear(3) };     // Ground, per channel (0 Z, 1 N, 2 E): see ~svkGroundStart

    // ------------------------------------------------------------- voices --
    ~svkVoices = ~svkVoices ?? { () };
    // v0.11: the retired voices (Tension A/B/C, 4-band Body, Array, Rumble, the FDN space) are spawned only for an A/B
    if (kc[\legacyVoices] and: { ~svkVoices[\tension].isNil }) {
        ~svkVoices[\tension] = Synth(\svkTension, [\out, ~svkMixBus.index, \rise, kc[\tensionRise],
            \fall, kc[\tensionFall], \scrapeAmp, kc[\scrapeAmp],
            \space, ~svkSpaceBus.index, \send, kc[\send][\tension]], ~svkVoiceGrp) };
    if (kc[\legacyVoices] and: { ~svkVoices[\deform].isNil }) {
        ~svkVoices[\deform] = Synth(\svkDeform, [\out, ~svkMixBus.index, \rise, kc[\deformRise],
            \fall, kc[\deformFall], \strikeGain, kc[\deformStrike],
            \strikeDecay, kc[\deformTauD] * kc[\deformTauSecPerDay], \cents, kc[\deformCents],
            \space, ~svkSpaceBus.index, \send, kc[\send][\deform]], ~svkVoiceGrp) };
    if (kc[\legacyVoices] and: { ~svkVoices[\body].isNil }) {
        ~svkVoices[\body] = Synth(\svkBody, [\out, ~svkMixBus.index, \exAmp, kc[\bodyExAmp], \dust, kc[\bodyDust],
            \dustAmp, kc[\bodyDustAmp], \freqs, ~svkBodyFreqs, \rings, ~svkBodyRings,
            \space, ~svkSpaceBus.index, \send, kc[\send][\body]], ~svkVoiceGrp) };
    if (~svkVoices[\swarm].isNil) {
        ~svkVoices[\swarm] = Synth(\svkSwarm, [\out, ~svkMixBus.index, \wood, kc[\swarmWood],
            \nLo, kc[\swarmNoiseLo], \nHi, kc[\swarmNoiseHi], \nCap, kc[\swarmNoiseCap], \nRq, kc[\swarmNoiseRq],
            \nCal, kc[\swarmNoiseCal], \pulseRef, kc[\swarmPulseRef],
            \space, ~svkSpaceBus.index, \send, kc[\roomSend][\swarm]], ~svkVoiceGrp) };   // v0.11: the clave → the comb
    if (kc[\legacyVoices] and: { ~svkVoices[\array].isNil }) {
        ~svkVoices[\array] = Synth(\svkArray, [\out, ~svkMixBus.index, \space, ~svkSpaceBus.index,
            \ring, kc[\arrayRing]], ~svkVoiceGrp) };
    if (kc[\legacyVoices] and: { ~svkVoices[\rumble].isNil }) {
        ~svkVoices[\rumble] = Synth(\svkRumble, [\out, ~svkMixBus.index, \space, ~svkSpaceBus.index,
            \send, kc[\send][\rumble]], ~svkVoiceGrp) };
    if (~svkVoices[\groundRot].isNil) {      // at the TAIL of the voices: after every \svkGround reader
        ~svkVoices[\groundRot] = Synth.tail(~svkVoiceGrp, \svkGroundRot, [\in, ~svkGroundBus.index,
            \out, ~svkMixBus.index, \space, ~svkSpaceBus.index, \lagT, kc[\groundRotLag],
            \sendZ, kc[\roomSend][\ground], \sendH, kc[\roomSend][\ground], \sendT, kc[\roomSend][\ground],   // dry (v0.11)
            \tiltAmp, kc[\groundTiltAmp]]) };
    if (kc[\spaceOn] and: { ~svkVoices[\space].isNil }) {   // HEAD of the core group: its return joins the mix before the core
        ~svkVoices[\space] = Synth.head(~svkCoreGrp, \svkSpace, [\in, ~svkFdnBus.index, \out, ~svkMixBus.index,
            \t60, kc[\spaceT60], \damp, kc[\spaceDamp], \wet, kc[\spaceWet], \pre, kc[\spacePre]]) };
    if (~svkVoices[\core].isNil) {
        ~svkVoices[\core] = Synth(\svkCore, [\in, ~svkMixBus.index, \out, ~svkCoreBus.index,
            \masBus, ~masterBus.index, \limit, kc[\limit]], ~svkCoreGrp) };
    if (~svkVoices[\spatial].isNil) {
        ~svkVoices[\spatial] = Synth(\svkSpatialStereo, [\in, ~svkCoreBus.index, \out, 0], ~svkSpatialGrp) };
    s.sync;

    // ----------------------------------------------------------- appliers --
    // the component gains in force: the page's level weights, or a legend hold's solo
    ~svkGains = {
        var l = ~svk[\legend];
        if (l.notNil) { ~svkSoloGains.(l[\layer], l[\qty]) } { ~svkFaderGains.(~svkMixGains.(~svk[\w]), ~svk[\faders]) }
    };
    ~svkApplyLevels = {
        var g = ~svkGains.value;
        ~svk[\gains] = g;
        [[\tension, \tension], [\deform, \tension], [\body, \body], [\swarm, \swarmTexture], [\array, \array],
         [\rumble, \rumble], [\groundRot, \ground]].do { |vk|
            ~svkVoices[vk[0]] !? { |v| v.set(\lvl, g[vk[1]]) } };
        ~svkVoices[\body2] !? { |v| v.set(\lvl, g[\body2]) };
        ~svkG.do { |gg| if (gg.notNil and: { gg[\voice].notNil }) { gg[\voice].set(\lvl, g[\ground]) } };
    };
    ~svkSetTension = { |c, withScrape = false|
        ~svkVoices[\tension] !? { |v|
            v.set(\freq, c[\freq], \press, c[\press], \veil, c[\veil], \amp, c[\amp],
                \refFreq, c[\refFreq], \refAmp, c[\refAmp], \beatHz, c[\beatHz], \rough, c[\rough]);
            if (withScrape and: { c[\scrape] == 1 }) { v.set(\t_scrape, 1) } };
        ~svk[\cooked_tension] = c;
    };
    ~svkSetArray = { |row|
        var c = ~svkCookArray.(row ?? { (nil ! 9) ++ [1, 1, 1] });
        ~svkVoices[\array] !? { |v|
            v.setn(\ex, c[\ex], \fq, c[\fq], \br, c[\br], \pan, c[\pan], \send, c[\send], \veil, c[\veil]);
            v.set(\amp, c[\amp]) };
        ~svk[\cooked_array] = c;
    };
    ~svkSetRumble = { |row|
        var c = ~svkCookRumble.(row[0], row[1], row[2]);
        ~svkVoices[\rumble] !? { |v| v.set(\amp, c[\amp], \dens, c[\dens]) };
        ~svk[\cooked_rumble] = c;
    };
    ~svkSetDeform = { |c|
        ~svkVoices[\deform] !? { |v|
            v.set(\f0, c[\f0], \amp, c[\amp], \veil, c[\veil], \strikeDecay, c[\strikeDecay]);
            v.setn(\h, c[\h]) };
        ~svk[\cooked_deform] = c;
    };
    // ---- Body v2 (v0.11): one \svkBody2 per room; a new room crossfades in over body2Fade s ----
    ~svkBody2Spawn = { |ident|
        var old = ~svkVoices[\body2];
        var b = ~svkCookBody2.(*~svk[\live][\body2]);
        var bw = ~svkCookBow.(*(~svk[\live][\bow] ++ [ident]));
        ~svkVoices[\body2] = Synth.head(~svkVoiceGrp, \svkBody2, [\out, ~svkMixBus.index, \room, ~svkSpaceBus.index,
            \amp, kc[\body2Amp] * ident[\roomGain], \lvl, (~svk[\gains] ? ~svkGains.value)[\body2],
            \exAmp, bw[\exAmp], \dust, bw[\dust],
            \dustAmp, kc[\body2DustAmp], \combDelay, ident[\combDelay],
            \combDecay, kc[\body2CombDecay][0] + (kc[\body2CombDecay][1] * 0.5),   // a new room rests mid-travel
            \glide, kc[\body2Glide], \fade, kc[\body2Fade],
            \freqs, ident[\freqs], \amps, ident[\amps], \rings, ident[\rings], \gains, ident[\rest],
            \pans, ident[\pans], \fdn, ~svkFdnBus.index, \fdnSend, ~svk[\fdnSend] ? kc[\fdnSend]]);
        old !? { |o| o.set(\gate, 0) };            // the outgoing room fades over the same 4 s and frees itself
        ("[svk] body room kind % id %: % modes, comb % Hz (data % Hz, folded by octaves into 35–140)".format(ident[\kind],
            ident[\id], ident[\n], ident[\comb].round(0.1), ident[\combRaw].round(0.1))).postln;
    };
    ~svkSetBody2 = { |row|
        var c = ~svkCookBody2.(*row);
        ~svkVoices[\body2] !? { |v|
            v.setn(\gains, c[\gains]);
            v.set(\pin, c[\pin], \combDecay, c[\combDecay], \veil, c[\veil],      // the body's own (GNSS) veil
                \amp, c[\amp] * ((~svk[\ident] !? { |id| id[\roomGain] }) ? 1)) };
        ~svk[\cooked_body2] = c;
    };
    ~svkSetBow = { |row|
        var c = ~svkCookBow.(*(row.keep(3) ++ [~svk[\ident]]));
        ~svkVoices[\body2] !? { |v| v.set(\exAmp, c[\exAmp], \dust, c[\dust], \bowVeil, c[\veil]) };   // v0.11.8: the bow's
        ~svk[\cooked_bow] = c;
    };
    // the legend's layer 6 on the current room: θ re-tilts the point's own gains by the seesaw's difference; pressure
    // and the bow push their one quantity; qty 10 + m sounds mode m alone
    ~svkLegendBody2 = { |qty, value|
        var row = ~svk[\live][\body2].copy, bow = ~svk[\live][\bow].copy, id = ~svk[\ident], g;
        if (row[3] == 1) { row = [row[0], row[1], 1, 0, id !? { id[\rest].keep(id[\n]) } ? (1 ! 36)] };
        g = (row[4] ? []).collect { |x| x ? 0 }.extend(36, 0);
        case
        { qty == 0 } { if (id.notNil) {
            var a = ~svkSeesaw.(value, id[\lnorm]), b = ~svkSeesaw.(row[0] ? 0.5, id[\lnorm]);
            g = g.collect { |x, i| x * ((a[i] / b[i].max(1e-6)).max(0) ** 2) } };
            row[0] = value.clip(0, 1) }
        { qty == 1 } { row[1] = value.clip(0, 1) }
        { qty == 2 } { bow = [value.clip(-30, 0), bow[1] ? 0.5, 0] }
        { qty >= 10 } { var m = (qty - 10).clip(0, 35);
            g = 0 ! 36; g[m] = if (id.notNil) { 1 / (id[\amps][m].max(0.05)) } { 1 }; row[2] = 1 };
        row[4] = g; row[3] = 0;
        ~svkSetBody2.(row);
        ~svkSetBow.(bow);
    };

    // the encoding in force: the switch, or T-C while a T-C legend row (layer 0, qty 6–8) is held
    ~svkMode = {
        var l = ~svk[\legend];
        if (l.notNil and: { l[\layer] == 0 } and: { l[\qty] >= 6 }) { \C } { ~svk[\tMode] }
    };
    ~svkSetBody = { |b|
        var c = ~svkCookBody.(b[\e], b[\c], b[\gap]);
        ~svkVoices[\body] !? { |v| v.setn(\amps, c[\amps]); v.set(\amp, c[\amp]) };
        ~svk[\cooked_body] = c;
    };
    ~svkSetSwarm = { |row|
        var c = ~svkCookSwarm.(row);
        ~svkVoices[\swarm].set(\rate, c[\rate], \ff, c[\ff], \dark, c[\dark], \dur, c[\dur], \amp, c[\amp]);
        ~svk[\cooked_swarm] = c;
    };
    // everything from the rows in force (live, or a legend hold's), no fall re-fired
    ~svkApplyAll = {
        var l = ~svk[\legend];
        var rows = if (l.notNil) { ~svkLegendRows.(l[\layer], l[\qty], l[\value], ~svk[\live]) } { ~svk[\live] };
        ~svkSetTension.(~svkCookTension.(rows[\tension], nil, ~svkMode.value));
        ~svkSetDeform.(~svkCookDeform.(rows[\deform], ~svkMode.value));
        ~svkSetBody.(rows[\body]);
        ~svkSetSwarm.(rows[\swarm]);
        ~svkSetArray.(rows[\array] ?? { ~svk[\live][\array] });
        ~svkSetRumble.(rows[\rumble] ?? { ~svk[\live][\rumble] });
        if (l.notNil and: { l[\layer] == 6 }) { ~svkLegendBody2.(l[\qty], l[\value]) } {
            ~svkSetBody2.(~svk[\live][\body2]);
            ~svkSetBow.(~svk[\live][\bow]) };
        ~svkApplyLevels.value;
    };
    ~svkLog = { |key, str|
        var n = (~svk[\count][key] ? 0) + 1;
        ~svk[\count][key] = n;
        if ((n <= 3) or: { (n % 200) == 0 }) { ("[svk] " ++ key ++ " #" ++ n ++ "  " ++ str).postln };
    };

    // ------------------------------------------------------------- GROUND --
    // Want/fill (CONTRACT §5). A play zeroes the channel's ring, sends its bufinfo, and wants all 16 blocks; the
    // reader starts once the first groundStartBlocks are filled. Each time the reader LEAVES a block, that block
    // is zeroed and wanted again (the page writes the next samples in sequence there). A block the reader enters
    // without a fill since its last want therefore plays zeros: an underrun is silence, never a replay of an old
    // lap (R3). The playhead is (day, sec) at the ring's start + frames read / 100 Hz, sent 20× a second.
    ~svkGroundStop = { |chan|
        var g = ~svkG[chan];
        if (g.notNil) {
            if (g[\voice].notNil) { g[\voice].set(\gate, 0) };
            ~svkG[chan] = nil;
        };
    };
    ~svkGroundStart = { |chan, day, sec, speed|
        var ring = ~svkRings[chan];
        ~svkGroundStop.(chan);
        ~svkG[chan] = (day0: day, sec0: sec, speed: speed, abs: 0, lastPos: 0, lastBlock: 0,
            fresh: false ! nb, voice: nil, node: nil, under: 0);
        // clear with /b_fill (synchronous on the server's command queue), NOT Buffer.zero (/b_zero is asynchronous:
        // in the web build early fills landed before it finished and were wiped; W5 note §4), and before bufinfo
        s.sendMsg("/b_fill", ring.bufnum, 0, kc[\RING], 0.0);
        ~svkSend.("/svk_bufinfo", chan, ring.bufnum, kc[\RING]);
        nb.do { |k| ~svkSend.("/svk_want", chan, k * kc[\BLOCK], kc[\BLOCK]) };
        // pre-roll (SC's choice, v0.5 a): start on the first filled blocks, or after groundPreroll at the latest —
        // /svk_filled is advisory (e) and may never come; the ring was zeroed, so a late fill is silence, not noise
        { |g| SystemClock.sched(kc[\groundPreroll], { if (~svkG[chan] === g) { ~svkGroundSpawn.(chan) }; nil }) }
            .value(~svkG[chan]);
        ("[svk] ground chan % play from day % sec % at %x (ring buf %)".format(chan, day, sec, speed, ring.bufnum)).postln;
    };
    ~svkGroundSpawn = { |chan|
        var g = ~svkG[chan], c;
        if (g.notNil and: { g[\voice].isNil }) {
            c = ~svkCookGround.(~svk[\legendSpeed] ? g[\speed], chan);
            g[\voice] = Synth(\svkGround, [\out, ~svkGroundBus.index + chan, \buf, ~svkRings[chan].bufnum,
                \rate, c[\rate], \amp, c[\amp], \lvl, (~svk[\gains] ? ~svkGains.value)[\ground],
                \chan, chan, \ringFrames, kc[\RING], \hpHz, kc[\groundHpHz], \limit, kc[\groundLimit],
                \tiltOct, ~svkCookTilt.(~svk[\tilt])], ~svkVoiceGrp);
            g[\node] = g[\voice].nodeID;
            ("[svk] ground chan % reading (%x)".format(chan, g[\speed])).postln;
        };
    };
    ~svkGroundRate = { |chan, speed|
        var g = ~svkG[chan];
        if (g.notNil and: { g[\voice].notNil }) { g[\voice].set(\rate, ~svkCookGround.(speed, chan)[\rate]) };
    };

    // ------------------------------------------------------------ OSCdefs --
    [\svkZoom, \svkCursor, \svkTension, \svkDeform, \svkArray, \svkRumble, \svkPol, \svkBody, \svkSwarm,
     \svkIdentity, \svkBody2, \svkBow, \svkStrike, \svkFdn, \svkEvent, \svkGround, \svkFilled, \svkGpos,
     \svkLegend, \svkMaster, \svkMode, \svkReadout, \svkHello, \svkTensionMode, \svkTilt].do { |k| OSCdef(k).free };

    OSCdef(\svkZoom, { |msg|
        // zoom, w0..w4, speed — the page's weights, applied through the DESIGN §4.5 table (~svkMixGains)
        ~svk[\zoom] = msg[1].asFloat;
        ~svk[\w] = msg[2..6].collect { |x| (x ? 0).asFloat };
        ~svk[\speed] = (msg[7] ? 1).asFloat;
        ~svkApplyLevels.value;
        ~svkLog.(\zoom, "zoom % w %".format(~svk[\zoom].round(0.01), ~svk[\w].round(0.01)));
    }, '/svk_zoom');

    OSCdef(\svkCursor, { |msg|
        ~svk[\cursor] = [msg[1].asInteger, msg[2].asFloat, msg[3].asInteger];   // kept; the page is the clock
    }, '/svk_cursor');

    OSCdef(\svkTension, { |msg|
        var row = [~svkNum.(msg[1]), ~svkNum.(msg[2]), (msg[3] ? 1).asInteger, (msg[4] ? 1).asInteger,
                   ~svkNum.(msg[5]), ~svkNum.(msg[6]), ~svkNum.(msg[7]), ~svkNum.(msg[8])];   // v0.8: + ref_abs
        var c = ~svkCookTension.(row, ~svk[\tState], ~svkMode.value);
        ~svk[\live][\tension] = row;
        ~svk[\tState] = c[\state];
        if (~svk[\legend].isNil) {
            ~svkSetTension.(c, true);
            // T-C: an eruption (the same fall: phase-2 onset, hidden eruptions included) re-strikes the mode
            if ((~svkMode.value == \C) and: { c[\scrape] == 1 }) { ~svkVoices[\deform] !? { |v| v.set(\t_strike, 1) } };
        };
        if (c[\scrape] == 1) { ~svkLog.(\fall, "fall to % Hz".format(c[\freq].round(0.1))) };
        ~svkLog.(\tension, row.asString);
    }, '/svk_tension');

    OSCdef(\svkBody, { |msg|
        var b = (e: msg[1..4].collect { |x| (~svkNum.(x) ? 0) }, c: msg[5..8].collect { |x| (~svkNum.(x) ? 0.5) },
                 gap: (msg[9] ? 1).asInteger);
        ~svk[\live][\body] = b;
        if (~svk[\legend].isNil) { ~svkSetBody.(b) };
        ~svkLog.(\body, b.asString);
    }, '/svk_body');

    OSCdef(\svkDeform, { |msg|
        // v0.9: cycle_period_d, inflow_rel, h1 … h6, gap — sent with every tension row; only T-C sounds it
        var row = [~svkNum.(msg[1]), ~svkNum.(msg[2])] ++ msg[3..8].collect { |x| ~svkNum.(x) } ++ [(msg[9] ? 1).asInteger];
        ~svk[\live][\deform] = row;
        if (~svk[\legend].isNil) { ~svkSetDeform.(~svkCookDeform.(row, ~svkMode.value)) };
        ~svkLog.(\deform, row.asString);
    }, '/svk_deform');

    OSCdef(\svkIdentity, { |msg|
        // v0.11: kind (0 sequence, 1 cycle, 2 regime), id, n, comb_hz, n × [freq_hz, amp, ring_s, harm, detune],
        // n × rest_gain — once per room change; the same room again is ignored (no rebuild, no crossfade)
        var kind = msg[1].asInteger, id = msg[2].asInteger, n = msg[3].asInteger, comb = msg[4].asFloat;
        var modes, rest, ident;
        if ((n < 1) or: { [5, 6, 7].collect { |k| k + (6 * n) }.includes(msg.size).not }) {
            ("[svk] /svk_identity IGNORED: % modes needs % (+ room_gain, + bow_neutral_db) args, got %".format(n,
                5 + (6 * n), msg.size)).postln;
        } {
            if (~svk[\ident].isNil or: { ~svk[\ident][\kind] != kind } or: { ~svk[\ident][\id] != id }) {
                modes = n.collect { |i| var o = 5 + (i * 5);
                    [msg[o].asFloat, msg[o + 1].asFloat, msg[o + 2].asFloat, msg[o + 3].asInteger, msg[o + 4].asFloat] };
                rest = n.collect { |i| ~svkNum.(msg[5 + (5 * n) + i]) ? 1 };
                ident = ~svkCookIdentity.(kind, id, comb, modes, rest,
                    if (msg.size >= (6 + (6 * n))) { ~svkNum.(msg[5 + (6 * n)]) } { nil },    // v0.11.6 room_gain
                    if (msg.size >= (7 + (6 * n))) { ~svkNum.(msg[6 + (6 * n)]) } { nil });   // v0.11.7 bow_neutral_db
                ~svk[\ident] = ident;
                ~svkBody2Spawn.(ident);
                ~svkApplyAll.value;
            };
        };
    }, '/svk_identity');

    OSCdef(\svkBody2, { |msg|
        // v0.11: theta, pressure, pin, gap, 36 × g (nullable → NaN → that mode silent)
        var row = [~svkNum.(msg[1]), ~svkNum.(msg[2]), ~svkNum.(msg[3]), (msg[4] ? 1).asInteger,
                   msg[5..40].collect { |x| ~svkNum.(x) }];
        ~svk[\live][\body2] = row;
        if (~svk[\legend].isNil) { ~svkSetBody2.(row) };
        ~svkLog.(\body2, "theta % pressure % pin % gap %".format(row[0], row[1], row[2], row[3]));
    }, '/svk_body2');

    OSCdef(\svkBow, { |msg|
        // v0.11: bow_db (the inflow, dB, floor −30), dust_hz (0.5–5), gap
        var row = [~svkNum.(msg[1]), ~svkNum.(msg[2]), (msg[3] ? 1).asInteger];
        ~svk[\live][\bow] = row;
        if (~svk[\legend].isNil) { ~svkSetBow.(row) };
        ~svkLog.(\bow, row.asString);
    }, '/svk_bow');

    OSCdef(\svkStrike, { |msg|
        // v0.11: delay_s, size (0–1), kind (0 magmatic, 1 hidden) — a timestamped bundle (A8), its own voice, at the
        // current room's lowest mode, its level × the strike's mix gain
        var delay = (msg[1] ? 0).asFloat, f = ~svkCookStrike.(~svkNum.(msg[2]), msg[3], ~svk[\ident]);
        var g = (~svk[\gains] ? ~svkGains.value)[\strike];
        var args = f[1].copy;
        args[args.indexOf(\amp) + 1] = args[args.indexOf(\amp) + 1] * g;
        if (~svk[\legend].isNil and: { g > 0.001 }) {
            s.makeBundle(if (delay > 0.001) { delay } { nil }, {
                Synth(f[0], args ++ [\out, ~svkMixBus.index, \room, ~svkSpaceBus.index], ~svkVoiceGrp) });
            ~svkLog.(\strike, "size % kind % at % Hz".format(msg[2], msg[3], args[1].round(0.1)));
        };
    }, '/svk_strike');

    OSCdef(\svkFdn, { |msg|
        // DEV / A-B ONLY (not in the contract): Body v2's send into the v0.10 FDN space (\svkSpace). 0 = the
        // re_wilding way (the comb is the room, the default); the coordinator's "low FDN send" variant is fdnSendLow
        var v = (~svkNum.(msg[1]) ? 0).clip(0, 1);
        ~svk[\fdnSend] = v;
        if ((v > 0) and: { ~svkVoices[\space].isNil }) {
            ~svkVoices[\space] = Synth.head(~svkCoreGrp, \svkSpace, [\in, ~svkFdnBus.index, \out, ~svkMixBus.index,
                \t60, kc[\spaceT60], \damp, kc[\spaceDamp], \wet, kc[\spaceWet], \pre, kc[\spacePre]]) };
        ~svkVoices[\body2] !? { |b| b.set(\fdnSend, v) };
        ("[svk] FDN send % (A/B)".format(v)).postln;
    }, '/svk_fdn');

    OSCdef(\svkArray, { |msg|
        // v0.10: sksh_n, sksh_e, sksh_u, seng_n, seng_e, seng_u, thob_n, thob_e, thob_u (signed −1…1, nullable),
        // gap_sksh, gap_seng, gap_thob — levels 1–4
        var row = msg[1..9].collect { |x| ~svkNum.(x) } ++ msg[10..12].collect { |x| (x ? 1).asInteger };
        ~svk[\live][\array] = row;
        if (~svk[\legend].isNil) { ~svkSetArray.(row) };
        ~svkLog.(\array, row.collect { |x| if (x.isNil) { nil } { x.round(0.01) } }.asString);
    }, '/svk_array');

    OSCdef(\svkRumble, { |msg|
        // v0.10: logE_abs, n_abs (nullable), gap; v0.10.2: no events = 0/0/gap 0 (a measured quiet: the floor)
        var row = [~svkNum.(msg[1]), ~svkNum.(msg[2]), (msg[3] ? 1).asInteger];
        ~svk[\live][\rumble] = row;
        if (~svk[\legend].isNil) { ~svkSetRumble.(row) };
        ~svkLog.(\rumble, row.asString);
    }, '/svk_rumble');

    OSCdef(\svkPol, { |msg|
        // v0.10: az_deg (0–180), R (f1m), rect, nullable — rotates the Ground's horizontal pair (\svkGroundRot)
        var c = ~svkCookPol.(~svkNum.(msg[1]), ~svkNum.(msg[2]), ~svkNum.(msg[3]), (~svk[\pol] ? ())[\az]);
        ~svk[\pol] = c;
        ~svkVoices[\groundRot] !? { |v| v.set(\az, c[\az], \polR, c[\polR]) };
        ~svkLog.(\pol, "az % R %".format(c[\az].round(0.1), c[\polR].round(0.01)));
    }, '/svk_pol');

    OSCdef(\svkSwarm, { |msg|
        var row = [~svkNum.(msg[1]) ? 0, ~svkNum.(msg[2]) ? 0.5, ~svkNum.(msg[3]) ? 0.5, ~svkNum.(msg[4]) ? 0.5,
                   (msg[5] ? 1).asInteger];
        ~svk[\live][\swarm] = row;
        if (~svk[\legend].isNil) { ~svkSetSwarm.(row) };
        ~svkLog.(\swarm, row.asString);
    }, '/svk_swarm');

    OSCdef(\svkEvent, { |msg|
        // delay_s, mag, depth_km, fc_hz, pan, id_hash, depth_abs (v0.8) — fired as a timestamped bundle `delay_s`
        // from now (A8).
        // A held legend owns the sound: catalogue events wait. An id seen again within dedupS is not re-fired.
        var delay = (msg[1] ? 0).asFloat, mag = (msg[2] ? 0).asFloat, depth = ~svkNum.(msg[3]),
            fc = ~svkNum.(msg[4]), pan = (msg[5] ? 0).asFloat, id = (msg[6] ? -1).asInteger, dAbs = ~svkNum.(msg[7]);
        var now = Main.elapsedTime, fire;
        if (~svk[\legend].isNil and: { ((now - (~svk[\seen][id] ? -100)) > kc[\dedupS]) or: { id < 0 } }) {
            ~svk[\seen][id] = now;
            if (~svk[\seen].size > 4000) { ~svk[\seen] = () };
            fire = ~svkCookEvent.(mag, depth, fc, pan, ~svk[\gains] ? ~svkGains.value, dAbs);
            if (fire.size > 0) {
                s.makeBundle(if (delay > 0.001) { delay } { nil }, {
                    fire.do { |f| Synth(f[0], f[1] ++ [\out, ~svkMixBus.index, \space, ~svkSpaceBus.index],
                        ~svkVoiceGrp) };
                });
            };
            ~svkLog.(\event, "M% fc % → %".format(mag, fc, fire.collect(_.first)));
        };
    }, '/svk_event');

    OSCdef(\svkGround, { |msg|
        // cmd (0 stop, 1 play, 2 speed only — v0.8), chan (0 Z, 1 N, 2 E), day, sec, ground_speed. cmd 2 keeps the
        // playhead (day/sec ignored): the ring holds the samples in order whatever the speed. A cmd 1 for a channel
        // already playing, at its current playhead (± max(1 s, groundSeekTol × speed) of data), is also treated as
        // a speed change (older senders); anywhere else, cmd 1 is a seek.
        var cmd = msg[1].asInteger, chan = msg[2].asInteger.clip(0, 2), day = msg[3].asInteger,
            sec = msg[4].asFloat, speed = (msg[5] ? 250).asFloat;
        var g = ~svkG[chan], ph, dt;
        if (cmd == 2) {
            if (g.notNil) {
                g[\speed] = speed;
                if (~svk[\legendSpeed].isNil) { ~svkGroundRate.(chan, speed) };
                ("[svk] ground chan % speed %x (cmd 2)".format(chan, speed)).postln;
            };
        } {
        if (cmd == 0) { ~svkGroundStop.(chan); ("[svk] ground chan % stop".format(chan)).postln } {
            ph = if (g.notNil) { ~svkPlayhead.(g[\day0], g[\sec0], g[\abs]) } { nil };
            dt = if (ph.notNil) { ((day - ph[0]) * 86400) + (sec - ph[1]) } { inf };
            if (g.notNil and: { dt.abs <= max(1, kc[\groundSeekTol] * g[\speed]) }) {
                g[\speed] = speed;
                if (~svk[\legendSpeed].isNil) { ~svkGroundRate.(chan, speed) };
                ("[svk] ground chan % speed %x".format(chan, speed)).postln;
            } { ~svkGroundStart.(chan, day, sec, speed) };
        };
        };
    }, '/svk_ground');

    OSCdef(\svkFilled, { |msg|
        var chan = msg[1].asInteger.clip(0, 2), off = msg[2].asInteger, n = msg[3].asInteger;
        var g = ~svkG[chan], blk;
        if (g.notNil) {
            blk = (off / kc[\BLOCK]).floor.asInteger.clip(0, nb - 1);
            g[\fresh][blk] = true;
            if (g[\voice].isNil and: { g[\fresh].keep(kc[\groundStartBlocks]).every(_ == true) }) {
                ~svkGroundSpawn.(chan) };
        };
    }, '/svk_filled');

    OSCdef(\svkGpos, { |msg|
        // from \svkGround's SendReply: [addr, nodeID, chan, ring position]
        var node = msg[1], chan = msg[2].asInteger, pos = msg[3].asFloat;
        var g = ~svkG[chan], d, blk, left, ring, ph;
        if (g.notNil and: { g[\node] == node }) {
            ring = ~svkRings[chan];
            d = pos - g[\lastPos];
            if (d < 0) { d = d + kc[\RING] };
            g[\abs] = g[\abs] + d;
            g[\lastPos] = pos;
            blk = (pos / kc[\BLOCK]).floor.asInteger.clip(0, nb - 1);
            while { g[\lastBlock] != blk } {
                left = g[\lastBlock];
                s.sendMsg("/b_fill", ring.bufnum, left * kc[\BLOCK], kc[\BLOCK], 0.0);
                g[\fresh][left] = false;
                ~svkSend.("/svk_want", chan, left * kc[\BLOCK], kc[\BLOCK]);
                g[\lastBlock] = (left + 1) % nb;
                if (g[\fresh][g[\lastBlock]].not) {
                    // advisory (v0.5 e): no /svk_filled since this block's want — silence if the data is truly late
                    g[\under] = g[\under] + 1;
                    if ((g[\under] <= 3) or: { (g[\under] % 50) == 0 }) {
                        ("[svk] ground chan % entered block % with no /svk_filled since its want (#%)".format(
                            chan, g[\lastBlock], g[\under])).postln };
                };
            };
            ph = ~svkPlayhead.(g[\day0], g[\sec0], g[\abs]);
            ~svkSend.("/svk_playhead", chan, ph[0], ph[1]);
        };
    }, '/svk_gpos');

    OSCdef(\svkLegend, { |msg|
        // layer, qty, value, hold — C5 §19 hold-to-hear (quantities: svk_cook.scd ~svkLegendRows)
        var layer = msg[1].asInteger, qty = msg[2].asInteger, value = msg[3].asFloat, hold = msg[4].asInteger;
        var bell;
        if (~svkLegendBells.notNil) { ~svkLegendBells.stop; ~svkLegendBells = nil };
        if (hold == 1) {
            ~svk[\legend] = (layer: layer, qty: qty, value: value);
            ~svk[\legendSpeed] = nil;
            ~svkApplyAll.value;
            if ((layer == 0) and: { qty == 8 }) { ~svkVoices[\deform] !? { |v| v.set(\t_strike, 1) } };   // T-C re-strike
            if ((layer == 2) and: { qty == 4 }) {
                bell = ~svkCookEvent.(value, nil, ~svkBruneFc.(value), 0, ~svkSoloGains.(2, 4));
                ~svkLegendBells = Routine {
                    loop {
                        bell.do { |f| Synth(f[0], f[1] ++ [\out, ~svkMixBus.index, \space, ~svkSpaceBus.index],
                            ~svkVoiceGrp) };
                        kc[\legendBellEvery].wait;
                    };
                }.play(SystemClock);
            };
            if (layer == 3) {
                ~svk[\legendSpeed] = value;
                3.do { |ch| ~svkGroundRate.(ch, value) };
                if (~svkG.every(_.isNil)) { "[svk] legend: Ground speed held, but no Ground is playing".postln };
            };
            ("[svk] legend hold layer % qty % value %".format(layer, qty, value)).postln;
        } {
            ~svk[\legend] = nil;
            if (~svk[\legendSpeed].notNil) {
                ~svk[\legendSpeed] = nil;
                3.do { |ch| var g = ~svkG[ch]; if (g.notNil) { ~svkGroundRate.(ch, g[\speed]) } };
            };
            ~svkApplyAll.value;
            "[svk] legend release".postln;
        };
    }, '/dark_legend');

    OSCdef(\svkMix, { |msg|
        // v0.12 the sound-tab faders: body strike swarm bells ground (0–1). Each scales its voices' level after the
        // zoom-level mix, through the voices' lvl (Lag 0.3 s to 60 dB, ≈ 0.1 s to 90 %); one-shot voices (strike,
        // bells, grains, ticks) take it at their next onset. Legend holds are not faded. All 1 at boot.
        ~svk[\faders] = ~svkCookFaders.(msg[1..5].collect { |x| ~svkNum.(x) });
        ~svkApplyLevels.value;
        ~svkLog.(\mix, ~svk[\faders].asString);
    }, '/svk_mix');

    OSCdef(\svkMaster, { |msg|
        ~svk[\master] = (msg[1] ? kc[\masterDefault]).asFloat.clip(0, 1);
        ~masterBus.set(~svk[\master]);
    }, '/dark_master');

    OSCdef(\svkMode, { |msg|
        // 0 archive, 1 replay_live, 2 live: the same sound path in every mode (live chunks just arrive later)
        ~svk[\mode] = msg[1].asInteger;
        ("[svk] mode " ++ ["archive", "replay_live", "live"].clipAt(~svk[\mode])).postln;
    }, '/svk_mode');

    OSCdef(\svkReadout, { |msg|
        // /svk_readout layer hz level (CONTRACT v0.5): what is SOUNDING, 4× a second, from the voices themselves
        // (SendReply '/svk_ro'), so the page never draws a pitch from its own formula (A4/A6). hz is NaN when the
        // layer is silent. Body: the centre of the dominant band (the cooked balance); Ground: the audified
        // signal's zero-crossing frequency, the loudest playing channel.
        var layer = msg[2].asInteger, hz = msg[3].asFloat, level = msg[4].asFloat, sh, gch, recent, send = true;
        if (layer == 0) {   // T-A/B speak through \svkTension, T-C through \svkDeform: only the voice in force reports
            send = msg[1] == ((if (~svkMode.value == \C) { ~svkVoices[\deform] } { ~svkVoices[\tension] }) !? (_.nodeID));
        };
        if (layer == 6) {   // v0.11: Body v2 = layer 6; hz = the room's comb_hz; only the CURRENT room reports
            send = msg[1] == (~svkVoices[\body2] !? (_.nodeID));
            hz = (~svk[\ident] !? { |id| id[\comb] }) ? (0/0);
        };
        if (layer == 1) {   // the legacy 4-band Body (spawned only with legacyVoices)
            sh = (~svk[\cooked_body] ? ())[\shape];
            hz = if (sh.notNil and: { sh.maxItem > 0 }) { ~svkBodyCentres[sh.maxIndex] } { 0/0 };
        };
        if (layer == 4) {     // the Array: the pitch of its most excited voice
            sh = (~svk[\cooked_array] ? ())[\ex];
            hz = if (sh.notNil and: { sh.maxItem > 0 }) { ~svk[\cooked_array][\fq][sh.maxIndex] } { 0/0 };
        };
        if (layer == 5) { hz = 0/0 };      // the Rumble is unpitched

        if (layer == 3) {
            // one Ground readout per tick: the loudest channel heard in the last 0.5 s
            gch = msg[5].asInteger;
            ~svk[\groundRo] = (~svk[\groundRo] ? ()).put(gch, [hz, level, Main.elapsedTime]);
            recent = ~svk[\groundRo].values.select { |v| (Main.elapsedTime - v[2]) < 0.5 };
            send = recent.maxItem { |v| v[1] } === ~svk[\groundRo][gch];
        };
        if (send) {
            if (level < 1e-4) { hz = 0/0 };
            ~svkSend.("/svk_readout", layer, hz, level);
        };
    }, '/svk_ro');

    // ---- CONTRACT v0.8 §5.0 (W2's requests, accepted) --------------------------------------------------------------
    ~svkHello = {
        ~svkSend.("/svk_ready", "synthdefs");
        ~svkSend.("/svk_ready", "buffers");
        ~svkRings.do { |b, ch| ~svkSend.("/svk_bufinfo", ch, b.bufnum, kc[\RING]) };
        ~svkSend.("/svk_ready", "cook");
    };
    OSCdef(\svkHello, { ~svkHello.value }, '/svk_hello');
    OSCdef(\svkTensionMode, { |msg|
        ~svk[\tMode] = [\A, \B, \C].clipAt(msg[1].asInteger);     // 0 T-A, 1 T-B, 2 T-C (v0.9)
        ~svkApplyAll.value;
        ("[svk] Tension encoding T-" ++ ~svk[\tMode]).postln;
    }, '/svk_tension_mode');
    OSCdef(\svkTilt, { |msg|
        ~svk[\tilt] = (~svkNum.(msg[1]) ? 0);
        ~svkG.do { |g| if (g.notNil and: { g[\voice].notNil }) { g[\voice].set(\tiltOct, ~svkCookTilt.(~svk[\tilt])) } };
        ~svkVoices[\groundRot] !? { |v| v.set(\tilt, ~svk[\tilt]) };      // v0.10: the slow sub-rumble
    }, '/svk_tilt');

    // ------------------------------------------------------------- ready --
    ~svkApplyAll.value;
    ~svkHello.value;
    ("[dark_svartsengi] READY — /svk_* on sclang langPort " ++ NetAddr.langPort ++ ", replies to "
        ++ (~svkReplyTo ?? { ~svkRelay.value })).postln;
}.forkIfNeeded;
)
