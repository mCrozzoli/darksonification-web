// GENERATED by web_implementation/build/build_web.py from sc/svk_synthdefs.scd (sha256 211efbbbe64e02c8) — do not edit here.
// The desktop's sc/dark_svartsengi_boot.scd does `~svkDefs = (dir +/+ "svk_synthdefs.scd").load; ~svkDefs.do(_.add);
// s.sync;` inside s.waitForBoot. Here the file's text is inlined in place of the read (the WASM sclang has no file
// access) and the same two steps follow, in a fork (s.sync needs a Routine), then a readiness variable for engine.js.
~webSynthsReady = false;
fork {
~svkDefs = (
// dark_svartsengi — the SynthDefs, ONE copy (web rules A1–A3, A5, A12; DESIGN §4; CONTRACT §5).
//
// The value of this file is an Array of SynthDefs, NOT added. Every reader decides what to do with them:
//   sc/dark_svartsengi_boot.scd     ~svkDefs = this file's value; ~svkDefs.do(_.add)        (the live show)
//   dev/render/harness.scd          the same, on its own private server                      (the renders)
//   dev/render/gate_compile.scd     .writeDefFile each with NO server booted                 (the A2 gate)
//   web build (W5)                  writeDefFile → .scsyndef, or this text inlined            (WASM sclang)
// So: no `var` at the top, no `.add`, no `s`, no Bus/Buffer (buses and buffers are ARGUMENTS), no path idiom,
// no sclang randomness (`.rand`, `rrand`, `.choose` would be frozen into the def; A12: Rand/TRand if needed).
// Core UGens only (A3). Every voice writes STEREO to `out` (the mix bus); \svkCore applies the master and the
// limiter; \svkSpatialStereo is the separate spatial stage (A5) that a ring / binaural stage replaces later.
//
// Voices: \svkTension (T-A / T-B) and \svkDeform (T-C, v0.9; the default from v0.10) share the Tension layer behind
// one switch. v0.10 (aesthetic v1): every voice also sends into ONE shared space (\svkSpace, `space` = its bus,
// `send` = its amount); new layers \svkArray (the 9 GNSS sensors) and \svkRumble (the catalogue's energy);
// the Ground is placed by \svkGroundRot (polarization).
// v0.14 (CONTRACT 0.14, Leif's listening point): the PLACED voices (ticks, grains, bells, the strike, the Ground) carry
// dg (distance gain), lpf (distance + behind low-pass) and pan (sin az; gpan/gdg/glpf for the Ground), all cooked by
// ~svkCookPlace from the page's listener-relative az / dist_km. The body, bow and Swarm texture are never placed.
// v0.11 (Body v2, DESIGN §4.0 / R5): the DEFAULT sound is \svkBody2 (the spectroscopic body with its room comb) plus
// separate voices (the Swarm as the clave, bells, \svkStrike) sending into that comb at 0.25, and the Ground dry. The
// Tension voices, the 4-band \svkBody, \svkArray, \svkRumble and \svkSpace stay here for comparison only.
// Layer contract (DESIGN §4, after dark_re_wilding): Tension + Body = continuous = MEASUREMENT;
// Swarm = discrete = INFERENCE (IMO's catalogue); Ground = the waveform itself = EVIDENCE.
// Every level, gain and pitch below arrives from sc/svk_cook.scd; the defaults here are neutral and silent.
[
// ------------------------------------------------------------------ TENSION --
// One bowed, sustained voice; WHAT its pitch encodes is cooked (two candidates, DESIGN §4.1 v0.3):
//   T-A  freq = SKSH uplift on the whole-sequence scale (110–330 Hz); a quiet REFERENCE tone (refFreq, refAmp) holds
//        at the last eruption's start level, so the interval between the two is the distance; the WAIT adds a
//        beating twin (beatHz) and, past the longest earlier wait, roughness (rough: 33 Hz AM).
//   T-B  freq = 110 · 2^recharge_frac; no reference, no wait (refAmp = beatHz = rough = 0).
// The pitch moves on a log2 scale through LagUD: up quickly (rise), down always as a glide (fall), so a deflation
// is heard as a fall even when the page's cursor jumps two days per tick. press (u_rate_abs) is bow pressure:
// brightness, bow jitter and grit. t_scrape = the bow-scrape at the onset of a fall. veil (gap 2, interpolated
// GNSS): the same pitch, but breath — resonant noise at the first harmonics — instead of the bowed tone (R3).
SynthDef(\svkTension, { |out = 0, gate = 1, freq = 110, rise = 0.12, fall = 1.4, press = 0.3, veil = 0,
                         amp = 0, lvl = 0, t_scrape = 0, scrapeAmp = 0.5, breathGain = 9,
                         beatHz = 0, rough = 0, refFreq = 220, refAmp = 0, space = 0, send = 0|
    var env = EnvGen.kr(Env.asr(2, 1, 3), gate, doneAction: 2);
    var f = 2 ** LagUD.kr(freq.log2, rise, fall);
    var p = Lag.kr(press, 0.8);
    var v = Lag.kr(veil, 1.5);
    var bt = Lag.kr(beatHz, 2);
    var rg = Lag.kr(rough, 2);
    var fr = f * (1 + LFNoise2.kr(0.25, 0.0012)) * (1 + (LFNoise1.kr(37) * 0.0035 * p.squared));
    var saw = (Saw.ar(fr) + Saw.ar(fr + bt)) * 0.5;
    var cut = (fr * (2.5 + (p * 11))).clip(150, 14000);
    var tone = RLPF.ar(saw, cut, 0.75 - (p * 0.35));
    var grit = 1 - (p.squared * 0.3 * LFNoise2.ar(fr * 0.25).abs);
    var rosin = BPF.ar(PinkNoise.ar(1), (fr * 3).clip(100, 12000), 1.2) * (0.04 + (p * 0.10));
    var formants = BPF.ar(tone, [270, 510, 1180, 2650], [0.35, 0.3, 0.3, 0.35], [1.0, 0.75, 0.55, 0.3]).sum;
    var bowed = ((formants * 1.4) + (tone * 0.5)) * grit + rosin;
    var breath = (BPF.ar(PinkNoise.ar(1), fr * [1, 2, 3, 4], 0.02, [1, 0.6, 0.35, 0.2]).sum * breathGain)
               + LPF.ar(PinkNoise.ar(0.05), 900);
    var scrape = BPF.ar(WhiteNoise.ar(1), [1700, 3300], 0.4).sum
               * EnvGen.kr(Env.perc(0.004, 0.4, 1, -5), t_scrape) * scrapeAmp;
    var rf = 2 ** Lag.kr(refFreq.log2, 2);
    var ref = (SinOsc.ar(rf) + (SinOsc.ar(rf * 2) * 0.3) + (SinOsc.ar(rf * 3) * 0.1)) * Lag.kr(refAmp, 1.5);
    var sig = (bowed * (1 - v)) + (breath * v);
    sig = sig * (1 - (rg * (SinOsc.ar(33) * 0.5 + 0.5)));
    sig = (sig + scrape) * Lag.kr(amp, 0.4);
    sig = LeakDC.ar(sig + ref) * Lag.kr(lvl, 0.3) * env;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [f, Amplitude.kr(sig, 0.05, 0.3)], 0);   // /svk_readout (v0.5)
    Out.ar(out, Pan2.ar(sig, 0));
    Out.ar(space, Pan2.ar(sig * send, 0));                                        // the shared space (v0.10)
}),

// ---------------------------------------------------------- TENSION T-C (v0.9) --
// "The deformation mode" (DESIGN §4.1, FINDINGS F7): the eruption cycle read as a ringdown. f0 = the cycle's
// frequency moved up 30 octaves (cooked); partials n·f0 at the cycle's own Fourier magnitudes \h (6, equal-power
// normalised by the cook); amp = the inflow, floored (the ringdown). t_strike = an eruption re-strikes the mode:
// louder and brighter for strikeDecay s, then it settles at the inflow level. f0 glides on log2 through LagUD: a
// lengthening cycle glides down (fall), a new cycle after an eruption moves up (rise). Partials above 0.45 SR are
// dropped. No LeakDC: its ≈ 35 Hz corner would eat today's 28.6 Hz fundamental. veil (gap 2): the same partials as
// breath. Silent unless the cook selects T-C. Same mix component as \svkTension (lvl = the Tension gain).
SynthDef(\svkDeform, { |out = 0, gate = 1, f0 = 95, rise = 0.1, fall = 1.4, amp = 0, lvl = 0, veil = 0,
                        t_strike = 0, strikeGain = 1, strikeDecay = 7, breathGain = 9, space = 0, send = 0|
    var env = EnvGen.kr(Env.asr(2, 1, 3), gate, doneAction: 2);
    var h = NamedControl.kr(\h, [1, 0, 0, 0, 0, 0]).lag(2);
    var cents = NamedControl.kr(\cents, [2.0, 3.0, 3.7, 4.4, 5.2, 6.1]);   // the twins' detune: slow beating
    var f = 2 ** LagUD.kr(f0.log2, rise, fall);
    var v = Lag.kr(veil, 1.5);
    // the ringdown: an eruption strikes the mode; it rings out over strikeDecay (scaled from the inflow's τ, cooked)
    var st = EnvGen.kr(Env.perc(0.005, strikeDecay, 1, -3), t_strike);
    var tone = Mix.fill(6, { |i|
        var fn = f * (i + 1);
        var tw = fn * (2 ** (cents[i] / 1200));
        ((SinOsc.ar(fn) + SinOsc.ar(tw, 0.5pi)) * 0.5) * h[i] * (1 + (st * i * 0.5))
            * (tw < (SampleRate.ir * 0.45))
    });
    var breath = Mix.fill(6, { |i|
        BPF.ar(PinkNoise.ar(1), (f * (i + 1)).clip(20, 20000), 0.02) * h[i]
    }) * breathGain;
    var sig = ((tone * (1 - v)) + (breath * v)) * Lag.kr(amp, 1.0) * (1 + (st * strikeGain));
    sig = sig * Lag.kr(lvl, 0.3) * env;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [f, Amplitude.kr(sig, 0.05, 0.3)], 0);   // /svk_readout layer 0 in T-C
    Out.ar(out, Pan2.ar(sig, 0));
    Out.ar(space, Pan2.ar(sig * send * (1 + st), 0));     // a strike rings harder into the space
}),

// --------------------------------------------------------------------- BODY --
// The ground's energy: a modal body with four mode groups at the band centres × 250 (79 / 559 / 2165 /
// 6495 Hz), three partials a few percent apart per group (one DynKlank per partial position, placed L/C/R).
// Excitation: continuous pink noise plus sparse Dust (re_wilding's bow). \amps (12) carries the cooked,
// equal-excitation-normalised balance; \amp the absolute loudness. Silent wherever there is no waveform.
SynthDef(\svkBody, { |out = 0, gate = 1, amp = 0, lvl = 0, exAmp = 0.02, dust = 2.5, dustAmp = 0.6, space = 0, send = 0|
    var freqs = NamedControl.kr(\freqs, 100 ! 12);
    var amps = NamedControl.kr(\amps, 0 ! 12).lag(1.5);
    var rings = NamedControl.kr(\rings, 1 ! 12);
    var env = EnvGen.kr(Env.asr(2, 1, 3), gate, doneAction: 2);
    var ex = (PinkNoise.ar(1) + (Dust.ar(dust) * dustAmp)) * exAmp;
    var parts = 3.collect { |p|
        var ix = (p * 4) + [0, 1, 2, 3];
        DynKlank.ar(`[freqs[ix], amps[ix], rings[ix]], ex)
    };
    var sig = Pan2.ar(parts[0], -0.35) + Pan2.ar(parts[1], 0) + Pan2.ar(parts[2], 0.35);
    sig = LeakDC.ar(sig) * Lag.kr(amp, 1.0) * Lag.kr(lvl, 0.3) * env;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [-1, Amplitude.kr(sig.sum * 0.5, 0.05, 0.3)], 1);   // hz: from the cook
    Out.ar(out, sig);
    Out.ar(space, sig * send);                            // the four mode groups excite the shared space (§4.7)
}),

// -------------------------------------------------------------------- SWARM --
// The catalogue's claim as a texture: a pulse train at the TRUE rate × speed (no remap). Below ~20 Hz it is
// rhythm, 20–800 Hz pitch; above it a noise band centred on the rate (capped at 8 kHz) takes over, because a
// train that fast is no longer heard as one. Pulsaret: a Hann-windowed sine at the carrier ff (depth → register)
// plus re_wilding's inharmonic 2.76 "wood" partial, 6–30 ms (b-value → darkness and length), phase reset at
// every pulse (pulsar synthesis: the rate is the fundamental, ff the formant). Above pulseRef the train keeps the
// power it has at pulseRef (rate × pulsaret length is compensated), so a pitch does not get louder or softer by rising.
SynthDef(\svkSwarm, { |out = 0, gate = 1, rate = 1, ff = 1200, dark = 0.5, dur = 0.012, wood = 2.76,
                       amp = 0, lvl = 0, nLo = 700, nHi = 1000, nCap = 8000, nRq = 0.6, nCal = 1, pulseRef = 20,
                       space = 0, send = 0|
    var env = EnvGen.kr(Env.asr(1, 1, 2), gate, doneAction: 2);
    var r = Lag.kr(rate, 0.05).max(0.01);
    var trig = Impulse.ar(r.min(nHi * 1.5));
    var d = Lag.kr(dur, 0.1).min(0.95 / r);
    var ph = Sweep.ar(trig, d.reciprocal);
    var win = (ph < 1) * (pi * ph.clip(0, 1)).sin.squared;
    var t = Sweep.ar(trig, 1);
    var ffl = Lag.kr(ff, 0.1);
    var hi = 1 - Lag.kr(dark, 0.3);
    var puls = ((2pi * ffl * t).sin + ((0.15 + (0.45 * hi)) * (2pi * ffl * wood * t).sin)) * win;
    var pulsF = LPF.ar(puls, (ffl * (1.5 + (hi * 6))).clip(300, 16000));
    var comp = ((pulseRef * Lag.kr(dur, 0.1)) / (r * d)).sqrt.min(1);   // power = rate × pulsaret length
    var x = ((r.log2 - nLo.log2) / (nHi.log2 - nLo.log2)).clip(0, 1);
    var band = BPF.ar(WhiteNoise.ar(1), r.clip(nLo, nCap), nRq) * nCal;
    var sig = (pulsF * comp * (1 - x).sqrt) + (band * x.sqrt);   // equal-power crossfade (uncorrelated)
    sig = LeakDC.ar(sig) * Lag.kr(amp, 0.3) * Lag.kr(lvl, 0.3) * env;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [r.min(nCap), Amplitude.kr(sig, 0.05, 0.3)], 2);   // the rate (or band centre)
    Out.ar(out, Pan2.ar(sig, 0));
    Out.ar(space, Pan2.ar(sig * send, 0));
}),

// one catalogue event at the day level: a single pulsaret, the texture's grain (ff from the event's depth)
SynthDef(\svkGrain, { |out = 0, amp = 0.2, pan = 0, ff = 1200, dur = 0.012, wood = 2.76, space = 0, send = 0,
                       dg = 1, lpf = 20000|
    var env = EnvGen.ar(Env.sine(dur), doneAction: 2);
    var sig = LPF.ar((SinOsc.ar(ff) + (0.45 * SinOsc.ar(ff * wood))) * env, lpf) * dg;  // v0.14 placed (the cook)
    Out.ar(out, Pan2.ar(sig * amp, pan));
    Out.ar(space, Pan2.ar(sig * amp * send, pan));
}),

// one catalogue event at the hours/minutes levels: a dry 4-ms tick over the Ground — the claim, so that you can
// hear whether the evidence agrees (congruent) or not (divergent)
SynthDef(\svkTick, { |out = 0, amp = 0.1, pan = 0, ff = 3600, dur = 0.004, wood = 2.76, space = 0, send = 0,
                      dg = 1, lpf = 20000|
    var env = EnvGen.ar(Env.perc(0.0002, dur, 1, -6), doneAction: 2);
    var sig = LPF.ar((SinOsc.ar(ff) + (0.5 * SinOsc.ar(ff * wood))) * env, lpf) * dg;   // v0.14 placed (the cook)
    Out.ar(out, Pan2.ar(sig * amp, pan));
    Out.ar(space, Pan2.ar(sig * amp * send, pan));
}),

// an M ≥ 2 event at the cycle/day levels: a bell at fc × 250 (its Brune corner frequency, cooked). darkquake's
// \bellRing partials, stereo, no ring gains (that is the spatial stage's job). A partial that would land above
// 0.45 × the sample rate is dropped, never aliased: an M2 bell (5.7 kHz) keeps only its first three.
SynthDef(\svkBell, { |out = 0, freq = 570, amp = 0.2, decay = 3, pan = 0, space = 0, send = 0, dg = 1, lpf = 20000|
    var ratios = [1.0, 2.756, 5.404, 8.933, 13.34, 18.64];
    var dscale = [1.0, 0.85, 0.65, 0.50, 0.35, 0.22];
    var sig = Mix.fill(6, { |i|
        var f = freq * ratios[i];
        SinOsc.ar(f) * EnvGen.ar(Env.perc(0.004, decay * dscale[i], 1, -4)) * (0.9 / (i + 1))
            * (f < (SampleRate.ir * 0.45))
    });
    sig = LPF.ar(sig, lpf) * dg * Line.kr(1, 1, decay + 0.1, doneAction: 2);           // v0.14 placed (the cook)
    Out.ar(out, Pan2.ar(sig * amp, pan));
    Out.ar(space, Pan2.ar(sig * amp * send, pan));     // bells ring into each other through the shared space
}),

// ------------------------------------------------------------------- GROUND --
// The evidence: audification of one seismic component from its ring buffer (CONTRACT §5). The reader runs at
// `rate` SOURCE frames per second (100 × ground_speed, cooked) over a sclang-allocated ring of ringFrames;
// the page fills it ahead (want/fill, parse file). Above one source frame per output sample (≥ 480× at 48 kHz)
// a 16-tap windowed-sinc lowpass replaces the cubic read, so seismic energy above the audio Nyquist is removed
// rather than folded back as frequencies the ground never made. Then only: a gentle 20 Hz highpass (tilt
// detunes its corner by up to ±1 octave, slowly) and a soft limiter. No other processing. Reports its read
// position 20× a second (SendReply '/svk_gpos', replyID = chan) for the playhead and the want/fill protocol.
// Ring samples are counts / the record's peak |x| for that channel (CONTRACT v0.7 §5.1 d).
SynthDef(\svkGround, { |out = 0, buf = 0, rate = 25000, amp = 0.7, lvl = 0, gate = 1,
                       hpHz = 20, tiltOct = 0, limit = 0.8, chan = 0, ringFrames = 262144|
    var env = EnvGen.kr(Env.asr(0.02, 1, 0.08), gate, doneAction: 2);
    var r = Lag.kr(rate, 0.05) / SampleRate.ir;
    var pos = Phasor.ar(0, r, 0, ringFrames);
    var cubic = BufRd.ar(1, buf, pos, 1, 4);
    var fc = 0.45 / r.max(1);
    var base = pos.floor;
    var frac = pos - base;
    var acc = 0, wsum = 0, raw, sig;
    // the FIR is accumulated tap by tap (not collected then summed) so the graph needs few wire buffers
    (-7 .. 8).do { |j|
        var d = frac - j;
        var x = 2 * fc * d;
        var w = Select.ar(x.abs < 1e-6, [(pi * x).sin / (pi * x), DC.ar(1)]) * (0.5 * (1 + (pi * d / 8.5).cos));
        acc = acc + (w * BufRd.ar(1, buf, (base + j).wrap(0, ringFrames), 1, 1));
        wsum = wsum + w;
    };
    raw = Select.ar(r > 1, [cubic, acc / wsum]);
    sig = Select.ar(CheckBadValues.ar(raw, 0, 0) > 0, [raw, DC.ar(0)]);   // a NaN never reaches a filter
    SendReply.kr(Impulse.kr(20), '/svk_gpos', A2K.kr(pos), chan);
    sig = HPF.ar(sig, hpHz * (2 ** Lag.kr(tiltOct, 4)));
    sig = (sig * amp / limit).tanh * limit;
    sig = sig * Lag.kr(lvl, 0.3) * env;
    // the readout: the audified signal's mean frequency (zero crossings, smoothed) and level; replyID 3, + chan
    SendReply.kr(Impulse.kr(4), '/svk_ro', [Lag.kr(A2K.kr(ZeroCrossing.ar(sig)), 0.5), Amplitude.kr(sig, 0.05, 0.3),
        chan], 3);
    Out.ar(out, sig);    // mono, to this component's channel of the Ground bus: \svkGroundRot places Z/N/E (v0.10)
}),

// ---------------------------------------------------------------- GROUND ROT --
// The 3-C motion as spatial movement (v0.10, DESIGN §4.7; FINDINGS F4). Reads the Ground bus [Z, N, E] (each already
// at its level) and rotates the horizontal pair by the polarization azimuth: r = N cos θ + E sin θ (motion along θ),
// t = E cos θ − N sin θ (across it). θ is smoothed on the doubled angle (axial data, 0–180°). r stands at the stage
// position of θ (listener facing north: east = right), focused by R; t goes to the opposite side and mostly to
// the space, so a locked tremor stands in one place while a scattered swarm diffuses. Z sits in the centre, a
// little deeper in the space. Tilt adds a slow sub-rumble (felt more than heard). The evidence itself is untouched:
// only where it is placed changes.
SynthDef(\svkGroundRot, { |in = 0, out = 0, space = 0, az = 0, polR = 0, lagT = 0.3, sendZ = 0.25, sendH = 0.12,
                           sendT = 0.5, tilt = 0, tiltAmp = 0.05, lvl = 0, gpan = 0, gdg = 1, glpf = 20000|
    var zne = In.ar(in, 3);
    var a2 = az.degrad * 2;
    var th = atan2(Lag.kr(a2.sin, lagT), Lag.kr(a2.cos, lagT)) * 0.5;
    var r = (zne[1] * th.cos) + (zne[2] * th.sin);
    var tr = (zne[2] * th.cos) - (zne[1] * th.sin);
    var pr = th.sin * 0.9 * Lag.kr(polR.clip(0, 1), 1.5);
    var tl = Lag.kr(tilt.abs.clip(0, 1), 3);
    var sub = (SinOsc.ar(24 * (1 + LFNoise2.kr(0.13, 0.08))) + (LPF.ar(BrownNoise.ar(1), 45) * 2))
            * tl * tiltAmp * (0.6 + (0.4 * SinOsc.kr(0.07))) * Lag.kr(lvl, 0.3);
    var dry = Pan2.ar(zne[0], 0) + Pan2.ar(r, pr) + Pan2.ar(tr * 0.5, pr.neg) + (sub ! 2);
    var wet = Pan2.ar(zne[0] * sendZ, 0) + Pan2.ar(r * sendH, pr) + Pan2.ar(tr * sendT, pr.neg);
    // v0.14 the polarization image placed at the station (the listener's view): distance gain and low-pass, the
    // image's middle panned to the station's azimuth (equal power), its width (the polarization) kept
    var gp = Lag.kr(gpan, 0.5), gg = Lag.kr(gdg, 0.5), gl = Lag.kr(glpf, 0.5);
    dry = LPF.ar(dry, gl) * gg;
    dry = Pan2.ar((dry[0] + dry[1]) * 0.5 * 2.sqrt, gp) + ([1, -1] * ((dry[0] - dry[1]) * 0.5));
    wet = LPF.ar(wet, gl) * gg;
    Out.ar(out, dry);
    Out.ar(space, wet);
}),

// --------------------------------------------------------------------- ARRAY --
// The sensors (v0.10, DESIGN §4.7): 9 deep voices, one per station-component (SKSH, SENG, THOB × N, E, U; ≈ 37–147 Hz),
// each a slowly bowed resonator (noise through four inharmonic plate modes, long ring) whose excitation \ex follows
// that component's speed. \fq (pitch, with U's drift) and \br (brightness) are cooked per voice; \pan, \send and
// \veil per station (E motion moves a station sideways, N motion nearer/farther; gap 2 = veiled: the same pitches as
// breath). Each voice shimmers at its own slow rate (poly-temporal, never one LFO). Readout: the loudest voice's pitch.
SynthDef(\svkArray, { |out = 0, space = 0, gate = 1, amp = 0, lvl = 0, ring = 4.5, breathGain = 6|
    var env = EnvGen.kr(Env.asr(2, 1, 4), gate, doneAction: 2);
    var ex = NamedControl.kr(\ex, 0 ! 9).lag(0.4);
    var fq = NamedControl.kr(\fq, 50 ! 9).lag(0.8);
    var br = NamedControl.kr(\br, 0.5 ! 9).lag(0.6);
    var pans = NamedControl.kr(\pan, [-0.8, 0.8, 0]).lag(1.5);
    var sends = NamedControl.kr(\send, 0.4 ! 3).lag(1);
    var veil = NamedControl.kr(\veil, 0 ! 3).lag(1.5);
    var vox = 9.collect { |i|
        var shimmer = 1 + LFNoise2.kr(0.03 + (i * 0.017), 0.3);
        var e = LPF.ar(PinkNoise.ar(1), (fq[i] * (2 + (br[i] * 12))).clip(40, 6000)) * ex[i] * shimmer;
        var res = DynKlank.ar(`[[1, 2.013, 3.031, 4.087], [1, 0.45, 0.25, 0.12], [1, 0.8, 0.6, 0.4]], e * 0.004,
            fq[i], 0, ring);
        var breath = (BPF.ar(PinkNoise.ar(1), fq[i], 0.03) + BPF.ar(PinkNoise.ar(1), fq[i] * 2, 0.03))
            * ex[i] * shimmer * breathGain;
        (res * (1 - veil[i.div(3)])) + (breath * veil[i.div(3)])
    };
    var st = 3.collect { |s| vox[s * 3] + vox[(s * 3) + 1] + vox[(s * 3) + 2] };
    var g = amp * Lag.kr(lvl, 0.3) * env;
    var dry = (Pan2.ar(st[0], pans[0]) + Pan2.ar(st[1], pans[1]) + Pan2.ar(st[2], pans[2])) * g;
    var wet = (Pan2.ar(st[0] * sends[0], pans[0]) + Pan2.ar(st[1] * sends[1], pans[1])
        + Pan2.ar(st[2] * sends[2], pans[2])) * g;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [-1, Amplitude.kr(dry.sum * 0.5, 0.05, 0.3)], 4);   // hz: from the cook
    Out.ar(out, dry);
    Out.ar(space, wet);
}),

// -------------------------------------------------------------------- RUMBLE --
// The rumble of the earth (v0.10, DESIGN §4.7; inference: the catalogue's energy release). Brown noise and
// low-passed bursts (density from n_abs) through a low modal body at ≈ 27–82 Hz with long decays; level from
// logE_abs on a dB scale (cooked). Two slightly different bodies L/R for width. Readout: unpitched (hz NaN).
SynthDef(\svkRumble, { |out = 0, space = 0, gate = 1, amp = 0, lvl = 0, dens = 1, send = 0.3|
    var env = EnvGen.kr(Env.asr(3, 1, 6), gate, doneAction: 2);
    var modes = NamedControl.kr(\modes, [27.5, 34.6, 41.2, 51.9, 65.4, 82.4]);
    var rings = NamedControl.kr(\rings, [6, 5.5, 5, 4.5, 4, 3.5]);
    var d = Lag.kr(dens, 1);
    var ex = 2.collect { |k|
        (LPF.ar(BrownNoise.ar(1), 140) * 0.6)
        + (LPF.ar(Decay2.ar(Dust.ar(d), 0.01, 0.4) * WhiteNoise.ar(1), 200) * 3)
    };
    var body = 2.collect { |k|
        DynKlank.ar(`[modes * (1 + (k * 0.011)), [1, 0.85, 0.7, 0.55, 0.42, 0.3], rings], ex[k] * 0.003)
    };
    var sig = LPF.ar(body, 160) * Lag.kr(amp, 1.5) * Lag.kr(lvl, 0.3) * env;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [-1, Amplitude.kr(sig.sum * 0.5, 0.05, 0.3)], 5);
    Out.ar(out, sig);
    Out.ar(space, sig * send);
}),

// --------------------------------------------------------------------- SPACE --
// One deep, dark shared space (v0.10, DESIGN §4.7; rule A3: core UGens only, no JPverb/sc3-plugins). An 8-line
// feedback-delay network: delay lines of 57–168 ms (slowly modulated, never two alike), a Householder matrix, and in
// each loop a 30 Hz highpass and a lowpass at `damp` (dark), with the gain for a decay of t60 s. The stereo send bus
// feeds the lines with alternating signs; the wet sum goes onto the mix bus just before \svkCore (A5: the spatial
// stage stays separate).
SynthDef(\svkSpace, { |in = 0, out = 0, t60 = 7, damp = 2800, wet = 0.5, pre = 0.02|
    var n = 8;
    var dt = [0.0437, 0.0531, 0.0613, 0.0733, 0.0839, 0.0967, 0.1103, 0.1291] * 1.3;
    var x = DelayN.ar(In.ar(in, 2), 0.1, pre);
    var fb = LocalIn.ar(n);
    var mixd = fb - ((2 / n) * fb.sum);
    var lines = n.collect { |i|
        var src = mixd[i] + (x[i % 2] * (if ((i div: 2).even) { 1 } { -1 }));
        var d = DelayC.ar(src, 0.25, (dt[i] - ControlDur.ir) + LFNoise2.kr(0.07 + (i * 0.011), 0.0008));
        LPF.ar(HPF.ar(d, 30), damp) * (10 ** ((-3 * dt[i]) / t60))
    };
    var left = lines[0] + lines[2] + lines[4] + lines[6];
    var right = lines[1] + lines[3] + lines[5] + lines[7];
    LocalOut.ar(lines);
    Out.ar(out, [left, right] * wet * 0.35);
}),

// ------------------------------------------------------------- BODY v2 (v0.11) --
// The volcano's spectroscopic body (DESIGN §4.0, R5; CONTRACT v0.11 §9): dark_re_wilding's \rwContinuous, rebuilt on
// this data. A bow — pink noise + Dust, never struck — drives 36 modes from W1's spectroscopy (freqs, amps, rings:
// the room's identity, set once at spawn), each mode's \gains the point's own band (gliding over `glide` s, Lag 60 dB),
// pinned (`pin`) so balance moves and level holds; then ONE room comb at the room's amp²-weighted mean frequency
// (combDelay = 1/comb_hz, set once, NEVER swept) whose decay is the pressure (the ground pressing into its own room).
// out = 0.35·body + 0.85·room. Separate voices (the Swarm's clave, bells, the strike) reach the comb through the
// `room` bus at their own send (0.25), as re_wilding's clave does. The 36 modes sound in three blocks of 12 (per
// station for deformation rooms, per component for regime rooms) placed by \pans, the comb in the centre. A new room
// is a NEW instance: the parser crossfades `fade` s from the old one (the comb is never retuned in place). Two veils
// (T-C's character: the same pitches as breath, never silence, never darker), level-matched by measurement:
//   veil    (/svk_body2 gap 2: the GNSS is interpolated) — the WHOLE body as breath: rings × veilRing, the comb eased
//   bowVeil (/svk_bow gap 2: the inflow is unknown, v0.11.8) — only the excitation: the bow loses its Dust grain and
//           the modes ring broader (rings × bowVeilRing); the room comb is untouched
// Readout: replyID 6 (v0.11 layer 6 = body; hz = the room's comb_hz).
// re_wilding's room is the comb alone: `fdnSend` (into the retired \svkSpace) is 0 by default, > 0 only for an A/B.
SynthDef(\svkBody2, { |out = 0, room = 0, gate = 1, amp = 0.58, lvl = 0, exAmp = 0.03, dust = 2.5, dustAmp = 1.5,
                       combDelay = 0.01, combDecay = 0.325, glide = 4, fade = 4, pin = 1, veil = 0, fdn = 0, fdnSend = 0,
                       veilRing = 0.12, veilComp = 1.95, veilComb = 0.6, bowVeil = 0, bowVeilRing = 0.4, bowVeilComp = 1.26|
    var env = EnvGen.kr(Env.asr(fade, 1, fade, \sin), gate, doneAction: 2);
    var freqs = NamedControl.kr(\freqs, 100 ! 36);
    var amps = NamedControl.kr(\amps, 0 ! 36);
    var rings = NamedControl.kr(\rings, 1 ! 36);
    var gains = NamedControl.kr(\gains, 1 ! 36).lag(glide);
    var pans = NamedControl.kr(\pans, [-0.5, 0.5, 0]);
    var v = Lag.kr(veil, 1.5);
    var bv = Lag.kr(bowVeil, 1.5);
    var bow = (PinkNoise.ar(1) + (Dust.ar(Lag.kr(dust, 1)) * dustAmp * (1 - bv))) * Lag.kr(exAmp, 1);
    var p = Lag.kr(pin, glide) / 36.sqrt;
    var blocks = 3.collect { |b|
        var ix = (b * 12) + (0 .. 11);
        DynKlank.ar(`[freqs[ix], gains[ix] * amps[ix], rings[ix]], bow, 1, 0,
            (1 - ((1 - veilRing) * v)) * (1 - ((1 - bowVeilRing) * bv)))
            * p * (1 + ((veilComp - 1) * v)) * (1 + ((bowVeilComp - 1) * bv))
    };
    var body = blocks.sum;
    var comb = CombC.ar(body + In.ar(room, 2).sum, 0.05, combDelay, Lag.kr(combDecay, glide) * (1 - (veilComb * v)));
    var sig = ((Pan2.ar(blocks[0], pans[0]) + Pan2.ar(blocks[1], pans[1]) + Pan2.ar(blocks[2], pans[2])) * 0.35)
            + Pan2.ar(comb * 0.85, 0);
    sig = LeakDC.ar(sig) * amp * Lag.kr(lvl, 0.3) * env;
    SendReply.kr(Impulse.kr(4), '/svk_ro', [-1, Amplitude.kr(sig.sum * 0.5, 0.05, 0.3)], 6);   // readout layer 6 (body)
    Out.ar(out, sig);
    Out.ar(fdn, sig * Lag.kr(fdnSend, 0.5));     // the A/B only: an optional low send into \svkSpace (default 0)
}),

// the eruption strike (v0.11): its own deep voice when the play cursor crosses an eruption — the body itself is
// never struck (re_wilding's rule). A low struck tone at the room's lowest mode (raised by octaves to ≥ 30 Hz),
// falling a little as it yields, with a short crack; size (the fall's dU on its range: the volume that left the
// chamber) sets its weight — level and ring.
// v0.14 presence: its own upper harmonics (× 6 … 21) ringing fast and a 2–5 kHz click, so every strike stands out of
// the room on headphones AND laptop speakers (measured above a 200 Hz high-pass: dev/render/out_v14).
// veil = 1 (kind 1, a HIDDEN eruption: known date, no GNSS fall; v0.13 lifted, Miguel): the same strike as BREATH —
// narrow noise bands at the tone's own partials, low and upper, and a soft puff for its onset — noticeable, ≈ 5 LU
// under the unhidden strike of the same size (veilGain, veilUpper, measured: dev/render/out_v14).
// v0.13 the fountain (how high the lava was thrown, 0–1 on the fountains' range): a crackling SPRAY over the tone
// (15-ms noise fragments) — denser, brighter and longer with height — plus brighter upper partials, a little more
// level and ring (the cook). The spray is never veiled: an observed fountain is seen even when the GNSS hides the fall.
// echo = 1 (a SIMULATED fountain, model output; Miguel: "quick bursting echo … 5% dry, 95% wet … more of a dream
// sound"): the whole strike goes through the echo — six quick taps on its attack, each gap shorter (70 → 25 ms), and a
// flutter echo carrying the rest (two combs, 71/83 ms, slowly drifting, echoDecay s: it ends with the strike, no
// reverb tail, no FDN) — at echoWet; echoComp holds the loudness of the same strike unmarked (measured, out_v13).
SynthDef(\svkStrike, { |out = 0, room = 0, freq = 40, amp = 0.3, decay = 6, size = 0.5, send = 0.25, veil = 0,
                        veilGain = 1, veilUpper = 1, upperAmp = 0.25, clickAmp = 0.15, fountain = 0, sprayAmp = 0.5,
                        echo = 0, echoWet = 0.95, echoDecay = 1, echoComp = 1, pan = 0, dg = 1, lpf = 20000|
    var rid = RandID.ir(1);               // its own noise stream: a strike never changes the room's (renders compare)
    var env = EnvGen.ar(Env.perc(0.008, decay, 1, -4), doneAction: 2);   // decay ≥ 3 s outlasts the spray and taps
    var drop = EnvGen.kr(Env([1.25, 1], [0.6], -4));
    var pg = [1, 0.35 + (0.25 * fountain), 0.12 + (0.18 * fountain), 0.1 * fountain], pr = [1, 2.01, 3.03, 4.97];
    var tone = (SinOsc.ar(freq * drop) + (SinOsc.ar(freq * 2.01 * drop) * pg[1])
        + (SinOsc.ar(freq * 3.03) * pg[2]) + (SinOsc.ar(freq * 4.97) * pg[3])) * env;
    // v0.14 presence (Miguel: "strikes should be noticeable", laptops too): the struck tone's own UPPER harmonics
    // (× 6 … 21, 230–820 Hz in the sequence room; the ear hears the low pitch from them) ringing fast, and a click
    var ur = [6.02, 8.03, 11.05, 15.08, 21.12], ug = [1, 0.8, 0.6, 0.45, 0.3], ud = [1.4, 1.0, 0.7, 0.45, 0.3];
    var rs = 0.6 + (0.8 * size);
    var upper = ur.collect { |r, i| SinOsc.ar(freq * r * drop) * EnvGen.ar(Env.perc(0.003, ud[i] * rs, ug[i], -4)) }.sum
        * upperAmp;
    var crack = (LPF.ar(WhiteNoise.ar(1), 300 + (size * 900)) * EnvGen.ar(Env.perc(0.002, 0.3)) * (0.3 + (0.5 * size)))
        + (LPF.ar(HPF.ar(WhiteNoise.ar(1), 1800), 5000) * EnvGen.ar(Env.perc(0.0005, 0.008)) * clickAmp * (0.5 + (0.5 * size)));
    var pink = PinkNoise.ar(1);
    var breath = ((pr.collect { |r, i| BPF.ar(pink, freq * r * if (i < 2) { drop } { 1 }, 0.05) * pg[i] }.sum * env)
        + (LPF.ar(pink, 400 + (size * 400)) * EnvGen.ar(Env.perc(0.02, 0.35)) * (0.1 + (0.15 * size)))) * veilGain
        + (ur.collect { |r, i| BPF.ar(pink, freq * r * drop, 0.03) * EnvGen.ar(Env.perc(0.02, ud[i] * rs * 1.3, ug[i], -4)) }
            .sum * upperAmp * veilUpper);
    var sprayEnv = EnvGen.ar(Env.perc(0.01, 0.4 + (1.6 * fountain), 1, -3));
    var grains = Decay2.ar(Dust.ar(30 + (220 * fountain)), 0.001, 0.015) * WhiteNoise.ar(1);   // 15-ms fragments
    var spray = BPF.ar(grains, 700 + (2800 * fountain), 0.8) * sprayEnv * sprayAmp * fountain.sqrt;
    var dry = (((tone + upper + crack) * (1 - veil)) + (breath * veil)) + spray;
    var attEnv = EnvGen.ar(Env.perc(0.005, 0.2));
    var gaps = [0.07, 0.055, 0.045, 0.035, 0.03, 0.025], tapGains = [0.6, 0.48, 0.38, 0.3, 0.23, 0.17];
    var taps = Array.newClear(6), x = dry * attEnv, wet;
    gaps.do { |g, i| x = DelayN.ar(x, 0.08, g); taps[i] = Pan2.ar(x * tapGains[i], [-0.25, 0.25].wrapAt(i)) };
    wet = taps.sum + [CombC.ar(dry, 0.1, 0.071 + (0.003 * LFNoise1.kr(0.5)), echoDecay),
                      CombC.ar(dry, 0.1, 0.083 + (0.003 * LFNoise1.kr(0.6)), echoDecay)];
    wet = (Pan2.ar(dry, 0) * (1 - (echoWet * echo))) + (wet * (echoWet * echo));
    wet = LPF.ar(wet * (1 + ((echoComp - 1) * echo)), lpf) * dg;
    // v0.14 placed at the fissure: the image's middle panned (equal power), its width kept
    wet = Pan2.ar((wet[0] + wet[1]) * 0.5 * 2.sqrt, pan) + ([1, -1] * ((wet[0] - wet[1]) * 0.5));
    Out.ar(out, wet * amp);
    Out.ar(room, wet * (amp * send));
}),

// ----------------------------------------------------------------- the CORE --
// The stereo core (A5): the mix bus × the master (a control bus, /dark_master) → limiter at −1 dBFS.
SynthDef(\svkCore, { |in = 0, out = 0, masBus = 0, limit = 0.89|
    var sig = In.ar(in, 2) * In.kr(masBus, 1).lag(0.05);
    Out.ar(out, Limiter.ar(LeakDC.ar(sig), limit, 0.01));
}),

// The spatial stage, separate (A5): stereo pass-through to the hardware. A binaural / ring / ambisonic stage
// for the workshop replaces THIS def only; the voices and the core do not change.
SynthDef(\svkSpatialStereo, { |in = 0, out = 0|
    Out.ar(out, In.ar(in, 2));
})
]
);
~svkDefs.do(_.add);
s.sync;
("[web] " ++ ~svkDefs.size ++ " SynthDefs added").postln;
~webSynthsReady = true;   // WEB BUILD: engine.js waits for this, not for a post line
};
