(
OSCdef(\darkSonification).free; OSCdef(\darkLegend).free; OSCdef(\darkTracked).free;
OSCdef(\darkFrame).free; OSCdef(\darkRecord).free; OSCdef(\darkDynamics).free; OSCdef(\darkMaster).free;
OSCdef(\darkMix).free; OSCdef(\darkClock).free;

~dsCount = 0; ~lastCluster = -1; ~lastLandmark = 0; ~legendActive = false;
~lastUpwell = 0; ~lastFish = 0;                       // chime debounce backstops (the page is the primary gate)
~lastLive = nil;                                      // the last /dark_frame = the date shown; a legend release returns to it
~legendDriver = nil;                                  // the held chip's driver: the legend listens to ITS layer only
~masterVol = 1.0; ~masterMute = true;                 // boots SILENT (♪ off); vol 1.0 = the level the mix was balanced at
~mix = (drone: 1, bed: 1, rain: 1, bell: 1, chimes: 1, trace: 1, clock: 0.4);   // SOUND-tab faders (the bridge owns and echoes them);
                                                      //   the clock starts at 0.4 (Miguel 2026-10-02)
~bedInterval  = 1.5;                                  // the bed's second oscillator sits a fifth above its first
~bedLevel     = 0.40;                                 // the bed's design level (2026-09-27, Miguel: "I dont hear the bed").
                                                      //   Was 0.015: measured alone it sat 37–43 LU under the drone, so the
                                                      //   water mass was inaudible unless the drone fader went to 0.04. At
                                                      //   0.40 (+28.5 dB) it sits ~9–14 LU under the drone. The faders only
                                                      //   turn a layer DOWN, so this is where the bed's ceiling lives.
~bellBackstop = 0.08;                                 // s. The bell debounces in FRAMES; this only guards scrub bursts.
// THE CLOCK (2026-10-02; the voice and why: dark_ocean_synths.scd \oceanTick, dev/clock_beat/README.md)
~clockTickAmp  = 0.24;                                // the tick, FIXED (0.16 stood only ~5 dB clear in warm months)
~clockAccent   = 1.4;                                 // January / the 1st of a month: ×1.4 louder AND ×2.2 longer ring (77 ms),
~clockAccentRing = 2.2;                               //   as a harder-struck wood. re_wilding's ×1.9 hit the limiter (the design
                                                      //   peaks ~0.86): +2.7 dB of energy in the mix; this: +4.2 dB, peak +4.0
                                                      //   (dev/clock_beat/verify_layer.py, 2026-10-02)
~clockTrainAmp = 0.6;                                 // the division's pulses, relative to the tick: the date stays the loudest wood
~clockPartsMax = 8;                                   // the most parts a date is divided into (1 = the tick alone)
~clockStep     = 0.65;                                // s, the legend's audition: one date at 1×
~clockTrain    = nil;                                 // the division now sounding (a newer date cuts it)
~clockAudition = nil;                                 // the legend's clock routine

// ── DEBUG heartbeat: every 2 s, what OSC arrived + the gate state. Set ~dbg = false to silence. ──
~dbg = true; ~rxFrame = 0; ~rxDyn = 0; ~rxSon = 0; ~rxLegend = 0;
~dbgRoutine.notNil.if { ~dbgRoutine.stop };
~dbgRoutine = Routine({ loop { 2.wait;
    ~dbg.if { "[DBG] /2s  frame:%  dyn:%  son:%  legend:%  | legendActive:%".format(
        ~rxFrame, ~rxDyn, ~rxSon, ~rxLegend, ~legendActive).postln;
        ~rxFrame = 0; ~rxDyn = 0; ~rxSon = 0; ~rxLegend = 0; };
} }).play(AppClock);

// ─── Start the sustained voices if not already running ─────────────────────
if (~synths[\undercurrent].isNil and: { ~synths[\drops].isNil }) {
    "  [parser] Starting default ocean synths...".postln;
    [\undercurrent, \midcurrent1, \midcurrent2].do { |n| ~play.(n) };
    // the rain has its OWN bus: \transProc gives it the salinity space, and it never ducks the drone.
    //   (A later \out in the arg list wins on /s_new.)
    ~play.(\drops, [\out, ~rainBus.index]);
} { "  [parser] Reusing existing ocean synths".postln };

// ─── Per-synth set helper (skip nil params, skip unsupported keys) ─────────
~setIfPresent = { |synth, synthName, keyValPairs|
    var supported, args;
    if (synth.notNil) {
        supported = ~synthParams[synthName] ? [];
        args = [];
        keyValPairs.pairsDo { |k, v|
            if (v.notNil and: { supported.includes(k) }) { args = args ++ [k, v] };
        };
        if (args.size > 0) { synth.set(*args) };
    };
};

// ═══ named mappings (each decision one line to reverse) ════════════════════
~penta = [1, 9/8, 5/4, 3/2, 5/3, 2, 9/4, 5/2, 3, 10/3];   // just-intonation degrees over ~1.7 octaves
~tempVoices = { |temp|
    var deg = (temp.clip(0, 1) * (~penta.size - 1)).round.asInteger;
    (   fund:    150 * ~penta[deg],       // 150–500 Hz — the LOW BODY (undercurrent)
        carrier: 330 * ~penta[deg],       // 330–1100 Hz — the AUDIBLE CARRIER (midcurrent1)
        bright:  0.20 + (temp * 0.7)  )   // warmer → a brighter carrier
};
~bedFreq  = { |cls| 200 * (2 ** ((cls / 3) * 2)) };   // Atlantic 200 · Iceland/Polar 317.5 · Arctic 504 Hz
~bellFreq = { |cls| 2 * ~bedFreq.(cls) };             // the bell names the ARRIVING mass: 400 · 635 · 1008 Hz (D7)

// ═══ master and mix (2026-09-27) ═══════════════════════════════════════════
//   Volume and mute are SEPARATE (they used to write the same gain, so moving the volume un-muted).
//   A held legend chip opens the master whatever ♪ says (Miguel D4: "play anyway").
~applyMaster = {
    var open = ~masterMute.not or: { ~legendActive };
    ~widen.notNil.if { ~widen.set(\mgain, ~masterVol * open.if(1, 0)) };
};
//   The faders multiply each layer's design level (\mixgain); they never overwrite it.
//   THE LEGEND LISTENS TO ONE LAYER (Miguel 09-27: "if the chip is affecting a specific layer, that is the
//   one we want to listen to"). While a chip is held, the layer(s) its driver plays sound at design level
//   (a layer you faded is still auditioned) and EVERY other layer is muted, the trace chord, the chimes
//   and the bell included. The water-mass chip plays the bed AND rings the bell.
~legendLayers = (
    temp:      [\drone],            // pitch: the undercurrent + the carrier
    anomaly:   [\drone],            // the tremolo on the drone
    salinity:  [\rain],             // space: the echo on the drops (the teaching rain)
    nutrients: [\rain],             // the rain itself
    cluster:   [\bed, \bell],       // water mass: the bed tone and the bell
    clock:     [\clock]             // the clock: its ticks and roll
);
~layerGain = { |k|                  // one rule for every layer: its fader, or (holding) 1 if it is the chip's layer, else 0
    ~legendActive.if({ (~legendLayers[~legendDriver] ? []).includes(k).if(1, 0) }, { ~mix[k] ? 1 })
};
~applyMix = {
    [\undercurrent, \midcurrent1].do { |n| ~synths[n].notNil.if { ~synths[n].set(\mixgain, ~layerGain.(\drone)) } };
    ~synths[\midcurrent2].notNil.if { ~synths[\midcurrent2].set(\mixgain, ~layerGain.(\bed)) };
    ~synths[\drops].notNil.if       { ~synths[\drops].set(\mixgain, ~layerGain.(\rain)) };
    ~synths[\trackedwash].notNil.if { ~synths[\trackedwash].set(\mixgain, ~layerGain.(\trace)) };
    ~clockGroup.notNil.if { ~clockGroup.set(\mixgain, ~layerGain.(\clock)) };
};
// ONE DATE ON THE CLOCK: a tick (accented or not), and the date divided into n equal parts (1 = the tick
//   alone). period = how long the date lasts on the page (s); formant = the wood's brightness (Hz).
//   A newer date cuts the division still sounding.
~clockDate = { |accent, n, period, formant = 1500|
    var parts = n.round.asInteger.clip(1, ~clockPartsMax), g = ~layerGain.(\clock);
    ~clockTrain.notNil.if { ~clockTrain.set(\gate, 0); ~clockTrain = nil };
    Synth(\oceanTick, [\out, ~clockBus.index, \formant, formant,
                        \amp, ~clockTickAmp * (accent > 0.5).if(~clockAccent, 1),
                        \decay, 0.035 * (accent > 0.5).if(~clockAccentRing, 1), \mixgain, g], ~clockGroup ? ~srcGroup);
    (parts > 1).if {
        ~clockTrain = Synth(\oceanTrain, [\out, ~clockBus.index, \n, parts, \period, period, \formant, formant,
                                          \amp, ~clockTickAmp * ~clockTrainAmp, \mixgain, g], ~clockGroup ? ~srcGroup);
        ~clockTrain.onFree { |node| (~clockTrain === node).if { ~clockTrain = nil } };
    };
};
~clockAuditionStop = {
    ~clockAudition.notNil.if { ~clockAudition.stop; ~clockAudition = nil };
    ~clockGroup.notNil.if { ~clockGroup.set(\gate, 0) };        // cut any division still sounding (ticks ring out)
    ~clockTrain = nil;
};
~ringBell = { |cls, amp = 0.32|                       // the CLEAN bell: straight to the master stage (~bellBus)
    Synth(\landmark, [\out, ~bellBus.index, \freq, ~bellFreq.(cls), \amp, amp, \pan, 0,
                      \mixgain, ~layerGain.(\bell)], ~bellGroup ? ~srcGroup);
    ~lastLandmark = SystemClock.seconds;
};

// ═══ ~applyOcean — the ONE render fn (playback, the legend, and the legacy brain path) ═══
//   `p` = a Dictionary of cooked driver values. Returns the water mass it saw (-1 = none).
~applyOcean = { |p|
    var cluster, isFirst, clusterChanged, fund, detune, interval, u1, u2;
    var densBase, densScale, dens, offset, fminBase, fmaxBase, fmin, fmax, now;

    cluster        = (p[\clustering] ? -1).asInteger;
    isFirst        = (~lastCluster < 0);
    clusterChanged = (cluster >= 0) and: { cluster != ~lastCluster };   // -1 = no identity: hold the bed, no bell

    // PITCH: the body + detune lean. `fund` is optional: nil holds the pitch.
    fund     = p[\freq_under_fundamental];
    detune   = p[\detune_under] ? 0;
    interval = p[\timbre_ratio_under] ? 1.5;
    u1       = fund !? { |f| f * (2 ** (detune / 12)) };
    u2       = u1  !? { |f| f * interval };
    ~setIfPresent.(~synths[\undercurrent], \undercurrent,
        [\freq1, u1, \freq2, u2, \rq, p[\rq_under], \amp, p[\amp_under], \pan, 0]);

    // THE CARRIER: the audible note, one step per date.
    ~setIfPresent.(~synths[\midcurrent1], \midcurrent1,
        [\freq1, p[\freq_midI], \freq2, p[\freq_midI] !? { |f| f * 1.5 },
         \rq, p[\bright_midI], \amp, p[\amp_midI], \pan, 0]);

    // ANOMALY → the whole-drone tremolo · SALINITY → a light drone reverb send (a sweetener).
    ~droneProc.notNil.if {
        p[\wet_drone]  !? { |w| ~droneProc.set(\wet, w) };
        p[\trem_drone] !? { |t| ~droneProc.set(\tremDepth, t) };
    };
    // SALINITY → SPACE on the transients (the rain and the chimes): the audible salinity cue.
    ~transProc.notNil.if { p[\wet_drone] !? { |w| ~transProc.set(\space, w) } };

    // BED: the water mass's pad tone, re-pitched when the dominant water mass changes. freq2 ALWAYS
    //   follows (a fifth): left at its default it beat against freq1 (the "drilling").
    //   \amp is omitted while a legend audition holds: level is ~legendDuck's job then.
    if (clusterChanged) {
        ~setIfPresent.(~synths[\midcurrent2], \midcurrent2,
            [\freq1, p[\freq_midII], \freq2, p[\freq_midII] !? { |f| f * ~bedInterval },
             \amp, ~legendActive.if(nil, { ~bedLevel }), \pan, 0, \mix, p[\mix_midII]]);
    };

    // RAIN: density + band + level.
    densBase = p[\dens_drops] ? 0.4;  densScale = p[\mood_dens_scale] ? 1.0;
    dens     = (densBase * densScale).clip(0.05, 4.0);
    offset   = p[\mood_freq_offset] ? 0;
    fminBase = p[\freqmin_drops] ? 1100;  fmaxBase = p[\freqmax_drops] ? 3800;
    fmin     = (fminBase + offset).clip(20, 8000);
    fmax     = (fmaxBase + offset).clip(fmin + 50, 12000);
    if (~legendActive) {                     // an audition sets ONLY what the cook wrote, so the duck survives
        ~setIfPresent.(~synths[\drops], \drops,
            [\dens, p[\dens_drops] !? { |d| d.clip(0.05, 4.0) }, \freqmin, p[\freqmin_drops],
             \freqmax, p[\freqmax_drops], \amp, p[\amp_drops]]);
    } {
        ~setIfPresent.(~synths[\drops], \drops,
            [\dens, dens, \freqmin, fmin, \freqmax, fmax, \amp, (p[\amp_drops] ? 0.13)]);
    };

    // THE WATER-MASS BELL: every real change of the dominant water mass rings (debounced in FRAMES,
    //   2026-09-27; the old 0.6 s wall-clock debounce dropped the April bells at 4×). Not while a
    //   legend chip is held (the chip rings its own), and not on the first date (nothing changed yet).
    now = SystemClock.seconds;
    if (clusterChanged and: { isFirst.not } and: { (now - ~lastLandmark) > ~bellBackstop } and: { ~legendActive.not }) {
        ~ringBell.(cluster);
    };
    // A held chip must not overwrite the live water-mass memory.
    ~legendActive.not.if { (cluster >= 0).if { ~lastCluster = cluster } };
    cluster;
};

// ═══ ~frameCook — the ONE cooking function (playback AND the legend, manual C5 §19) ═══
//   [temp, sal, nut, anom] in 0..1, already stretched by the page over the dates on screen (D3);
//   cmix = the water-mass fractions of the region on that date.
~frameCook = { |temp, sal, nut, anom, cmix|
    var p = Dictionary.new, dom, tv, top;
    tv = ~tempVoices.(temp);
    p[\freq_under_fundamental] = tv[\fund];
    p[\amp_under]    = 0.7;                                    // + cap 0.8 in \droneProc → limiter gain reduction ≈ 0
    p[\rq_under]     = 0.3 + (sal * 0.7);                      // a mild secondary undercurrent timbre
    p[\wet_drone]    = sal.clip(0, 1);                         // salinity: 0 fresh/close → 1 salty/spacious
    p[\detune_under] = (anom - 0.5) * 1.0;                     // a subtle sharp/flat lean
    p[\trem_drone]   = ((anom - 0.5).abs * 2).clip(0, 1);      // steady in the middle of the period → wavers at either end
    p[\freq_midI]    = tv[\carrier];
    p[\bright_midI]  = tv[\bright];
    p[\amp_midI]     = 0.22;                                   // the carrier: the audible lead
    p[\dens_drops]   = 0.4 + (nut * 1.6);                      // → 1.2 … 6.0 countable drops/s
    p[\amp_drops]    = 0.40 + (nut * 0.20);                    // 0.40 … 0.60 (2026-09-27, Miguel: "raise the rain's
                                                               //   lowest level"; was 0.15 … 0.55: in the poorest month
                                                               //   the rain measured ~40 LU under the drone). The count
                                                               //   (1.2 … 6 drops/s) now carries most of "richer".
    p[\freqmin_drops] = 1100;
    p[\freqmax_drops] = 3800;                                  // 1.1–3.8 kHz: where laptop speakers are efficient
    p[\mood_dens_scale] = 1;
    top = cmix.maxItem ? 0;
    dom = (top > 0).if({ cmix.maxIndex }, { -1 });             // no classified water → no identity
    p[\freq_midII]   = (dom >= 0).if({ ~bedFreq.(dom) }, { nil });
    p[\clustering]   = dom;
    p[\mix_midII]    = 0.7;                                    // the bed's design reverb (a water-mass audition damps it)
    p;
};

// ═══ /dark_sonification — the legacy .darkproj brain payload → ~applyOcean (dev only) ═══
OSCdef(\darkSonification, { |msg|
    var features, values, p, cluster;
    ~rxSon = ~rxSon + 1;
    if (~legendActive.not) {
        features = (1, 3 .. msg.size - 2).collect { |i| msg[i].asSymbol };
        values   = (2, 4 .. msg.size - 1).collect { |i| msg[i].asFloat };
        p = Dictionary.new; features.do { |f, i| p[f] = values[i] };
        cluster = ~applyOcean.(p);
        ~dsCount = ~dsCount + 1;
        if (~dsCount % 50 == 1) {
            "DS#%  cluster=%  fund=% Hz".format(
                ~dsCount, cluster, (p[\freq_under_fundamental] ? 0).round(0.1)).postln;
        };
    };
}, '/dark_sonification');

// ═══ /dark_frame — the TIMELINE: the region on the date shown ════════════════
//   [temp, sal, nut, anom, c0, c1, c2, c3]. Always REMEMBERED as the date shown; applied unless a
//   legend chip is held (then the release applies the newest one).
OSCdef(\darkFrame, { |msg|
    var cmix = [msg[5], msg[6], msg[7], msg[8]].collect(_.asFloat);
    ~rxFrame = ~rxFrame + 1;
    ~lastLive = [msg[1].asFloat, msg[2].asFloat, msg[3].asFloat, msg[4].asFloat, cmix];
    if (~legendActive.not) {
        ~applyOcean.(~frameCook.valueArray(~lastLive));
    } { ~dbg.if { "[DBG] /dark_frame kept for the release (a legend chip is held)".postln } };
}, '/dark_frame');

// ═══ THE LEGEND: /dark_legend hold|release (rebuilt 2026-09-27, INTEGRATION_PLAN phase 4) ═══════
//   hold <driver> <temp sal nut anom c0 c1 c2 c3>: the page sends THE DATE SHOWN with one driver
//   pushed; it is cooked by ~frameCook like any date, then ~legendPolicy / ~legendDuck decide what is
//   audible while you listen. release: back to exactly the date shown. `end` = a legacy alias.
//   WHICH layers sound during a hold: ~legendLayers (with ~applyMix; every other layer is muted).
//   At WHAT level: the chip's own voices here (absent = the cook's level):
~legendLevels = (
    temp:      (undercurrent: 0.7, midcurrent1: 0.22),     // the drone at its design level
    anomaly:   (undercurrent: 0.7, midcurrent1: 0.22),
    salinity:  (),                                         // the rain: the teaching rain (~legendPolicy)
    nutrients: (),                                         // the rain at the cook's level
    cluster:   (midcurrent2: ~bedLevel)                    // the bed at its design level (alone, with its bell)
);
~legendPolicy = { |driver, p|
    // SALINITY is heard only on transients (a sustained drone comb-cancels its own reverb, measured
    //   2026-07-21), so its audition plays a steady TEACHING RAIN for the space to open on. The one
    //   exaggeration the legend keeps; written down in lab/LEGEND_REFERENCE.md (INTEGRATION_PLAN Q5).
    (driver == \salinity).if { p[\dens_drops] = 3.0; p[\amp_drops] = 0.75 };
    // WATER MASS: damp the bed's internal reverb so its pitch reads as a tone, not a wash.
    (driver == \cluster).if { p[\mix_midII] = 0.12 };
    p;
};
~legendDuck = { |driver|
    var lv = ~legendLevels[driver.asSymbol] ? ();
    [\undercurrent, \midcurrent1, \midcurrent2, \drops].do { |n|
        var a = lv[n];
        (a.notNil and: { ~synths[n].notNil }).if { ~synths[n].set(\amp, a) };
    };
};
~legendEnd = {
    ~clockAuditionStop.();
    ~legendActive = false; ~legendDriver = nil;
    if (~lastLive.notNil) {
        ~lastCluster = -1;                                     // re-pitch the bed to the date's mass WITHOUT a bell
        ~applyOcean.(~frameCook.valueArray(~lastLive));
    } {                                                        // no date received yet: design levels, neutral state
        ~droneProc.notNil.if { ~droneProc.set(\wet, 0, \tremDepth, 0) };
        ~transProc.notNil.if { ~transProc.set(\space, 0) };
        ~synths[\undercurrent].notNil.if { ~synths[\undercurrent].set(\amp, 0.7, \rq, 0.5) };
        ~synths[\midcurrent1].notNil.if  { ~synths[\midcurrent1].set(\amp, 0.22) };
        ~synths[\drops].notNil.if        { ~synths[\drops].set(\amp, 0.50, \dens, 1.2, \freqmin, 1100, \freqmax, 3800) };
    };
    ~synths[\midcurrent2].notNil.if { ~synths[\midcurrent2].set(\amp, ~bedLevel, \mix, 0.7) };   // the bed's design level + reverb
    ~applyMix.();
    ~applyMaster.();
};
OSCdef(\darkLegend, { |msg|
    var cmd = msg[1].asSymbol;
    ~rxLegend = ~rxLegend + 1;
    switch (cmd,
        \hold, {
            var driver = msg[2].asSymbol;
            var cmix = [msg[7], msg[8], msg[9], msg[10]].collect(_.asFloat);
            var clk  = (msg[11] ? 0).asFloat;                  // the clock chip: 0 still (1 part) · 1 changing (8 parts)
            var p = ~frameCook.(msg[3].asFloat, msg[4].asFloat, msg[5].asFloat, msg[6].asFloat, cmix);
            ~clockAuditionStop.();
            ~legendActive = true; ~legendDriver = driver;
            // EVERY TRANSIENT STILL RINGING from just before the press fades out (80 ms): the chimes and any
            //   playback bell. Nothing new starts during a hold (\darkDynamics and ~applyOcean skip them);
            //   the water-mass chip's OWN bell is rung fresh below, at its layer's gain.
            ~chimeGroup.notNil.if { ~chimeGroup.set(\mixgain, 0) };
            ~bellGroup.notNil.if  { ~bellGroup.set(\mixgain, 0) };
            ~clockGroup.notNil.if { ~clockGroup.set(\mixgain, 0) };
            ~applyMaster.();                                   // D4: sounds even with ♪ off
            ~applyMix.();
            ~applyOcean.(~legendPolicy.(driver, p));
            ~legendDuck.(driver);
            ((driver == \cluster) and: { (p[\clustering] ? -1) >= 0 }).if { ~ringBell.(p[\clustering], 0.45) };
            // THE CLOCK CHIP: dates tick at 1× while held, the first one accented, divided as `clk` says
            (driver == \clock).if {
                ~clockAudition = Routine({ var k = 0, parts = 1 + (clk.clip(0, 1) * (~clockPartsMax - 1)).round;
                    loop { ~clockDate.((k == 0).if(1, 0), parts, ~clockStep, 1500); k = k + 1; ~clockStep.wait } }).play(SystemClock);
            };
            "  [legend] hold % (the date shown, one driver pushed)".format(driver).postln;
        },
        \release, { ~legendEnd.value; "  [legend] release → the date shown".postln },
        \end,     { ~legendEnd.value; "  [legend] end → the date shown".postln }
    );
}, '/dark_legend');

// ═══ /dark_mix — the SOUND tab's seven layer faders (0..1) ══════════════════
//   [drone, bed, rain, bell, chimes, trace, clock]. The bridge owns the mix and echoes it to every page.
//   A six-value message (an older bridge) leaves the clock where it is.
OSCdef(\darkMix, { |msg|
    var keys = [\drone, \bed, \rain, \bell, \chimes, \trace, \clock];
    keys.do { |k, i| msg[i + 1].notNil.if { ~mix[k] = msg[i + 1].asFloat.clip(0, 1) } };
    ~applyMix.();
    ("  [mix] " ++ keys.collect { |k| k.asString ++ "=" ++ ~mix[k].round(0.01) }.join(" ")).postln;
}, '/dark_mix');

// ═══ /dark_clock — one DATE on the clock (2026-10-02) ═════════════════════════
//   [accent, n, period, formant], all decided by the page from the SOUND tab's three choices:
//     accent  1 = an accented tick (January / the 1st, or a date in the top quarter of a statistic)
//     n       the date's parts, 1–8 (from how much a feature changed since the last date; 1 = the tick alone)
//     period  the date's length on the page, s (PLAY_MS): the parts are fractions of it
//     formant the wood's brightness, Hz (1500 fixed, or 1150–2300 from the day length or a feature)
//   The page sends one per date VISITED (playing or scrubbing), never on a redraw. Nothing new starts
//   during a legend hold (the clock chip plays its own audition).
OSCdef(\darkClock, { |msg|
    ~legendActive.not.if { ~clockDate.(msg[1].asFloat, msg[2].asFloat, msg[3].asFloat.clip(0.05, 4),
                                       (msg[4] ? 1500).asFloat.clip(400, 4000)) };
}, '/dark_clock');

// ═══ /dark_master — ♪ (mute) and the master volume, now SEPARATE ════════════
OSCdef(\darkMaster, { |msg|
    var cmd = msg[1].asString, v = msg[2].asFloat;
    (cmd == "mute").if { ~masterMute = (v > 0.5) };
    (cmd == "vol").if  { ~masterVol = v.clip(0, 1) };
    ~applyMaster.();
    ("  [master] " ++ cmd ++ " " ++ v ++ " → vol " ++ ~masterVol.round(0.01)
        ++ ~masterMute.if(" · muted", " · on")).postln;
}, '/dark_master');

// ═══ /dark_tracked — the traced cells as one CHORD (Björn's discrete wish) ══════
//   [n, latC, lonC, temp, sal, nut, anom, c0, c1, c2, c3]. temp/sal/nut/anom arrive stretched over the
//   dates on screen (2026-09-27), so the chord's root sits on the drone's own scale (one route).
OSCdef(\darkTracked, { |msg|
    var n = msg[1].asInteger, temp = msg[4].asFloat, nut = msg[6].asFloat;
    var c = [msg[8], msg[9], msg[10], msg[11]].collect(_.asFloat);
    var root, amp, breath;
    if (n <= 0) {
        ~synths[\trackedwash].notNil.if { ~stopFade.(\trackedwash) };
    } {
        root   = ~tempVoices.(temp)[\fund] * 2;                // the drone's degree, an octave ABOVE its body (300–1000 Hz)
        // 2026-09-29 (Miguel, after an A/B): two octaves up. At `* 0.5` (75–250 Hz) the chord was all below 150 Hz in the
        //   cold months, inaudible on laptop speakers and buried under the drone; up here it is a figure over the ground.
        amp    = (n / 300).clip(0.04, 0.5);                    // more cells → fuller, capped
        breath = nut.clip(0, 1).linlin(0, 1, 0.05, 0.6);       // richer water → more breath in the wash
        if (~synths[\trackedwash].isNil) {
            ~play.(\trackedwash, [\root, root, \amp, amp, \breath, breath,
                \w0, c[0], \w1, c[1], \w2, c[2], \w3, c[3], \mixgain, ~layerGain.(\trace)]);   // muted during a hold (never a legend layer)
        } {
            ~setIfPresent.(~synths[\trackedwash], \trackedwash,
                [\root, root, \amp, amp, \breath, breath, \w0, c[0], \w1, c[1], \w2, c[2], \w3, c[3]]);
        };
    };
}, '/dark_tracked');

// ═══ /dark_record — SC records its own output for the page's video export ════
OSCdef(\darkRecord, { |msg|
    var action = msg[1].asString;
    if (action == "start") {
        var from = (msg[2] ? "span").asString, to = (msg[3] ? "").asString;
        ~recPath = ("~/dark_ocean_" ++ from ++ "_" ++ to ++ ".wav").standardizePath;
        s.record(~recPath);
        ("  [record] SC recording → " ++ ~recPath).postln;
    } {
        s.stopRecording;
        ("  [record] SC stopped" ++ (~recPath.notNil.if({ " → " ++ ~recPath }, { "" }))).postln;
    };
}, '/dark_record');

// ═══ /dark_dynamics — the upwelling / productive-front CHIMES (threshold heuristics) ═══
//   A sparse event when the pointer or the timeline enters an upwelling (colder than usual AND
//   nutrient-rich) or a productive front (plankton AND nutrients both high). The page gates it;
//   this is a light backstop. [kind, intensity, pan, glide]. Design: lab/OCEAN_DYNAMICS.md.
OSCdef(\darkDynamics, { |msg|
    var kind  = msg[1].asString,
        x     = msg[2].asFloat.clip(0, 1),
        pan   = msg[3].asFloat.clip(-1, 1),
        glide = (msg[4] ? 0).asFloat.clip(-2, 2),
        now   = SystemClock.seconds,
        mg    = ~layerGain.(\chimes);
    ~rxDyn = ~rxDyn + 1;
    if (~legendActive.not) {
        if (kind == "upwell") {
            if ((now - ~lastUpwell) > 0.35) {
                ~lastUpwell = now;
                Synth(\upwellChime, [
                    \out,    ~transBus.index,             // → the salinity space; keys the drone's duck
                    \fund,   560 * (2 ** (x * 0.6)),      // ~560–850 Hz, higher = stronger upwelling
                    \amp,    0.35 + (x * 0.40),
                    \pan,    pan,
                    \bright, 0.35 + (x * 0.35),
                    \nchime, (2 + (x * 3)).round,         // 2–5 taps
                    \ring,   3.0 + (x * 2.0),
                    \spread, 0.9,
                    \glide,  glide,
                    \mixgain, mg ], ~chimeGroup ? ~srcGroup);
            };
        };
        if (kind == "prod") {
            if ((now - ~lastFish) > 0.35) {
                ~lastFish = now;
                Synth(\fishChime, [
                    \out,    ~transBus.index,
                    \fund,   1500 * (2 ** (x * 1.1)),     // ~1500–3200 Hz, higher = richer productive front
                    \amp,    0.75 + (x * 0.60),
                    \pan,    pan,
                    \bright, 0.5 + (x * 0.4),
                    \nchime, (4 + (x * 5)).round,         // 4–9 fast taps
                    \ring,   1.5 + (x * 1.5),
                    \spread, 0.5,
                    \mixgain, mg ], ~chimeGroup ? ~srcGroup);
            };
        };
    };
}, '/dark_dynamics');

~applyMix.();                                          // self-consistent state, also after a parser reload
~applyMaster.();                                       // (boots muted: ♪ off)

"".postln;
"  [parser] the dark_ocean sound contract is active".postln;
"    /dark_frame     → the region on the date shown (the ground)".postln;
"    /dark_legend    → hold | release (the date shown, one driver pushed)".postln;
"    /dark_mix       → seven layer faders · /dark_master → vol | mute".postln;
"    /dark_clock     → a tick per date: accent, division, brightness (chosen on the SOUND tab)".postln;
"    /dark_tracked   → the traced cells as one chord".postln;
"    /dark_dynamics  → upwelling + productive-front chimes".postln;
"    /dark_record    → s.record / s.stopRecording (the page's video export)".postln;
"  Lang port: %".format(NetAddr.langPort).postln;
"".postln;
)
