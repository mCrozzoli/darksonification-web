// GENERATED by web_implementation/build/build_web.py from sc/dark_ocean_synths.scd — do not edit here.
// Source sha256 58cd3eb165c382c7; 1 web substitution(s), listed in build_info.json.
// =============================================================================
//  DARK_OCEAN — 4 Ocean SynthDefs + Binaural Widener
//
//  Adapted from old_sc/I_Am_The_Ocean_synths.scd for live OSC streaming:
//    - Gated ASR envelope (gate=1 sustain, gate=0 fade-rel-then-free,
//      doneAction:2 only fires on gate-down → safe live re-set on params)
//    - All 4 synths now have a \pan arg (undercurrent + midcurrent1 added it)
//    - Stereo signal mixed-to-mono pre-Pan2 (was a buggy quad write to bus 0)
//    - All output writes to ~resBus, then \binauralWiden writes ~resBus → 0
//
//  Signal chain (2026-09-27, INTEGRATION_PLAN.md phases 1 and 5):
//    [under | midI | midII | trackedwash]  → ~droneBus → \droneProc (duck, tremolo, cap) ─┐
//    [drops]                               → ~rainBus  ─┐                                ├→ ~resBus
//    [upwell | fish chimes]                → ~transBus ─┴→ \transProc (salinity space) ──┘
//    ~resBus → \binauralWiden (M/S + Haas) ─┐
//    [water-mass bell \landmark] → ~bellBus ┤
//    [clock \oceanTick | \oceanTrain] → ~clockBus ┴→ + master gain + NaN guard + Limiter → out 0
//  The bell is CLEAN (Miguel D7): it bypasses the salinity space, the drone's reverb and tremolo and
//  the widener's side/Haas stage; only the master gain and the limiter touch it. The drone ducks under
//  EVENTS (bell + chimes), never under the rain. The CLOCK (2026-10-02) is clean the same way, on its own
//  bus so the drone does NOT duck under every tick.
//  Every sustained voice and every event has a `mixgain` (the SOUND tab fader, 0..1) that multiplies
//  its design level and never overwrites it.
//
//  Helper closures (used by parser):
//    ~play.(name, args)      // free old slot, start new synth on ~resBus
//    ~stopFade.(name)        // gate=0 fade out (rel sec) then frees itself
//    ~stop.(name)            // immediate free
//    ~stopAll.()             // free everything
// =============================================================================

(
s.options.numInputBusChannels  = 0;
s.options.numOutputBusChannels = 2;
s.options.outDevice_("Built-in Output");

s.waitForBoot {

    "============================================".postln;
    "  DARK_OCEAN — booting synths...".postln;
    "============================================".postln;

    ~resBus   = Bus.audio(s, 2);     // MASTER bus — droneProc + transProc sum here → the widener reads it
    ~droneBus = Bus.audio(s, 2);     // GROUND: undercurrent/mids/drops/trackedwash — ducked by the bells, capped low
    ~transBus = Bus.audio(s, 2);     // FIGURE: upwelling + productive-front chimes (salinity space; they duck the drone)
    ~rainBus  = Bus.audio(s, 2);     // the nutrient RAIN: salinity space rides it, but it never ducks the drone (2026-09-27)
    ~bellBus  = Bus.audio(s, 2);     // the water-mass BELL: clean, straight to the master stage (Miguel D7, 2026-09-27)
    ~clockBus = Bus.audio(s, 2);     // the CLOCK: clean like the bell, but NOT read by \droneProc (no duck per tick)
    "  [1/4] Server ready  (master=% drone=% trans=% rain=% bell=% clock=%)".format(
        ~resBus.index, ~droneBus.index, ~transBus.index, ~rainBus.index, ~bellBus.index, ~clockBus.index).postln;

    // ─────────────────────────────────────────────────────────────────────
    // BINAURAL WIDENER  (Mid/Side + Haas delay on R for stereo image)
    // ─────────────────────────────────────────────────────────────────────
    // `bellbus` MUST always be passed explicitly (the node chain below does): its default of 0 would read
    //   the hardware output back in. `clockbus` likewise, and `clockon` (default 0) keeps a widener started
    //   without it from reading bus 0 back in.
    SynthDef(\binauralWiden, { |out = 0, in = 0, bellbus = 0, clockbus = 0, clockon = 0, width = 2.4, haas = 0.00088, mgain = 0|
        // MASTER NaN/inf GUARD (07-19): replace any bad sample with 0 so one blown synth (e.g. a GVerb
        // runaway) can't feed NaN through the Limiter and silence/garble the WHOLE output. The Limiter
        // alone does NOT sanitize NaN.
        var guard = { |ch| Select.ar(CheckBadValues.ar(ch, 0, 0), [ch, DC.ar(0), DC.ar(0), DC.ar(0)]) };
        var sig   = In.ar(in, 2).collect(guard);
        var bell  = In.ar(bellbus, 2).collect(guard);   // the CLEAN water-mass bell (Miguel D7): no M/S, no Haas
        var clock = In.ar(clockbus, 2).collect(guard) * clockon;   // the CLEAN clock (2026-10-02), likewise
        var mid   = (sig[0] + sig[1]) * 0.5;
        // `width` is a fixed stereo width (2.4). A 2026-07-20 idea set it from salinity; nothing sets it,
        //   and on mono-folded sources it did nothing audible, so it stays constant.
        var side  = (sig[0] - sig[1]) * 0.5 * width.lag(2.5);
        var left  = mid + side;
        var right = DelayN.ar(mid - side, 0.005, haas);
        // MASTER GAIN (07-19, reworked 2026-09-27): mgain BOOTS AT 0 = SILENT. The parser computes it as
        //   master volume × (♪ on, or a legend audition is being held) — see ~applyMaster. The bell joins
        //   AFTER the widening, so it shares only this gain and this limiter with everything else.
        var stereo = (LeakDC.ar([left, right]) + bell + clock) * mgain.lag(0.4);
        Out.ar(out, Limiter.ar(stereo, 0.95, 0.01));
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // BUS SPLIT (2026-07-19, review fix 2) — the FIX for "boost one voice → mush".
    // \droneProc: reads ~droneBus, SIDECHAIN-DUCKS by the transient-bus envelope (a bell punches a
    //   hole in the drone so the FIGURE reads over the GROUND), then caps well below the master so the
    //   drone/bell BALANCE is set PRE-master (survives to the speaker; the master Limiter is safety only).
    // ─────────────────────────────────────────────────────────────────────
    // 2026-07-21 (Miguel review): cap 0.5 with amp_under 1.3 put this Limiter in ~4.8 dB of PERMANENT
    //   gain reduction, so every dB added to the drops or the reverb was immediately given back and the
    //   five legend demos all measured within ~5 dB of each other. cap 0.8 + amp_under 0.7 lands GR ≈ 0.
    //   duck 0.75 → 0.45 so a 6 drops/s rain on the transient bus does not pump the drone.
    // 2026-09-27: the duck KEY is the events only: the chimes (transbus) + the water-mass bell (bellbus).
    //   The rain moved to its own bus, so a dense rain no longer pumps the drone (INTEGRATION_PLAN 1.6).
    SynthDef(\droneProc, { |dronebus = 0, transbus = 0, bellbus = 0, out = 0, duck = 0.45, cap = 0.8,
                            wet = 0, tremDepth = 0, tremRate = 5.2|
        var drone = In.ar(dronebus, 2);
        var key   = In.ar(transbus, 2) + In.ar(bellbus, 2);
        var sc    = Amplitude.kr(key.sum * 4, 0.004, 0.30).clip(0, 1);    // envelope of the events (×4: a sparse ringing bell reads low, boost the detection)
        var gain  = (1 - (sc * duck)).lag(0.02);                          // duck the drone while a bell or chime rings
        // SALINITY → SPACE (2026-07-20 "all drivers audible"): a reverb SEND on the WHOLE drone, wet = salinity.
        //   fresh coastal (shallow/enclosed) ≈ dry/close → salty open-ocean (deep/vast) ≈ spacious/reverberant.
        //   An ADDITIVE cue (a tail appears) — distinct from the temperature pitch, so it layers not masks.
        //   FreeVerb (bounded, no GVerb NaN risk); medium room so it's "space", not a long wash that smears the note.
        var rev   = FreeVerb.ar(drone, 1.0, 0.62, 0.28);
        // ANOMALY → TREMOLO: the whole drone WAVERS, deeper the further the date sits from the middle of the
        //   period shown (Miguel D1: the anomaly is against each place's average over the whole record, so
        //   the warmest and coldest months waver most). It modulates every drone voice at once.
        // 2026-09-27 UNITY-MEAN (INTEGRATION_PLAN 5.2): was `1 - depth·(0..0.6)`, whose average gain is
        //   1 − 0.3·depth, so at full depth the drone also got ~3 dB QUIETER every winter and summer: level
        //   had become a second, unlabelled anomaly cue. Now it swings ±0.3·depth around 1, same depth, same
        //   average level. (Peaks reach +2.3 dB at full depth; the cap-0.8 limiter below catches them.)
        var trem  = 1 + (tremDepth.lag(0.22) * 0.3 * SinOsc.kr(tremRate));
        //   2026-07-21: send cut 0.7 → 0.35. MEASURED through the full chain, reverberating a SUSTAINED
        //   drone is a comb-filtered copy of the same steady tone: it partially CANCELS the dry signal,
        //   so wet 0→1 was -1.2 dB full-band / -2.5 dB in 1-4 kHz — salinity got quieter, not "bigger".
        //   The audible salinity cue now lives on the FIGURE bus (\transProc \space) where transients
        //   excite a tail the ear can actually hear. This send stays only as a sweetener.
        drone     = drone + (rev * wet.lag(0.35).clip(0, 1) * 0.35);
        Out.ar(out, Limiter.ar(drone * gain * trem, cap));
    }).add;
    // \transProc: reads the chimes + the rain — light cap only, no ducking. → master.
    //   SALINITY → SPACE (2026-07-21, moved here from the drone): a slapback echo + tail on the
    //   transients (the rain and the chimes). A reverb is only perceptible when something TRANSIENT
    //   excites it, so the cue rides the rain instead of a steady drone that cancels it.
    //   fresh/coastal = tight & close (110 ms, 0.6 s) → salty/open ocean = wide & long (310 ms, 3.2 s).
    // 2026-09-27: reads the chimes (transbus) AND the rain (rainbus). The water-mass bell no longer comes
    //   through here: it is clean (Miguel D7) and goes straight to the master stage.
    SynthDef(\transProc, { |transbus = 0, rainbus = 0, out = 0, cap = 0.92, space = 0|
        var sig = In.ar(transbus, 2) + In.ar(rainbus, 2);
        var w   = space.lag(0.35).clip(0, 1);  // lag 0.35 (a 60 dB time): the space lands within one frame even at 4× (160 ms)
        // 2026-07-21 FIX (Miguel: the legend bell "sounds like a feedback thing", unlike the good bell
        //   in the cube section). The crossfade rewrite left this comb at a FIXED 0.6, so at space=0
        //   (which is the state during the water-mass audition) every bell got a 90 ms comb with 0.5 s
        //   decay = ~6 metallic repeats = flutter echo. It MUST scale with w, so w=0 is genuinely dry.
        //   (In the cube, salinity drives w high → a 350 ms slapback + long tail = the bell Miguel likes.)
        var ech = CombL.ar(sig, 0.6, 0.09 + (w * 0.26), 0.5 + (w * 3.2)) * (w * 0.6);
        var rev = FreeVerb.ar(sig + ech, 1.0, 0.35 + (w * 0.55), 0.42 - (w * 0.28));
        // CROSSFADE dry→wet (not additive): fresh (w=0) = dry, tight, close; salty (w=1) = the dry pulled
        //   back and a big spacious wash pushed forward — a spatial change the ear follows.
        var outsig = (sig * (1 - (w * 0.6))) + ((ech + rev) * (w * 1.7));
        Out.ar(out, Limiter.ar(outsig, cap));
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // \undercurrent  — deep voice (heat / water-mass driver)
    //   args: freq1, freq2, pan, mix, room, rq, amp, atk, rel
    // ─────────────────────────────────────────────────────────────────────
    SynthDef(\undercurrent, { |out = 0, gate = 1,
        freq1 = 60, freq2 = 90, pan = 0,
        mix = 0.0, room = 0.0, rq = 0.75, amp = 1.8, mixgain = 1,
        atk = 4, rel = 8|
        var env, in, sig, resmod, subcut;

        env    = EnvGen.kr(Env.asr(atk, 1, rel), gate, doneAction: 2);
        resmod = (LFNoise1.ar(0.5, 60, 90) /* WEB BUILD: LinCongL absent from the engine — see build_web.py */
                 * (freq1.lag(0.12) / 70).clip(1, 6)).max(420);
        // 2026-09-27 FEEDBACK RANGE FIX (INTEGRATION_PLAN 1.1): was `LinLin.ar(LFPar.ar(0.01), 0.5, 0.7)`,
        //   which passes 0.5/0.7 as the SOURCE range and leaves the output at LinLin's default 1..2, so the
        //   feedback swept about −6.5 … +3.5 over ~100 s: the body turned periodically noisy. The intent
        //   (the 0.5–0.7 feedback the sibling \midcurrent1 line shows in full form) is now written out.
        in     = SinOscFB.ar([freq1.lag(0.12), freq2.lag(0.12)],   // 07-19: lag 0.5→0.12 → the just-intonation pitch STEPS
                             LinLin.ar(LFPar.ar(0.01), -1, 1, 0.5, 0.7), 0.3);    //  crisply between months (0.5s glided them into a blur). source mul 0.22→0.3.
        sig    = RLPF.ar(in, resmod, rq.lag(0.3));
        // DEEP-SUB ROLE (2026-07-20): now that \midcurrent1 is the audible month CARRIER, the undercurrent is the
        // felt BODY. A steep post-LPF that TRACKS the note (~2× fundamental) keeps its fund+fifth but cuts the buzzy
        // upper harmonics that were blanketing the carrier's 330–1100 Hz band (masking it, esp. cold months).
        subcut = (freq1.lag(0.12) * 1.95).clip(200, 2400);
        sig    = LPF.ar(LPF.ar(sig, subcut), subcut);
        sig    = FreeVerb.ar(sig, mix.lag(0.5), room.lag(0.5));
        sig    = Mix.new(sig);                              // stereo → mono fold
        sig    = Pan2.ar(sig, pan.lag(0.3), amp.lag(0.15) * mixgain.lag(0.1));  // level × the SOUND-tab "drone" fader
        Out.ar(out, sig * env);
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // \midcurrent1  — THE MONTH CARRIER (2026-07-20 rework). Was a FIXED 1-1.3kHz
    //   halo that never moved → the listener locked onto a static wash and couldn't
    //   hear the month change (only the buzzy sub-bass undercurrent tracked temp,
    //   and it reads as timbre not pitch). NOW: a clean PITCHED pad whose freq1/freq2
    //   are set per-frame from temperature (300·pentatonic ≈ 300–1000 Hz — the laptop-
    //   speaker sweet spot), so the audible tone STEPS between months. rq = brightness,
    //   amp = the carrier level (parser sets ~0.22).
    //   ⚠ REVISION 2 (2026-07-20, adversarial review): v1 put the RLPF resonant peak ON the fundamental and
    //   drove its bandwidth from brightness → the carrier's LEVEL swung ~15 dB with temperature (warm months
    //   hit full-scale and slammed the drone limiter → pumping; cold months went quiet). FIX: put the cutoff
    //   ABOVE the fundamental (×1.8) so the tone passes at a STABLE level regardless of rq — rq now only shapes
    //   the overtone shelf's brightness, gently. Per-voice Limiter(0.5) added (consistent w/ drops/midcurrent2).
    //   NRT-verified: level swing 15 dB → 5.7 dB, no full-scale. Carrier band raised to 330·penta (cold months
    //   sit clear of the undercurrent, which is now a deep sub). Final balance = listening pass.
    //   args: freq1, freq2, pan, rq, amp, mix, room, revtime, atk, rel  (mix/room/revtime kept for ~synthParams compat, unused)
    // ─────────────────────────────────────────────────────────────────────
    SynthDef(\midcurrent1, { |out = 0, gate = 1,
        freq1 = 400, freq2 = 600, pan = 0,
        rq = 0.5, amp = 0.06, mix = 0.0, mixgain = 1,
        room = 250, revtime = 50,
        atk = 4, rel = 8|
        var env, in, sig, cut;

        env    = EnvGen.kr(Env.asr(atk, 1, rel), gate, doneAction: 2);
        // cutoff ABOVE the fundamental → the tone passes at a STABLE level (level decoupled from brightness).
        // lag 0.1 = the note STEPS crisply between months (0.5 = a blur).
        cut    = (freq1.lag(0.1) * 1.8).clip(240, 6000);
        in     = SinOsc.ar([freq1.lag(0.1), freq2.lag(0.1)], LinLin.kr(LFTri.kr(0.7), -1, 1, 0.001, 0.006));
        sig    = RLPF.ar(in, cut, (0.72 - (rq * 0.34)).clip(0.2, 0.9));       // rq (=brightness) → gentle overtone shelf; never whistles/full-scales
        sig    = Pan2.ar(Mix.new(sig), pan.lag(0.3), amp.lag(0.15) * mixgain.lag(0.1));   // × the "drone" fader
        sig    = sig + (FreeVerb.ar(sig, 0.35, 0.85, 0.4) * 0.5);             // soft glassy body/tail
        sig    = Limiter.ar(sig, 0.5, 0.002);                                // per-voice guard — can't slam the drone bus
        Out.ar(out, sig * env);   // NB: anomaly tremolo is applied downstream on the whole drone bus (\droneProc), not here
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // \midcurrent2  — the water-mass BED (freq1 = the dominant water mass's pad
    //   tone, re-set only when the dominant mass changes; fixed low amp so it
    //   fuses under the floor rather than adding a tracked channel).
    //   2026-09-27: freq2 is now ALWAYS set with freq1 (a deliberate fifth, ~bedInterval in the parser).
    //   It used to stay at its 825 Hz default forever, beating against freq1 (25 Hz against the 800 Hz
    //   the 10-day file's reject class played; 75 Hz against the 750 Hz boot default) — the "drilling".
    //   args: freq1, freq2, pan, duration, mix, amp, mixgain, atk, rel
    // ─────────────────────────────────────────────────────────────────────
    SynthDef(\midcurrent2, { |out = 0, gate = 1,
        freq1 = 200, freq2 = 300, pan = 0,
        duration = 20, mix = 0.7, amp = 0.40, mixgain = 1,      // amp = the parser's ~bedLevel (was 0.015: inaudible)
        room = 100, revmintime = 0.5, revmaxtime = 10,
        atk = 4, rel = 8|
        var env, in, sig, resmod, panmov;

        env    = EnvGen.kr(Env.asr(atk, 1, rel), gate, doneAction: 2);
        resmod = SinOsc.kr(XLine.kr(0.07, 30, duration.lag(2)), 0, 35, 40);
        // 2026-07-21 AUDIT FIX: was `.exprange(-1, 1)` — an EXPONENTIAL map across zero/negative is NaN
        //   (`dstlo * pow(dsthi/dstlo, x)` = `-1 * pow(-1, x)`). The following `.clip(-1,1)` silently
        //   resolved the NaN to a hard -1, so this identity bed played HARD LEFT ONLY, forever, and the
        //   intended slow drift never happened (NRT: peak L 9064 / peak R 0). LFNoise1 is already ±1.
        panmov = LFNoise1.kr(0.5);
        in     = SinOscFB.ar([freq1.lag(0.12), freq2.lag(0.12)],
                             LFNoise2.kr(0.05, 3).exprange(0.05, 1.5));
        sig    = HPF.ar(in, resmod);
        sig    = Pan2.ar(Mix.new(sig), (panmov + pan).clip(-1, 1), amp.lag(0.15) * mixgain.lag(0.1));   // × the "bed" fader
        // FreeVerb (bounded + stable) REPLACES GVerb (2026-07-20, Miguel: cluster slider "blows up in feedback,
        // no bells"). GVerb rang out of control when the bed was re-pitched fast (the cluster slider / rapid
        // cluster changes), and the resulting NaN/overload tripped the master guard so the boundary bell was lost
        // too. FreeVerb can't run away; `mix` still scales its wet tail. room/revmin/revmax kept for arg compat.
        sig    = sig + (FreeVerb.ar(sig, mix.lag(0.5).clip(0, 1) * 0.7, 0.85, 0.35) * 0.7);
        sig    = LeakDC.ar(sig).clip2(2) * 0.16;                          // per-voice safety cap (unchanged)
        Out.ar(out, sig * env);
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // \drops  — sparse percussive layer (bio-driven density, freqmin/max,
    //           del times; phyto-region multipliers folded in by the parser
    //           before \set so the synth itself stays simple)
    // ─────────────────────────────────────────────────────────────────────
    // REWRITTEN 2026-07-21 (Miguel: "the drops are still very difficult to hear"). MEASURED root causes:
    //   (1) bwr 0.003 = Q≈333 → each "drop" was a 350 ms decaying SINE, not a transient (crest 4.2 vs
    //       a real rain's 15-30) — a continuous narrow-band wash, ~0-2 audible onsets per 3 s.
    //   (2) ONE LFNoise1.kr(0.005) centre freq shared by all 7 taps, re-randomised once every 200 s →
    //       the whole "rain" was a single frozen pitch for the entire teaser.
    //   (3) del2decay defaulted to 15 s and the parser never set it → the comb tail smeared every drop
    //       into the next (feedback 0.977, ~43x build-up), destroying the density cue.
    //   (4) Dust density is PER TAP, so the real rate was 7x dens = 3.5-35 events/s — far past the rate
    //       at which a listener can count events, so the whole nutrient sweep read as "slightly more hiss".
    //   (5) band 400-2000 Hz sat under the 330-1100 Hz carrier and below where laptop speakers are efficient.
    // NOW: per-drop random pitch, percussive Q, an added broadband strike that cuts through a drone, the
    //   1.1-3.8 kHz band small speakers reproduce well, and a short 1.2 s tail. NRT: crest 22-28, ~3-15
    //   discrete drops/s, and the nutrient sweep finally RISES in the mix instead of falling.
    SynthDef(\drops, { |out = 0, gate = 1,
        dens = 0.2, freqmin = 1100, freqmax = 3800, pos = 0, amp = 0.32, mixgain = 1,
        del1time = 0.048, del2decay = 1.2,
        atk = 1, rel = 4|
        var env, taps, sig1, sig2, sig3, final;

        env    = EnvGen.kr(Env.asr(atk, 1, rel), gate, doneAction: 2);
        taps   = Array.fill(5, {
                     var t  = Dust.ar(dens.lag(0.18) * 0.6);                       // TOTAL rate = 3*dens (was 7*dens)
                     var f  = TExpRand.ar(freqmin.lag(0.5), freqmax.lag(0.5), t); // EVERY drop its own pitch
                     var pg = Resonz.ar(t * 8, f, 0.035) * 5;                     // ~35 ms plink, not a 350 ms sine
                     var tk = HPF.ar(Decay2.ar(t, 0.0004, 0.010) * PinkNoise.ar(1.0), 1400) * 0.88;  // broadband strike
                     // 2026-09-27 (Miguel: "Louder taps"): 0.35 → 0.88, +8 dB. In warm months the note's
                     //   harmonics cover the drops' pitched part (1.1–3.8 kHz, measured −35 dB in Aug 2021);
                     //   the tap reaches 3.8–14 kHz, where the note is ~30 dB quieter, so the rain stays audible.
                     pg + tk
                 });
        sig1   = Mix.ar(taps);
        sig2   = DelayN.ar(sig1, del1time.lag(0.3));
        sig3   = Mix.ar(Array.fill(3, {
                     CombL.ar(sig2, 0.1, LFNoise1.kr(0.1.rand, 0.04, 0.05),
                              del2decay.lag(0.5))
                 }));
        4.do { sig3 = AllpassN.ar(sig3, 0.050, [0.050.rand, 0.050.rand], 1) };
        final  = sig1 + (0.14 * sig3);
        final  = Pan2.ar(final, pos.lag(0.3), amp.lag(0.15) * mixgain.lag(0.1));   // × the "rain" fader
        final  = Limiter.ar(final, 0.6, 0.002);            // review fix 2: per-voice cap — the amp-50 Dust spikes were permanently pinning the MASTER limiter (→ the "boost anything = mush")
        Out.ar(out, final * env);
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // \landmark  — the WATER-MASS BELL: one strike when a different water mass takes over the region.
    //   2026-09-27 (Miguel D7): pitched by the ARRIVING water mass (2 × that mass's bed tone, so the bell
    //   names the water that arrives: ~bellFreq in the parser), and CLEAN: the parser plays it on
    //   ~bellBus, which skips the salinity space, the drone's reverb/tremolo and the widener's side/Haas
    //   stage and joins only the master gain + limiter. Perc env, self-frees. The parser debounces in
    //   FRAMES (every real change rings), with only an 80 ms backstop for scrub bursts.
    // ─────────────────────────────────────────────────────────────────────
    // 2026-07-21 (Miguel: "no bell when clicking mass 0..3"). The old bell was TWO pure sines with
    //   a 0.9 s perc — crest ~8 dB, a soft "boop" that didn't read as a bell and was masked by the
    //   bed. Now a STRUCK inharmonic bell (Klank resonators rung by a short noise burst) + a bright
    //   attack tick — a real bell that cuts through. `amp 0.14` default kept for the live-nav path;
    //   the legend fires it loud.
    SynthDef(\landmark, { |out = 0, freq = 400, amp = 0.14, pan = 0, mixgain = 1|
        var trig = Impulse.ar(0);
        var exc  = Decay2.ar(trig, 0.0008, 0.05) * PinkNoise.ar(1);
        var body = Klank.ar(`[[freq, freq*2.01, freq*2.97, freq*4.19, freq*5.66],
                              [1, 0.7, 0.5, 0.35, 0.22],
                              [1.6, 1.2, 0.9, 0.6, 0.4]], exc * 0.35);
        var tick = HPF.ar(Decay2.ar(trig, 0.0005, 0.014) * WhiteNoise.ar(1), 4000) * 0.6;
        var kill = EnvGen.kr(Env.linen(0.001, 1.8, 0.2), doneAction: 2);   // free the synth after it rings
        Out.ar(out, Pan2.ar(LeakDC.ar((body * 4) + tick) * amp * mixgain.lag(0.08) * kill, pan));   // × the "bell" fader
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // THE CLOCK (2026-10-02, Miguel: "I really liked the clock sonification … can be added (including fader
    //   and in the perceptual legend)"). Built from the dev drafts (dev/clock_beat/), now in the design.
    //   VOICE = dark_re_wilding's woodblock pulsaret, unchanged: SinOsc(f) + 0.45·SinOsc(2.76·f) + 0.12·noise
    //   under Decay2(0.4 ms, 35 ms). 2.76 is a woodblock's second mode, so it reads as wood, not as a note.
    //   THREE CHOICES on the SOUND tab (Miguel 2026-10-02: "stats variables are for accents and features are
    //   for division … for accent or division we can select also none", and the timbre carries data):
    //   \oceanTick  ONE TICK PER DATE at a fixed level. ACCENT (two levels only): ×1.4 and a ×2.2 ring on
    //               January / the 1st, or on the dates in the top quarter of a statistic, or never.
    //   \oceanTrain THE DIVISION: the date cut into n EQUAL parts (1–8; 1 = the tick alone), n from how much
    //               a feature changed since the last date. The parts are fractions of the date, so the count
    //               is the same at every playback speed. `gate` 0 cuts it in 10 ms (a newer date takes over).
    //   `formant` = BRIGHTNESS: 1500 Hz fixed, or 1150–2300 Hz (one octave) from the day length or a feature.
    //   Both play into ~clockGroup → ~clockBus (clean: master gain + limiter only; the drone never ducks).
    //   1500 Hz, not re_wilding's ~1200: the design is loudest in the 1 kHz octave, and at 1500 the wood
    //   stands ~10 dB clearer, its 2.76 partial (4.1 kHz) where the design is ~22 dB quieter (the drafts'
    //   measure, dev/clock_beat/README.md).
    // ─────────────────────────────────────────────────────────────────────
    SynthDef(\oceanTick, { |out = 0, formant = 1500, amp = 0.24, decay = 0.035, mixgain = 1|
        var env = Decay2.ar(Impulse.ar(0), 0.0004, decay);
        var p = SinOsc.ar(formant) + (0.45 * SinOsc.ar(formant * 2.76)) + (0.12 * WhiteNoise.ar(1));
        Line.kr(0, 0, decay * 12, doneAction: 2);
        Out.ar(out, (p * env * amp * mixgain.lag(0.08)).dup);              // × the "clock" fader
    }).add;
    SynthDef(\oceanTrain, { |out = 0, n = 4, period = 0.65, formant = 1500, amp = 0.144, decay = 0.035,
                             mixgain = 1, gate = 1|
        // n − 1 pulses at k·period/n (k = 1 … n−1): the gate opens half a part after the tick (the tick is
        //   not doubled) and closes half a part before the next date
        var rate = n / period;
        var open = EnvGen.ar(Env([0, 0, 1, 1, 0], [0.5 / rate, 0, (n - 1) / rate, 0]));
        var env  = Decay2.ar(Impulse.ar(rate) * open, 0.0004, decay);
        var p = SinOsc.ar(formant) + (0.45 * SinOsc.ar(formant * 2.76)) + (0.12 * WhiteNoise.ar(1));
        var cut = EnvGen.kr(Env.asr(0, 1, 0.01), gate, doneAction: 2);    // a newer date cuts the division
        Line.kr(0, 0, period + (decay * 12), doneAction: 2);
        Out.ar(out, (p * env * amp * mixgain.lag(0.08) * cut).dup);
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // OCEAN DYNAMICS bells — sparse crystal / wind-chime EVENTS fired ONLY on a
    //   threshold crossing at the NAVIGATED cell (the "figure", vs the /dark_frame
    //   drone "ground"). MVP = \upwellChime for UPWELLING. The parser spawns them into
    //   ~srcGroup on ~transBus → \transProc (salinity space) → master Limiter, so a fast
    //   drag stacking chimes can't clip; they also key the drone's duck. NOT registered
    //   in ~synths/~synthParams (one-shots; the "chimes" fader is passed at spawn).
    //   ~gust = a shared soft "wind" exciter (a few noise-taps scattered over `spread`
    //   sec) that rings the resonator bank so it feels struck by air, not a click.
    //   Design: lab/OCEAN_DYNAMICS.md.  ✔ COMPILE-checked (59/53 ugens) + NRT-rendered
    //   (non-silent, self-freeing, stereo). NRT caught \upwellChime clipping at ~1.2 peak
    //   pre-limiter → added the `* 0.4` headroom below (worst-case ~0.5 over 4 renders).
    //   ⚠ Still needs a foreground LISTENING pass on the audio device: final level, the
    //   upwell/fish balance (fish sits ~2.5× quieter — may want a bump), timbre + audible glide.
    // ─────────────────────────────────────────────────────────────────────
    ~gust = { |nchime = 4, spread = 0.6, bright = 0.5|
        var win = EnvGen.kr(Env.linen(0.01, spread, 0.08));            // taps only pass during the gust window
        var tp  = Dust.ar((nchime / spread).max(1)) * win;            // sparse taps, ~nchime over spread sec
        var exc = Decay2.ar(tp, 0.001, 0.02) * PinkNoise.ar(1);       // soft clapper, not a hard click
        LPF.ar(exc, LinExp.kr(bright, 0, 1, 2000, 9000));             // brightness → clapper cutoff (mono)
    };
    // \upwellChime — warm hollow free-bar bell, slow SWELL onset, pitch GLIDE (DynKlank
    //   = UGen-rate freqscale so the note rises/sinks). fund ~500–900 Hz (octave+ above the
    //   40–90 Hz undercurrent; HPF 220). glide = ±semitones from the browser Δ.
    SynthDef(\upwellChime, { |out = 0, pan = 0, amp = 0.20, fund = 760, bright = 0.4,
        nchime = 3, ring = 4.0, spread = 0.9, glide = 0.0, mixgain = 1|
        var env    = EnvGen.kr(Env.perc(0.20, ring, 1, \sin), doneAction: 2);       // welling-up onset, self-frees
        var gliss  = 2 ** (glide / 12 * Line.kr(0, 1, spread + ring));               // freqscale: glides over the note
        var ratios = [1, 2.76, 5.40, 8.93, 13.34] * LFNoise2.kr([0.25,0.25,0.25,0.25,0.25], 0.004, 1); // free-bar + shimmer
        var exc    = ~gust.value(nchime, spread, bright);
        var klank  = DynKlank.ar(`[ratios * fund, nil, ring * [1, 0.8, 0.62, 0.48, 0.34]], exc, freqscale: gliss);
        var sig    = HPF.ar(klank, 220) * env * amp * mixgain.lag(0.08) * 0.7;                 // 07-19: TRANSIENTS LOUD (Miguel) — bells are the figure; headroom 0.55→0.7, limiter guards peaks · × the "chimes" fader
        sig = sig + (FreeVerb.ar(sig, 0.30, 0.9, 0.4) * 0.6);                        // glassy tail
        Out.ar(out, Pan2.ar(sig, pan));
    }).add;

    // \fishChime — bright crystalline FLURRY, sharp strike, NO glide (static Klank = no freqscale).
    //   FISH / productivity: a teeming school-flicker of thin HIGH shards (~1500-3200 Hz, HPF 600),
    //   shorter/tighter tail than upwelling → many fast sparkles vs upwelling's few slow crystals.
    //   Same mono ~gust → resonator → Pan2 convention. Increment I2.  ⚠ UNTESTED (no sclang).
    SynthDef(\fishChime, { |out = 0, pan = 0, amp = 0.16, fund = 2000, bright = 0.7,
        nchime = 6, ring = 2.0, spread = 0.5, mixgain = 1|
        var env    = EnvGen.kr(Env.perc(0.004, ring, 1, -4), doneAction: 2);         // struck "tink", fast 0.004s strike
        var ratios = [1, 2.33, 3.61, 4.72, 6.15, 7.88, 9.41] * LFNoise2.kr(0.6!7, 0.006, 1);  // thin inharmonic shards + micro-detune
        var exc    = ~gust.value(nchime, spread, bright);
        var klank  = Klank.ar(`[ratios * fund, nil, ring * [1, 0.85, 0.7, 0.6, 0.5, 0.4, 0.3]], exc);  // STATIC Klank → no glide
        var sig    = HPF.ar(klank, 600) * env * amp * mixgain.lag(0.08);                        // × the "chimes" fader
        sig = sig + (FreeVerb.ar(sig, 0.22, 0.8, 0.35) * 0.5);                        // shorter, tighter glassy tail
        Out.ar(out, Pan2.ar(sig, pan));
    }).add;

    // ─────────────────────────────────────────────────────────────────────
    // \trackedwash  — "everything I'm tracing" as a soft CHORD + wash
    //   (Björn's discrete-sound wish). Driven by /dark_tracked (the page's
    //   merged-union aggregate): root = the traced cells' mean temperature on the
    //   SAME period-relative scale and just-intonation degrees as the drone
    //   (2026-09-27); four partials weighted by the traced cells' WATER-MASS mix
    //   → the chord voices the water-mass makeup; amp/breath scale with the count n.
    //   Gated ASR so gate=0 fades it out cleanly when the selection clears.
    //   args: root, w0..w3, breath, amp
    // ─────────────────────────────────────────────────────────────────────
    SynthDef(\trackedwash, { |out = 0, gate = 1,
        root = 110, w0 = 0.25, w1 = 0.25, w2 = 0.25, w3 = 0.25,
        breath = 0.3, amp = 0.0, pan = 0, mixgain = 1, atk = 3, rel = 5|
        var env, ratios, voices, wsh, sig;
        env    = EnvGen.kr(Env.asr(atk, 1, rel), gate, doneAction: 2);
        // a stacked chord: unison, minor-third, fifth, octave — each cluster a voice
        ratios = [1.0, 1.2, 1.5, 2.0];
        voices = Mix.new(
            [w0, w1, w2, w3].collect { |w, i|
                SinOsc.ar(root.lag(0.6) * ratios[i] * LFNoise2.kr(0.05, 0.004, 1),
                          0, w.lag(0.8) * 0.5)
            });
        wsh    = LPF.ar(PinkNoise.ar(breath.lag(0.5) * 0.5),
                        root.lag(0.6) * 4) * breath.lag(0.5);
        sig    = (voices + wsh) * amp.lag(0.6) * mixgain.lag(0.1);           // × the "trace" fader
        sig    = FreeVerb.ar(sig, 0.35, 0.8);
        Out.ar(out, Pan2.ar(sig, pan, 1) * env);
    }).add;

    s.sync;
    "  [2/4] SynthDefs loaded (gated ASR + landmark + upwellChime + fishChime, ~resBus routed)".postln;

    // ─────────────────────────────────────────────────────────────────────
    // SLOT MANAGEMENT
    // ─────────────────────────────────────────────────────────────────────
    ~synths = Dictionary.new;

    ~play = { |name, args = #[]|
        ~synths[name].notNil.if { ~synths[name].set(\gate, 0) };  // fade old
        ~synths[name] = Synth(name, [\out, ~droneBus.index] ++ args, ~srcGroup);  // drone → ~droneBus, inside the source group (runs before the procs)
    };
    ~stopFade = { |name|
        ~synths[name].notNil.if {
            ~synths[name].set(\gate, 0);  // releases over `rel` sec then frees
            ~synths[name] = nil;
        };
    };
    ~stop = { |name|
        ~synths[name].notNil.if { ~synths[name].free; ~synths[name] = nil };
    };
    // 2026-09-27 (INTEGRATION_PLAN 1.8): the old version wiped the WHOLE dictionary 10 s later, so a
    //   voice started inside those 10 s lost its slot and could never be faded or re-set again. The
    //   released voices free themselves (doneAction 2), so their references are dropped now, by name.
    ~stopAll = {
        ~synths.keys.copy.do { |k|
            ~synths[k].notNil.if { ~synths[k].set(\gate, 0) };
            ~synths[k] = nil;
        };
    };

    // ─────────────────────────────────────────────────────────────────────
    // SYNTH-PARAM COMPATIBILITY  (parser uses this to skip unsupported keys)
    // ─────────────────────────────────────────────────────────────────────
    ~synthParams = Dictionary.newFrom([
        \undercurrent, [\freq1, \freq2, \pan, \mix, \room, \rq, \amp, \mixgain, \atk, \rel],
        \midcurrent1,  [\freq1, \freq2, \pan, \rq, \amp, \mix, \mixgain, \atk, \rel],
        \midcurrent2,  [\freq1, \freq2, \pan, \duration, \mix, \amp, \mixgain, \atk, \rel],
        \drops,        [\dens, \freqmin, \freqmax, \pos, \amp, \mixgain,
                        \del1time, \del2decay, \atk, \rel],
        \trackedwash,  [\root, \w0, \w1, \w2, \w3, \breath, \amp, \pan, \mixgain, \atk, \rel],
    ]);

    "  [3/4] Slot helpers + ~synthParams ready".postln;

    // ─────────────────────────────────────────────────────────────────────
    // NODE CHAIN (order matters): srcGroup (every source) → droneProc (duck on bell+chimes, tremolo,
    //   cap) → transProc (salinity space on chimes+rain, cap) → widener (M/S + Haas on ~resBus, then
    //   + the clean bell from ~bellBus, master gain, NaN guard, Limiter 0.95 → out 0).
    // ─────────────────────────────────────────────────────────────────────
    ~srcGroup  = Group.new(s);                                    // sources live here → run BEFORE the procs read their buses
    ~chimeGroup = Group.tail(~srcGroup);                          // the chimes, together: a legend hold silences the ones still ringing
    ~bellGroup  = Group.tail(~srcGroup);                          // the bells, likewise (the water-mass chip rings a fresh one)
    ~droneProc = Synth.after(~srcGroup, \droneProc,
        [\dronebus, ~droneBus.index, \transbus, ~transBus.index, \bellbus, ~bellBus.index, \out, ~resBus.index]);
    ~transProc = Synth.after(~droneProc, \transProc,
        [\transbus, ~transBus.index, \rainbus, ~rainBus.index, \out, ~resBus.index]);
    ~clockGroup = Group.tail(~srcGroup);                          // the clock's ticks and rolls (a legend hold silences them)
    ~widen     = Synth.after(~transProc, \binauralWiden,
        [\in, ~resBus.index, \bellbus, ~bellBus.index, \clockbus, ~clockBus.index, \clockon, 1,
         \out, 0, \width, 2.4, \haas, 0.00088]);

    "  [4/4] Bus split live: drone→duck(events)→cap · chimes+rain→space→cap · clean bell + clock · master".postln;

    "============================================".postln;
    "  Synths ready — waiting for parser...".postln;
    "  Lang port: %".format(NetAddr.langPort).postln;
    "============================================".postln;
};
)
