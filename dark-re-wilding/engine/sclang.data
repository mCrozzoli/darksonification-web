	}

	release { |fadeTime|
		this.do({ arg proxy; proxy.release(fadeTime) });
		tempoProxy.free;
	}

	wakeUp {
		this.use({ arg envir;
			this.do({ arg proxy;
				proxy.deepWakeUp;
			});
		});
	}

	rebuild {
		var bundle = MixedBundle.new;
		var checkedAlready = IdentitySet.new;
		this.use {
			envir.do { arg proxy;
