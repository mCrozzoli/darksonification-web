		str.split($:).reverseDo { |num, i|
			num = num.asFloat;
			if (num < 0) {
				format("%.asSecs: negative numbers within slots not supported, using absolute value", this).warn;
				num = num.abs;
			};
			if (num > limits[i]) {
				format("%.asSecs: number of % greater than %", this, slotNames[i], limits[i]).warn;
