		} {
			^this.multiNew('audio', in, lagTime).madd(mul, add)
		}
	}
	*kr { arg in = 0.0, lagTime = 0.1, mul = 1.0, add = 0.0;
		if ( (in.rate == \scalar) || (lagTime == 0) ) {
			^in.madd(mul, add)
		} {
