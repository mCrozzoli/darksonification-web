// GENERATED by web_implementation/build/build_web.py from sc/dark_re_wilding_synths.scd — do not edit here.
// Source sha256 5f92b0cd9fa752e6; no substitution. The boot file is replaced by engine.js PRELUDE.
// dark_re_wilding - SC engine v2: the four-layer sound design.
// Replaces the v1 engine (bed + anthro drone + ecological-chord arp + corpus toggle),
// archived under sc/_v1_archive/. Design spec: ../dev/README.md, decisions in
// ../lab/DECISIONS.md 2026-09-21 / 09-22, explainer in ../lab/SoundDesign_Explanation/.
//
// THE CONTRACT
//   Continuous pair (drone + clave) = ACOUSTIC INDICES, measurements.
//   Discrete pair  (arp + corpus)  = BIRDNET, an inference and its evidence.
//   When the pairs agree the soundscape is congruent; when they diverge - a busy index
//   reading with a silent arp and corpus - the divergence IS the finding.
//
// Four objects on a table: a bowed cymbal, a woodblock beside it, a rack of tuned bars,
// and the tape. You can play the first three; you can only listen to the fourth.
(
var maxModes = 35;      // the SH lattice caps at l_max 5 => 35 modes. L0 subsets with few
                        // rows hit the Nyquist cap and return 24, so the arrays are fixed
                        // at 35 and zero-padded; a mode at amp 0 contributes nothing.

// ---- LAYERS 1 + 2: the bowed body and the woodblock ------------------------
// One synth because they share the comb: the clave has a small send INTO the drone's room
// (claveSend) as well as a dry path in front of it, which is what makes it sit in the same
// air without being reabsorbed. Separate amps so the mixer can move them independently.
// glide 4.0 = the SC Lag's 60 dB time, so tau = 4.0/6.91 = 0.58 s. Chosen by ear
// (Miguel, 2026-09-23): at the shipped 1.2 (tau 0.17 s) a point LANDS - it reads as a step,
// and a step is an event rather than an arrival. At 4.0 the body opens into the new balance
// and the modes can be heard coming up out of it. It lags \gains and \combDecay (the two
// things a point actually moves). It does NOT lag the clave: \claveFormant and \claveRate
// both keep the 5 ms claveGlide, because a formant smeared over half a second sounds like
// eight different pitches on the way in, and a smeared tick rate reads as the metre sagging
// rather than as a new metre. (\claveRate was moved off `glide` on 2026-09-24; the
// compiled def in dev/renders/_defs/ predates that and still lags it by `glide`.)
SynthDef(\rwContinuous, { |out = 0, gate = 1, droneAmp = 1, claveAmp = 0, exAmp = 0.03,
                          combDelay = 0.008, combDecay = 0.22, glide = 4.0,
                          claveRate = 3, claveFormant = 1200, claveAccent = 4,
                          claveDecay = 0.035, claveAccentBoost = 0.9, claveGlide = 0.005,
                          claveSend = 0.25, claveDry = 1.0|
    var env, bow, body, room, roomIn, sig, gains, amps,
        trig, cnt, accent, cenv, pulsaret, clave, ff;
    // ASR, not percussive: the body sustains for as long as the selection is open.
    env = EnvGen.kr(Env.asr(2.5, 1, 3.5), gate, doneAction: 2);

    // THE BOW. Pink noise gives every mode something to feed on; sparse Dust adds the grain
    // of a rubbed surface without ever reading as a hit. The strike is the clave's job.
    bow = (PinkNoise.ar(1) + (Dust.ar(2.5) * 1.5)) * exAmp;
    gains = NamedControl.kr(\gains, Array.fill(maxModes, 1)).lag(glide);
    amps  = NamedControl.kr(\amps,  Array.fill(maxModes, 0));
    body  = DynKlank.ar(`[ NamedControl.kr(\freqs, Array.fill(maxModes, 100)),
                           gains * amps,
                           NamedControl.kr(\rings, Array.fill(maxModes, 1)) ], bow);
    body  = (body / maxModes.sqrt) * droneAmp;

    // THE WOODBLOCK. A pulsaret train. 2.76 is deliberately inharmonic - a woodblock's
    // second mode - so it reads as wood rather than as a musical note.
    // claveGlide, NOT glide - same reasoning as the formant below. The tick rate is a
    // property of the ROW and must SNAP. Lagging it by the drone's morph (raised to 4.0 for
    // the slow arrival) slid the TEMPO over ~2-3 seconds on every navigation, 2 to 25 ticks
    // long depending on rate, which reads as the metre sagging rather than as a new metre.
    // The drone glides; the clave does not.
    trig   = Impulse.ar(Lag.kr(claveRate, claveGlide));
    // the accent counter is NOT lagged: a fractional modulus would scramble which tick is
    // accented, and a bar line that drifts is worse than one that jumps.
    cnt    = PulseCount.ar(trig) % claveAccent.max(1);
    accent = 1.0 + ((cnt < 0.5) * claveAccentBoost);
    cenv   = Decay2.ar(trig * accent, 0.0004, claveDecay);
    // claveGlide, NOT glide: the formant is a property of the ROW and must SNAP. Lagging it
    // by the drone's 1.2 s morph made one row sound eight different pitches on its way in.
    ff       = Lag.kr(claveFormant, claveGlide);
    pulsaret = SinOsc.ar(ff) + (0.45 * SinOsc.ar(ff * 2.76)) + (0.12 * WhiteNoise.ar(1));
    clave    = pulsaret * cenv * Lag.kr(claveAmp, 0.08);

    // THE ROOM. One comb, tuned once per selection and NEVER swept - sweeping it would be a
    // pitch glide, a different and lying gesture. Navigation moves the DECAY, not the delay.
    roomIn = body + (clave * claveSend);
    room   = CombC.ar(roomIn, 0.05, combDelay, Lag.kr(combDecay, glide));
    sig    = (body * 0.35) + (room * 0.85) + (clave * claveDry);
    Out.ar(out, Pan2.ar(LeakDC.ar(sig) * env, 0));
}).add;

// ---- LAYER 3: one sustaining voice per species -----------------------------
// A species is a NOTE, not a bird: the corpus plays the real recording, and if this layer
// imitated birdsong you could not tell the machine's claim from the evidence.
// Confidence is AUDIBLE rather than a silent gate - an unsure detection splits into a
// beating pair and breathes through a band of noise at its own pitch.
SynthDef(\rwArp, { |out = 0, freq = 440, amp = 0.1, cert = 0.8, gate = 1,
                   atk = 0.02, rel = 0.5, arpGain = 1.0, maxDur = 25|
    var env, unc, det, tone, click, sig, deadline;
    // A NOTE CANNOT OUTLIVE ITS CHORD. The gate-off comes from the language, over UDP, from a
    // list of held references - so it can be lost, and a sustaining Env.asr with no gate-off
    // never frees. That happened: 37 orphaned voices on a live server (2026-09-23). The
    // deadline makes the failure self-correcting rather than permanent. It sits well beyond
    // any real chord (~rwArpSustain plus the longest assembly), so it never shortens a note
    // that is behaving.
    deadline = EnvGen.kr(Env([1, 1, 0], [maxDur, 0.01]));
    env = EnvGen.kr(Env.asr(atk, 1, rel, curve: -3), gate * deadline, doneAction: 2);
    unc = (1.0 - cert).clip(0.0, 1.0);
    det = unc * 0.030;                                   // up to ~50 cents of splitting
    tone = (SinOsc.ar(freq * (1 - det) * (1 + (LFNoise2.kr(0.6) * unc * 0.006)))
          + SinOsc.ar(freq * (1 + det) * (1 + (LFNoise2.kr(0.5) * unc * 0.006)))
          + (SinOsc.ar(freq * 2) * 0.30)
          + (SinOsc.ar(freq * 3) * 0.16)
          + (SinOsc.ar(freq * 4) * 0.07)) * 0.32;
    // a mallet transient at note-on. Without it a 450 ms swell had no onset and the ear
    // folded the whole layer into the drone.
    click = Decay2.ar(Impulse.ar(0), 0.0006, 0.055)
          * BPF.ar(PinkNoise.ar(1), (freq * 2).clip(40, 16000), 0.35) * 1.6;
    sig = (tone + click + (BPF.ar(PinkNoise.ar(1), freq, 0.06) * unc * 1.1)) * amp * arpGain;
    Out.ar(out, Pan2.ar(sig * env, 0));
}).add;

// ---- LAYER 4: the tape -----------------------------------------------------
// The only layer that is not a representation. A mono PlayBuf on loop through a faint comb
// that glues it into the same air. 0.5 s attack, matching the arp's 0.5 s release, so the
// evidence arrives as the claim lets go rather than after it has gone.
// Buffers MUST be read with Buffer.readChannel channels:[0]: every clip is stereo, and
// handing a stereo buffer to a 1-channel PlayBuf is the "expected 1, yet buffer has 2"
// failure that silently killed corpus mode for months.
SynthDef(\rwCorpus, { |out = 0, buf = 0, amp = 0.0, rate = 1, gate = 1, corpusGain = 1.0|
    var env, sig;
    env = EnvGen.kr(Env.asr(0.5, 1, 0.7), gate, doneAction: 2);
    sig = PlayBuf.ar(1, buf, rate * BufRateScale.kr(buf), loop: 1);
    sig = LeakDC.ar(sig);
    sig = sig + (0.18 * CombL.ar(sig, 0.05, 0.028, 1.4));
    // its own limiter: this voice does not pass through the drone's, and the raw clips span
    // about 24 dB, so an unlimited path clipped at 0.0 dBFS on the loudest of them.
    Out.ar(out, Pan2.ar(Limiter.ar(sig * amp * corpusGain * env, 0.9, 0.01), 0));
}).add;

// The RETURNER: the month's phenologically surprising species, a bird back after an
// absence or a first record. Its own voice rather than a second focal clip, so you can
// tell the community's anchor from its news: a slower swell, a brighter comb, and high-
// passed clear of the drone. Carried over from v1's \rwReturner.
SynthDef(\rwReturner, { |out = 0, buf = 0, amp = 0.0, rate = 1, gate = 1, corpusGain = 1.0|
    var env, sig;
    env = EnvGen.kr(Env.asr(0.9, 1, 1.1), gate, doneAction: 2);   // slower = a spotlight
    sig = PlayBuf.ar(1, buf, rate * BufRateScale.kr(buf), loop: 1);
    sig = LeakDC.ar(sig);
    sig = sig + (0.28 * CombL.ar(sig, 0.09, 0.043, 2.2));
    sig = HPF.ar(sig, 220);                                        // lift clear of the drone
    Out.ar(out, Pan2.ar(Limiter.ar(sig * amp * corpusGain * env, 0.9, 0.01), 0));
}).add;

// ---- master ----------------------------------------------------------------
SynthDef(\rwLimiter, { |in = 0, out = 0, masBus = 0|
    var sig = In.ar(in, 2) * In.kr(masBus).lag(0.05);
    Out.ar(out, Limiter.ar(sig, 0.9, 0.01));
}).add;

"[rw] v2 synths added: rwContinuous (drone+clave), rwArp, rwCorpus, rwReturner, rwLimiter".postln;
