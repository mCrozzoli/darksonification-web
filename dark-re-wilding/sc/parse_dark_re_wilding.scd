// GENERATED by web_implementation/build/build_web.py from sc/parse_dark_re_wilding.scd — do not edit here.
// Source sha256 c351ebfe6a94a6f7; no substitution. The boot file is replaced by engine.js PRELUDE.
// dark_re_wilding - SC engine v2: OSC protocol + the navigation timeline.
// Load AFTER dark_re_wilding_synths.scd. v1 archived under sc/_v1_archive/.
//
// PROTOCOL
//   /rw_identity [level, subset, comb, baseFreq, claveBase, n, f0..f(n-1), a0..a(n-1),
//                 rest0..rest(n-1)]                          -> 6 + 3n args, n sent EXPLICITLY
//        Sent on SELECTION CHANGE only, not per navigation (P54 V1, 2026-10-04: also on a reading
//        switch, and around an off-reading legend hold, wherever the two readings' bodies differ -
//        the bridge keys the identity on the body, see viz/rw_core.py rw_send_identity / rw_preview_hold;
//        each such send carries its /rw_drone or /rw_preview drone in the same burst). Carries the subset's whole
//        mode table AND the body it rests in, so navigation afterwards is a handful of
//        floats. This is the payoff of subsets being a design-time decision: SH order costs
//        preprocessing, not latency.
//        `n` is on the wire because 6+2n and 6+3n collide for some n, and a guessed count
//        would read the amps out of the middle of the freq block with no error anywhere.
//        The resting gains are the per-mode geometric mean of the subset's MONTH states,
//        pinned (dev/precompute/sh_identity.py) - the body a selection holds before any
//        point inside it is committed.
//        Every subset currently sends the full 35 modes. A shorter array is still legal:
//        modes past `n` are zero-padded (amp 0, so silent) and their resting gain is 1.
//   /rw_drone  [theta, pressure, g0..gN]   state: which modes ring, how hard the point presses
//   /rw_clave  [rate, formant, accent]     state: tempo, pulsaret colour, metre (accent per bar)
//   /rw_arp    [noteGap, n, f,a,c, ...]    state: the chord, low to high. n may be 0.
//   /rw_corpus ["path"] or []              state: the focal clip, or silence
//   /rw_point  []                          COMMIT - runs the timeline with whatever state arrived
//   /rw_mix    [drone, clave, arp, corpus] the four faders, 0..1
//   /rw_master ["vol", 0..1] | ["mute", 0|1]
//
//   The four state messages may arrive in any order; /rw_point is what makes them sound.
//   Committing separately means a half-delivered point can never be played.
(
var maxModes = 35;

~rwBus        = ~rwBus        ? Bus.audio(s, 2);
~rwMasterBus  = ~rwMasterBus  ? Bus.control(s, 1).set(1);
~rwLevel      = "L1";
~rwSubset     = "";
~rwBar        = 1.0;            // current point's clave bar length, seconds
~rwClips      = ~rwClips ? IdentityDictionary.new;   // path -> Buffer (LRU-ish cache)
~rwClipOrder  = ~rwClipOrder ? List.new;
~rwClipMax    = 24;

// Level-dependent defaults (Miguel 2026-09-22): L0 opens with the arp and corpus SILENT.
// An L0 row is a month - a top-20 species list aggregated over thirty days, and one clip
// standing for all of them - which is a far weaker claim than an L1 window's. The months
// give you the acoustic character, measured; the machine's claims arrive only when you
// drill into a window. The data is built either way, because the listener can raise these.
~rwMixDefaults = (
    L1: (drone: 1.0, clave: 1.0, arp: 1.0, corpus: 1.0),
    L0: (drone: 1.0, clave: 1.0, arp: 0.0, corpus: 0.0)
);
~rwMix = ~rwMix ? ~rwMixDefaults[\L1].copy;
// Is a clave SOUNDING right now? The clave shares \rwContinuous with the drone and its amp is
// gated by the navigation timeline, so the mixer has to know before it can scale it. Must be a
// Boolean from the start - `nil.if` is an error, not a false.
~rwClaveOn = false;

// Fixed levels the faders scale. Set by measurement, see dev/README.md.
// The drone had no level constant of its own, because the fader WAS its level. It needs one
// now: pinning rendered power (2026-09-23) removed a 3-4 dB duck that every navigated point
// used to carry, so the drone came out about 4-6 dB louder and the loudest points crossed
// 0 dBFS on their own, which would have the limiter working on every bright window. -3.5 dB
// puts the absolute loudness back where it was approved while keeping the flattening.
// P54 V1 (2026-10-04, fix round 3): 0.67 -> 0.58 (-1.25 dB), APPLIED WITH THE V1 TABLES (the level ships
// with the data, never apart: apply_level.py). Chosen by measurement under Miguel's delegation: the standard
// walks for air and water x gradient and variance x L0 and L1 (L0: year:2024, rest -> March -> July ->
// November 2024; L1: all:2023-2026, eight windows over the gradient rank), drone alone, offline through this
// file's ported engine (scsynth -N, seed 4), PRE-LIMITER. The median integrated loudness of the 8 V1 walks
// at 0.58 is -16.53 LUFS against -16.50 for the 8 pre-P54 walks at 0.67 (rule: within 0.5 LU), and no
// sample of any V1 walk exceeds 0.73, under the 0.9 limiter (the highest level with none above 0.9 is 0.71).
// NOT UNIFORM: per walk the change against pre-P54 runs from -4.8 LU (air gradient L0) to +2.3 LU (water
// gradient L1); the median of the per-walk differences is -2.0 LU. Record:
// dev/renders/p54_options/meas/walks8.json and walks8_check_0.580.json (dev/precompute/p54/meas/meas_level.py
// walks8). The pre-P54 value is 0.67 if it must go back (with the tables).
~rwDroneLevel  = 0.58;
~rwArpLevel    = 0.17;
~rwClaveLevel  = 0.10;
~rwCorpusLevel = 0.85;
~rwCorpusNorm  = 0.9;           // clips span ~24 dB; peak-normalise so the LAYER sets level

// timeline constants (dev/README.md "How the four enter")
~rwClaveIn     = 2.0;           // seconds after the point commits
~rwClaveTarget = 8.5;           // the clave runs the whole number of bars nearest this
~rwArpFloor    = 1.2;           // arp waits 2 bars, but never less than this
// An L0 chord is TWENTY sustained tones against L1's eight, so the same 2 s sustain is a very
// different object at the two levels - measured 3.8 dB louder and eight seconds of held bottom
// note. Shortened so a navigation gesture resolves inside itself; the corpus still fades in
// across the release, which is shortened to match.
//
// THE SUSTAIN IS THE PLATEAU, and the plateau is one of Miguel's two numbers (2026-09-25:
// "the full chord, when all notes are playing, 1 or 2 seconds top"). chordOff = lastIn +
// ~rwArpSustain, so this control IS the time every note sounds together before the release
// begins - measured 0.788-0.837 s against the nominal 0.8, i.e. the schedule tracks it to
// within 4%. 1.2 sits mid-band and leaves the most budget for the assembly, which is the
// half of the gesture that was over-long. THIS NUMBER IS DUPLICATED in
// dev/precompute/arp_species.py (SC_ARP_SUSTAIN) - the gap law spends 5.0 s minus this minus
// the release on assembly, so the two must move together or the 5 s cap is wrong.
// The L0 worry above is better served, not worse: the bottom note is now held for assembly +
// sustain <= 3.22 + 1.2 = 4.42 s at L0, against the 7.27 s it was.
~rwArpSustain  = 1.2;
~rwArpRelease  = 0.4;           // measured 0.385-0.42 s; behaves exactly, left alone

// Arp and corpus voices free THEMSELVES (doneAction: 2) once their release finishes, so a
// held reference can outlive the node. Setting a freed node is harmless to the audio but
// prints "FAILURE IN SERVER /n_set Node NNNN not found", which is noise that would hide a
// real fault. That is why this used to read `nd.notNil and: { nd.isPlaying }`.
//
// It was the wrong trade, and it LEAKED VOICES. `isPlaying` is false from creation until the
// server's /n_go round-trips, and NodeWatcher skips its own `assumePlaying` whenever a
// recycled node ID is still sitting in its table - so a LIVE voice can read as dead. When it
// does, its gate-off is skipped, and an Env.asr voice with no gate-off holds at gate 1 and
// never frees. Worse, it is self-reinforcing: the leaked node's ID never leaves NodeWatcher's
// table, so the next node to be given that ID is born reading as dead too.
// MEASURED on the live server 2026-09-23 (/g_queryTree): 37 orphaned \rwArp nodes stacked up,
// which is what Miguel heard as "drones accumulating", and what buried the corpus under them.
//
// The two costs are not symmetric. Gating a node that has already freed prints one harmless
// warning. Skipping a gate-off loses a voice for the rest of the session. So liveness now
// means "we still hold a reference"; \rwArp additionally carries its own timeout so this
// class of fault can never leak again.
~rwAlive = { |nd| nd.notNil };
~rwWatch = { |nd| NodeWatcher.register(nd, true); nd };

// DEATHS ARE SAFE TO TRUST; BIRTHS ARE NOT. That asymmetry is the whole bug above: asking
// whether a node is playing races /n_go, so it can answer "no" about a voice that is very
// much alive. /n_end has no such race - the server sends it only once the node is really
// gone - so dropping our reference THERE can never skip a gate-off. It can only stop us
// gating a corpse, which is exactly the "/n_set Node NNNN not found" noise this file used
// to accept as the price of never leaking. Now it pays neither.
// MEASURED on the live display 2026-09-24: 16 such warnings over eight navigations before
// this, none after.
~rwEnded.notNil.if { ~rwEnded.free };            // re-running the file must not stack handlers
~rwEnded = OSCFunc({ |msg|
    var id = msg[1];
    ~rwArpNodes.notNil.if {
        ~rwArpNodes = List.newFrom(~rwArpNodes.reject { |nd| nd.nodeID == id }) };
    (~rwCorpusNode.notNil   and: { ~rwCorpusNode.nodeID   == id }).if { ~rwCorpusNode   = nil };
    (~rwReturnerNode.notNil and: { ~rwReturnerNode.nodeID == id }).if { ~rwReturnerNode = nil };
}, '/n_end', s.addr);

~rwState = ( gains: nil, pressure: 0.5, rate: 3, formant: 1200, accent: 4,
             noteGap: 0.7, notes: [], clip: nil, returner: nil );
~rwArpNodes = ~rwArpNodes ? List.new;
~rwCorpusNode = nil;
~rwReturnerNode = nil;

// ---- clip cache ------------------------------------------------------------
~rwGetClip = { |path, action|
    var b = ~rwClips[path.asSymbol];
    b.notNil.if({ action.value(b) }, {
        // channels:[0] - every clip is stereo and every voice is a mono PlayBuf.
        Buffer.readChannel(s, path, channels: [0], action: { |buf|
            ~rwCorpusNorm.notNil.if { buf.normalize(~rwCorpusNorm) };
            ~rwClips[path.asSymbol] = buf;
            ~rwClipOrder.add(path.asSymbol);
            (~rwClipOrder.size > ~rwClipMax).if {
                var old = ~rwClipOrder.removeAt(0);
                ~rwClips[old].free; ~rwClips[old] = nil;
            };
            action.value(buf);
        });
    });
};

// ---- the persistent body ---------------------------------------------------
~rwStart = {
    ~rwBody.isNil.if {
        ~rwLimiterNode = Synth.tail(s, \rwLimiter, [\in, ~rwBus, \out, 0, \masBus, ~rwMasterBus]);
        ~rwBody = ~rwWatch.value(
            Synth.head(s, \rwContinuous, [\out, ~rwBus, \droneAmp, ~rwDroneLevel * ~rwMix[\drone]]));
        "[rw] engine up".postln;
    };
};

// ---- OSC: identity (selection change) --------------------------------------
// THREE arrays of n, not two (2026-09-23): freqs, amps, and the subset's RESTING gains -
// the body a selection holds once it has been chosen and before any point inside it has
// been committed. It rests at the subset's own average rather than at a flat 1.0, so
// landing on a point is a rise out of how this selection typically rings.
// The mode count is now sent EXPLICITLY (msg[6]) instead of inferred from the message
// length: with two arrays 6+2n and with three 6+3n collide for some n, and guessing wrong
// reads the amps out of the middle of the freq block - a body on the wrong table, with no
// error anywhere. A mismatch here means the bridge and this engine are out of step, which
// after a table rebuild means: RESTART THE ENGINE.
OSCdef(\rwIdentity, { |msg|
    var lvl = msg[1].asString, sub = msg[2].asString;
    var comb = msg[3].asFloat, n, freqs, amps, rings, rest, amax;
    n = msg[6].asInteger;
    ((n < 1) or: { msg.size != (7 + (3 * n)) }).if {
        ("[rw] /rw_identity IGNORED: " ++ n ++ " modes needs " ++ (7 + (3 * n))
            ++ " args, got " ++ msg.size ++ ". Bridge and engine are out of step - "
            ++ "reboot the engine (sc/parse_dark_re_wilding.scd).").postln;
    };
    ((n > 0) and: { msg.size == (7 + (3 * n)) }).if {
        freqs = Array.fill(maxModes, { |i| (i < n).if({ msg[7 + i].asFloat }, { 100 }) });
        amps  = Array.fill(maxModes, { |i| (i < n).if({ msg[7 + n + i].asFloat }, { 0 }) });
        // a mode past the sent count has amp 0 and contributes nothing, so its resting gain is
        // the SynthDef's own default of 1 - it cannot be heard either way.
        rest  = Array.fill(maxModes, { |i| (i < n).if({ msg[7 + (2*n) + i].asFloat }, { 1 }) });
        amax  = amps.maxItem.max(1e-9);
        // the body's ringing character is IDENTITY: derived from the base amps, held fixed.
        rings = amps.collect { |a| 0.8 + (6.0 * (a / amax)) };
        ~rwStart.value;
        ~rwBody.setn(\freqs, freqs, \amps, amps, \rings, rings);
        // THE RESTING BODY. Safe to set unconditionally: the bridge sends an identity only when
        // the SELECTION changes, so a point press inside an unchanged selection never reaches
        // here, and a selection change that carries a point re-sends /rw_drone + /rw_point in
        // the same burst - the gains lag (4 s) has not moved a measurable amount in between.
        // (P54 V1, 2026-10-04: the bridge also sends one when the READING switches on a sounding
        // point, and when an off-reading legend hold starts and is released, wherever the two
        // readings' bodies differ. Each is followed in the same burst by /rw_drone + /rw_point or
        // by /rw_preview drone, so the resting gains set here are overwritten before they sound.)
        ~rwBody.setn(\gains, rest);
        ~rwBody.set(\combDecay, 0.10 + (0.45 * 0.5));   // rest sits mid-travel
        ~rwBody.set(\combDelay, 1.0 / comb.max(20));
        (lvl != ~rwLevel).if {
            ~rwLevel = lvl;
            ~rwMix = ~rwMixDefaults[lvl.asSymbol].copy;     // level defaults, see above
            ("[rw] level -> " ++ lvl ++ "  mix " ++ ~rwMix).postln;
        };
        ~rwSubset = sub;
        ~rwSaidNoIdentity = nil;                 // the table is here; the warning may fire again
        ("[rw] identity " ++ lvl ++ ":" ++ sub ++ "  " ++ n ++ " modes, comb "
            ++ comb.round(0.1) ++ " Hz, resting on the subset average").postln;
    };
}, '/rw_identity');

// ---- OSC: per-point state --------------------------------------------------
OSCdef(\rwDrone, { |msg|
    ~rwState[\theta] = msg[1].asFloat;
    ~rwState[\pressure] = msg[2].asFloat;
    ~rwState[\gains] = Array.fill(maxModes, { |i| ((3 + i) < msg.size).if({ msg[3 + i].asFloat }, { 0 }) });
}, '/rw_drone');

OSCdef(\rwClave, { |msg|
    ~rwState[\rate] = msg[1].asFloat.max(0.1);
    ~rwState[\formant] = msg[2].asFloat;
    ~rwState[\accent] = msg[3].asInteger.max(1);
}, '/rw_clave');

OSCdef(\rwArp, { |msg|
    var n = msg[2].asInteger, out = List.new;
    ~rwState[\noteGap] = msg[1].asFloat.max(0.02);
    n.do { |i| out.add([ msg[3 + (i*3)].asFloat, msg[4 + (i*3)].asFloat, msg[5 + (i*3)].asFloat ]) };
    ~rwState[\notes] = out.asArray;
}, '/rw_arp');

OSCdef(\rwCorpus, { |msg|
    ~rwState[\clip] = (msg.size > 1).if({
        (msg[1].asString.size > 0).if({ msg[1].asString }, { nil })
    }, { nil });
    // the month's returner, when it has one and it is not the same recording as the focal
    ~rwState[\returner] = (msg.size > 2).if({
        (msg[2].asString.size > 0).if({ msg[2].asString }, { nil })
    }, { nil });
}, '/rw_corpus');

OSCdef(\rwMix, { |msg|
    ~rwMix[\drone] = msg[1].asFloat; ~rwMix[\clave]  = msg[2].asFloat;
    ~rwMix[\arp]   = msg[3].asFloat; ~rwMix[\corpus] = msg[4].asFloat;
    ~rwAlive.value(~rwBody).if {
        ~rwBody.set(\droneAmp, ~rwDroneLevel * ~rwMix[\drone]);
        // THE CLAVE TOO. It was missing, so its fader only took effect when the NEXT clave
        // started - Miguel: "it changes the volume for the clave when it starts, not while it
        // is playing". The clave rides on the same node as the drone but its amp is gated by
        // the timeline, so scale it only while one is actually sounding; setting it
        // unconditionally would restart a clave the timeline had already stopped.
        ~rwClaveOn.if { ~rwBody.set(\claveAmp, ~rwClaveLevel * ~rwMix[\clave]) };
    };
    // FILTER WITHOUT CHANGING THE SPECIES. Drop dead references as we go, so the list cannot
    // grow without bound - but `~rwArpNodes` is a List and `List:select` returns an ARRAY,
    // not a List (evaluated, sclang 3.13.0: List[1,2,3].select({true}).class -> Array,
    // isKindOf(List) = false). `Array:add` mutates in place only while spare capacity remains
    // - capacity is the next power of two - and once full it returns a NEW array, which the
    // Routine's bare `~rwArpNodes.add(...)` discards. So one fader move mid-chord silently
    // stopped the REST of that chord from ever entering the list.
    // MEASURED on the live engine 2026-09-25, 8-note chord, arp fader 0.40: a move made before
    // the first note tracked 1 note of 8; a move at 3 notes left half the chord 16.5 dB above
    // where the fader said (four nodes at 0.0255, four still at 0.1700). It worked only once
    // the whole chord was already up - a 0.8 s window out of a 4.7-7.9 s gesture, which is
    // Miguel's "arp fader not working properly".
    // The untracked nodes also missed their gate-off at the next commit (7 of 8 left to the
    // \rwArp maxDur backstop) - the 2026-09-23 voice-leak class re-entering by another door.
    // It looked intermittent because ANY arp node ending repairs the type: the /n_end handler
    // above wraps its reject in List.newFrom, so a test that navigates between fader moves
    // sees nothing wrong. Same wrapper here, same reason. With it every later add sticks.
    ~rwArpNodes = List.newFrom(~rwArpNodes.select { |nd| ~rwAlive.value(nd) });
    ~rwArpNodes.do { |nd| nd.set(\arpGain, ~rwArpLevel * ~rwMix[\arp]) };
    // A HELD LEGEND CHIP HAS ITS OWN CHORD, and this handler never reached it: while a chip
    // was held the arp fader did nothing at all. MEASURED: preview chord up at 0.0680 across
    // 8 nodes, /rw_mix arp=1.00 sent, all eight still 0.0680. Iterate only - that list's
    // lifecycle (pruning, species, clearing) belongs to sc/rw_preview.scd, which keeps it a
    // real List with its own List.newFrom on /n_end. Guarded for notNil because rw_preview.scd
    // loads AFTER this file and the parser can be run without it.
    ~rwPreviewArpNodes.notNil.if {
        ~rwPreviewArpNodes.do { |nd|
            ~rwAlive.value(nd).if { nd.set(\arpGain, ~rwArpLevel * ~rwMix[\arp]) } } };
    ~rwAlive.value(~rwCorpusNode).if {
        ~rwCorpusNode.set(\corpusGain, ~rwCorpusLevel * ~rwMix[\corpus]) };
    ~rwAlive.value(~rwReturnerNode).if {
        ~rwReturnerNode.set(\corpusGain, ~rwCorpusLevel * ~rwMix[\corpus]) };
}, '/rw_mix');

OSCdef(\rwMaster, { |msg|
    (msg[1].asString == "vol").if({ ~rwMasterBus.set(msg[2].asFloat) },
                                  { ~rwMasterBus.set((msg[2].asInteger == 1).if(0, 1)) });
}, '/rw_master');

// ---- COMMIT: the navigation timeline ---------------------------------------
// drone continuous -> clave in and out -> arp assembles, sustains, releases -> corpus
// crossfades in across that release and runs until the next point.
OSCdef(\rwPoint, { |msg|
    var st = ~rwState, bar, barSched, bars, claveStop, arpAt, lastIn, chordOff;
    ~rwStart.value;
    // A COMMIT CANCELS ANY PREVIEW. The bridge sends /rw_preview ["end"] before every commit,
    // so this is belt-and-braces - but a page that dies with a chip held sends nothing, and a
    // stranded preview chord or a stuck clave would outlive it. Guarded because rw_preview.scd
    // loads after this file and someone may run the parser without it.
    ~rwPreviewClear.notNil.if { ~rwPreviewClear.value };
    // A POINT BEFORE ANY IDENTITY IS A BODY ON THE WRONG TABLE. The bridge sends the mode
    // table only when the selection changes, so restarting this engine under a display that
    // is already running leaves the drone on the SynthDef's flat defaults: it still sounds,
    // and every point sounds alike. That is the one failure here that is inaudible as a
    // failure, so it is stated rather than left to be discovered by ear.
    // ~rwSubset is born "" (line 34) and only ever written by the identity handler, so an
    // empty one means no table has ever landed - not nil, which is why this reads isEmpty.
    (~rwSubset.isNil or: { ~rwSubset.isEmpty }).if {
        ~rwSaidNoIdentity ?? {
            ("[rw] WARNING: a point arrived before any identity. The engine was restarted "
                ++ "under a live display, so it holds no mode table and the drone is on flat "
                ++ "defaults. Reload the display page - the bridge re-sends the body on a "
                ++ "fresh connection.").postln;
            ~rwSaidNoIdentity = true;            // once per restart, not once per press
        };
    };
    ~rwRoutine.notNil.if { ~rwRoutine.stop };
    // THE CLAVE BELONGS TO THE POINT YOU ARE LEAVING, so it stops here with the routine that
    // scheduled it. Stopping the routine alone was not enough: claveAmp is a control on the
    // shared \rwContinuous node, so the previous point's tick kept sounding - at its own rate -
    // until the NEW routine reached ~rwClaveIn about 2 s later. The order is drone, then clave,
    // then arp, then corpus; navigating restarts that order rather than overlapping it.
    ~rwClaveOn = false;
    ~rwBody.notNil.if { ~rwBody.set(\claveAmp, 0) };
    // release the previous chord immediately (the corpus is stopped too - see below).
    ~rwArpNodes.do { |nd| ~rwAlive.value(nd).if { nd.set(\gate, 0) } };
    ~rwArpNodes = List.new;
    ~rwArpCut = false;                  // a new point, a new chord (see the note loop below)
    // The corpus is EVIDENCE FOR THE POINT YOU WERE ON. Leaving it running under a new
    // point's drone would attribute one window's recording to another, so it stops here
    // rather than waiting for a replacement that may never arrive: if you navigate before
    // the timeline reaches its corpus step (about 12 s in), the routine is cancelled and
    // no new clip is ever started. That is why the first clip used to keep playing forever.
    ~rwAlive.value(~rwCorpusNode).if { ~rwCorpusNode.set(\gate, 0) };
    ~rwAlive.value(~rwReturnerNode).if { ~rwReturnerNode.set(\gate, 0) };
    ~rwCorpusNode = nil; ~rwReturnerNode = nil;

    st[\gains].notNil.if { ~rwBody.setn(\gains, st[\gains]) };
    ~rwBody.set(\combDecay, 0.10 + (0.45 * st[\pressure].clip(0, 1)));

    bar = st[\accent] / st[\rate];
    // SCHEDULE off a BOUNDED bar. `bar` is accent/rate, and the precompute clips rate to
    // [0.8, 9.0] Hz and accent to [2, 7] INDEPENDENTLY - so a 0.8 Hz tick can carry a 7-tick
    // accent and one bar becomes 8.75 s. Measured over the 614 L0 points: 0.222 s to 8.051 s.
    // Everything downstream inherits it, which is three symptoms from one number: the arp
    // waits two bars (up to 16 s before the first note), the clave runs whole bars past its
    // target, and the chord ends after the clave has stopped. The AUDIBLE clave keeps its real
    // rate and accent - only the scheduling is bounded, so a metre that is too slow to be felt
    // as a metre stops being used as a clock.
    barSched = bar.clip(0.25, 1.6);
    bars = max(2, (~rwClaveTarget / barSched).round(1).asInteger);
    claveStop = ~rwClaveIn + (bars * barSched);
    arpAt     = ~rwClaveIn + max(~rwArpFloor, barSched * 2);
    lastIn    = arpAt + ((st[\notes].size - 1).max(0) * st[\noteGap]);
    chordOff  = lastIn + ~rwArpSustain;
    ~rwBar = bar;

    ~rwRoutine = Routine({
        ~rwClaveIn.wait;
        // A HELD PREVIEW OWNS THE CLAVE (the class of P38; review 2026-09-27). Written blind, this
        // step undid a clave row's pushed tempo and a drone row's "claveoff" mute mid-hold - and
        // the hold's record of the tick (~rwPreviewClaveWas: it was OFF, before clave-in) then made
        // the release mute the tick this step had just started, for the rest of the point. Under
        // a hold: leave what the hold set, carry THIS point's values when the tick is not forced
        // on (so the revived tick is not the previous point's), and record that the tick is now
        // due, so ~rwPreviewClear revives it on release. ~rwPreviewClaveWas is nil with no hold
        // (and when rw_preview.scd is not loaded), so outside a hold this is the old step.
        ~rwPreviewClaveWas.isNil.if({
            ~rwBody.set(\claveRate, st[\rate], \claveFormant, st[\formant],
                        \claveAccent, st[\accent],
                        \claveAmp, ~rwClaveLevel * ~rwMix[\clave]);
            ~rwClaveOn = true;
        }, {
            (~rwClaveOn != true).if {
                ~rwBody.set(\claveRate, st[\rate], \claveFormant, st[\formant],
                            \claveAccent, st[\accent]) };
            ~rwPreviewClaveWas = true;
        });

        (arpAt - ~rwClaveIn).wait;
        st[\notes].do { |nt, i|
            (i > 0).if { st[\noteGap].wait };
            // A HELD PREVIEW CHORD REPLACES THIS ONE (TASKS P38). The legend's "chord" preview
            // gates the notes already in (rw_preview.scd) but this routine kept spawning the
            // rest UNDER the preview - the A/B of one chord was two. So: no note spawns while a
            // preview chord is held, and once one has cut into the chord the rest of it is not
            // played either - a chord is one gesture, and its tail alone is not the chord. A
            // hold released before the first note leaves the chord to arrive as it would have.
            (~rwPreviewChordOn == true).if { ~rwArpCut = true };
            (~rwArpCut != true).if {
                ~rwArpNodes.add(~rwWatch.value(
                    Synth(\rwArp, [\out, ~rwBus, \freq, nt[0], \amp, nt[1],
                                   \cert, nt[2], \rel, ~rwArpRelease,
                                   \arpGain, ~rwArpLevel * ~rwMix[\arp]])));
            };
        };

        ~rwArpSustain.wait;
        ~rwArpNodes.do { |nd| ~rwAlive.value(nd).if { nd.set(\gate, 0) } };
        // the corpus fades in ACROSS that release, 0.5 s against 0.5 s: the evidence
        // arrives as the claim lets go, not after it has gone.
        st[\clip].notNil.if {
            ~rwGetClip.value(st[\clip], { |buf|
                ~rwCorpusNode = ~rwWatch.value(Synth.head(s, \rwCorpus,
                    [\out, ~rwBus, \buf, buf, \amp, 1.0,
                     \corpusGain, ~rwCorpusLevel * ~rwMix[\corpus]]));
            });
        };
        st[\returner].notNil.if {
            ~rwGetClip.value(st[\returner], { |buf|
                ~rwReturnerNode = ~rwWatch.value(Synth.head(s, \rwReturner,
                    [\out, ~rwBus, \buf, buf, \amp, 0.82,
                     \corpusGain, ~rwCorpusLevel * ~rwMix[\corpus]]));
            });
        };

        (claveStop - chordOff).max(0).wait;
        // the same under a hold: a held clave keeps sounding, and the release restores the stop
        ~rwPreviewClaveWas.isNil.if({
            ~rwClaveOn = false;
            ~rwBody.set(\claveAmp, 0);          // the clave stops on a downbeat
        }, { ~rwPreviewClaveWas = false });
    }).play(SystemClock);

    ("[rw] point  theta " ++ st[\theta].round(0.001)
        ++ "  clave " ++ st[\rate].round(0.01) ++ " Hz " ++ st[\accent] ++ "/8 x" ++ bars
        ++ " bars  arp " ++ st[\notes].size ++ "sp"
        ++ "  corpus " ++ st[\clip].notNil.if("yes", "silent")
        ++ st[\returner].notNil.if(" +returner", "")).postln;
}, '/rw_point');

"[rw] v2 parser ready. /rw_identity /rw_drone /rw_clave /rw_arp /rw_corpus /rw_point /rw_mix /rw_master".postln;
)
