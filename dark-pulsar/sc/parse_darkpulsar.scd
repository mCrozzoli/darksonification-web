// GENERATED by web_implementation/build/build_web.py from sc/parse_darkpulsar.scd — do not edit here.
// Source sha256 e1784cfa1bd1e9bc; UNMODIFIED (web_buffers.scd, loaded after it, overrides ~swapWt only).
// darkpulsar - OSC parser. Receives the GUI's navigation on /dark_sonification.
//
// Wire format (darksonification send_ds_row): flat [name, value, name, value, ...]
// after msg[0] (the address). Names at odd indices, floats at even indices.
//
// ALL the perceptual arithmetic lives in TWO cooking fns so the LIVE nav
// (/dark_sonification), the STANDALONE nav (/dark_nav, bridge-relayed when no GUI),
// and the LEGEND preview (/dark_legend) all sound IDENTICAL:
//   ~cookL0(driverDict)        -> the Helmuth-style GRAIN CLOUD (~grainVoice)
//   ~cookL1(parentIdx, phase)  -> one POLYPHONIC real-rate audification voice (+ spotlight)
//
// L0 tick: carries `original_idx` + pitch/loud/cutoff/field/energy/age (population).
// L1 tick: carries `phase`/`intensity`, NO `pitch`, one per selected parent (drill).
(
OSCdef(\darkPulsar).free;
OSCdef(\darkPulsarNav).free;
OSCdef(\darkLegend).free;
OSCdef(\darkMaster).free;
~curIdx = -1;
~tick = 0;
~l1tick = 0;
~legPulse = nil;        // dedicated legend preview voice (layer solo)

// --- legend / standalone state (Stage 2 + 6 plug in here) ------------------------
~previewOn = false;     // a held legend preview wins over live nav until release
~liveMute  = false;     // the page can mute LIVE sound (legend previews still sound)
// L0 driver order — shared with the bridge /dark_nav vector + the legend 'row' vector
~l0Drivers = [\pitch, \energy, \cutoff, \field, \age, \loud];
~lastL0 = Dictionary.newFrom([
    \pitch, 0.5, \energy, 0.5, \cutoff, 0.5, \field, 0.5, \age, 0.5, \loud, 0.3]);

// --- polyphonic L1 voice pool: one \pulsarAudif per selected parent --------------
// Multi-parent L1 must LAYER (each pulsar its own period + profile + pan), not
// collapse into a single flickering voice. We keep one voice per parentIdx and free
// it when that parent stops ticking (deselected) or we return to L0.
~psVoices = Dictionary.new;   // parentIdx -> Synth
~psSeen   = Dictionary.new;   // parentIdx -> last-seen time (Main.elapsedTime)
~freeL1 = { |pidx|
    var v = ~psVoices[pidx];
    if (v.notNil) { v.set(\gate, 0) };     // ASR release + doneAction:2 -> self-free
    ~psVoices.removeAt(pidx); ~psSeen.removeAt(pidx);
};
~freeAllL1 = { ~psVoices.keys.asArray.do { |k| ~freeL1.(k) } };
// periodic sweep: free voices whose parent stopped ticking (deselected mid-L1)
if (~l1Cleanup.notNil) { ~l1Cleanup.stop };
~l1Cleanup = Routine({
    loop {
        0.3.wait;
        ~psSeen.keys.asArray.do { |pidx|
            if ((Main.elapsedTime - (~psSeen[pidx] ? 0)) > 0.45) { ~freeL1.(pidx) };
        };
    };
}).play(AppClock);

// --- swap the L0 grain cloud's live profile buffer to a pulsar -------------------
~swapWt = { |idx|
    if ((idx >= 0) and: { idx != ~curIdx }) {
        ~curIdx = idx;
        ~profiles.copyData(~wt, dstStartAt: 0, srcStartAt: idx * ~nBins, numSamples: ~nBins);
    };
};

// --- L0's period on a LOG scale ----------------------------------------------------
// Real spin periods span 1.56 ms .. 8.5 s. The data step's MinMax-LINEAR `period_s` put
// 76% of pulsars between 40 and 55 grains/s, so even slow pulsars sounded dense. `pitch`
// is therefore converted at every entry point into a LOG position from the real periods
// (synths.scd: ~periodLogPos, 0 = fastest .. 1 = slowest), so L0's sparse = L1's slow.
// Indexed paths look the pulsar up exactly; un-indexed ones (the legend's population
// mean, sent as MinMax-linear means) invert the MinMax first.
~linToLogPos = { |pn|
    if (~pMin.isNil) { (pn ? 0.5).clip(0, 1) } {
        var period = ~pMin + ((pn ? 0.5).clip(0, 1) * (~pMax - ~pMin));
        ((period.log - ~lnPmin) / (~lnPmax - ~lnPmin)).clip(0, 1)
    };
};
~logPosForIdx = { |idx, fallbackLin|
    if (~periodLogPos.notNil and: { idx >= 0 } and: { idx < ~periodLogPos.size })
        { ~periodLogPos[idx] } { ~linToLogPos.(fallbackLin) };
};

// --- Edot, B, age and flux on LOG scales too (Miguel, 2026-10-04) ------------------
// On the data step's linear scale 99% of pulsars sat in the bottom 1% of the Edot range
// (90% for age, 96% for flux, 37% for B), so the cloud's grain pitch, length, level and
// resonance barely moved across the population. Same treatment as the period: every entry
// point swaps the four for their LOG positions (synths.scd: ~drvLog), by index when there
// is one (exact), else by inverting the linear MinMax (the legend's population mean).
// The legend's iso holds keep 0 and 1, which are the same two extremes on either scale.
~drvLogKeys = [\energy, \field, \age, \loud];
~linToLogDrv = { |k, v|
    if (~drvLnMin.isNil) { (v ? 0.5).clip(0, 1) } {
        var lo = ~drvLnMin[k].exp, hi = ~drvLnMax[k].exp;
        var x = lo + ((v ? 0.5).clip(0, 1) * (hi - lo));
        ((x.log - ~drvLnMin[k]) / (~drvLnMax[k] - ~drvLnMin[k])).clip(0, 1)
    };
};
~logDrivers = { |d, idx|
    var n = if (~drvLog.notNil) { (~drvLog.size / 4).asInteger } { 0 };
    ~drvLogKeys.do { |key, k|
        d[key] = if ((idx >= 0) and: { idx < n })
            { ~drvLog[(k * n) + idx] } { ~linToLogDrv.(k, d[key]) };
    };
    d
};

// =================================================================================
//  ~cookL0 - ALL the L0 grain-cloud arithmetic, in ONE place (after Helmuth, "Letting
//  Pulsars Sing"). `d` = Dictionary with the 6 physics drivers in [0,1]. The pulsar's
//  physics drives a grain cloud reading its profile (~wt); navigating morphs texture.
// =================================================================================
~cookL0 = { |d|
    var dens, rate, gdur, amp, cutoff, rq;
    dens   = (d[\pitch]  ? 0.5).clip(0, 1).linexp(0, 1, 55, 4);      // LOG period position: MSP dense tone -> slow sparse ticks
    rate   = (d[\energy] ? 0.5).clip(0, 1).linexp(0, 1, 0.8, 2.0);   // LOG Edot: energetic -> higher/brighter grains
    gdur   = (d[\age]    ? 0.5).clip(0, 1).linlin(0, 1, 0.008, 0.030);// LOG age: young snippet -> old full playthrough
    amp    = (d[\loud]   ? 0.3).clip(0, 1).linlin(0, 1, 0.1, 0.55);  // LOG flux -> amplitude
    cutoff = (d[\cutoff] ? 0.5).clip(0, 1).linexp(0, 1, 12000, 700); // DM: distant/scattered -> duller
    rq     = (d[\field]  ? 0.5).clip(0, 1).linlin(0, 1, 0.9, 0.25);  // LOG B: strong -> resonant
    if (~liveMute and: { ~previewOn.not }) { amp = 0 };              // legend: page-muted live sound
    ~curAmp = amp; ~curCutoff = cutoff; ~curRq = rq;
    ~grainVoice.set(\dens, dens, \rate, rate, \dur, gdur, \amp, amp, \cutoff, cutoff, \rq, rq);
};

// =================================================================================
//  ~cookL1 - update/allocate ONE parent's L1 voice (POLYPHONIC). Shared by live +
//  standalone so a drill sounds identical either way. REAL-RATE AUDIFICATION:
//    rate     = THAT pulsar's TRUE spin frequency (~spinHz, 0.12-642 Hz): slow pulsars
//               tick, fast ones are tones — the Jodrell Bank approach, no remapping;
//    envelope = THAT pulsar's averaged profile, in order (its ~aaStride block);
//    spot     = the scrub phase: a SPOTLIGHT on the part of each rotation under the line;
//    pan      = a stable per-parent spread.
// =================================================================================
~l1Amp = 0.5;
~cookL1 = { |parentIdx, phase|
    var valid, nb, pan;
    valid = (parentIdx >= 0) and: { ~spinHz.notNil } and: { parentIdx < ~spinHz.size };
    if (valid) {
        nb  = if (~aaNbins.notNil) { ~aaNbins[parentIdx] } { ~nBins };
        pan = (parentIdx * 0.61803).frac * 1.6 - 0.8;                // stable golden-ratio spread
        if (~psVoices[parentIdx].isNil) {
            ~psVoices[parentIdx] = Synth(\pulsarAudif, [
                \profbuf, ~profAA, \bufOff, parentIdx * ~aaStride, \nb, nb,
                \freq, ~spinHz[parentIdx], \spot, phase.clip(0, 1), \pan, pan,
                \amp, 0, \masBus, ~masterBus
            ], ~grainVoice, \addAfter);
        };
        ~psVoices[parentIdx].set(\spot, phase.clip(0, 1), \amp, ~l1Amp);
        ~psSeen[parentIdx] = Main.elapsedTime;
    };
    ~grainVoice.set(\amp, 0);   // silence the L0 grain cloud while at L1
};

// =================================================================================
//  LIVE NAVIGATION - /dark_sonification (the GUI's OSC stream)
// =================================================================================
OSCdef(\darkPulsar, { |msg|
    var keys, vals, p;
    // --- decode the flat [name, value, ...] payload (darkquake-verified stride) ---
    keys = (1, 3 .. msg.size - 2).collect { |i| msg[i].asSymbol };
    vals = (2, 4 .. msg.size - 1).collect { |i| msg[i].asFloat };
    p = Dictionary.new;
    keys.do { |k, i| p[k] = vals[i] };

    // --- L0: a pulsar is active -> grain cloud --------------------------------
    if (p[\pitch].notNil) {
        var idx = (p[\original_idx] ? -1).asInteger;
        var d = Dictionary.newFrom([
            \pitch, (p[\pitch] ? 0.5), \energy, (p[\energy] ? 0.5), \cutoff, (p[\cutoff] ? 0.5),
            \field, (p[\field] ? 0.5), \age, (p[\age] ? 0.5), \loud, (p[\loud] ? 0.3)]);
        d[\pitch] = ~logPosForIdx.(idx, d[\pitch]);   // LOG period position (exact, by index)
        ~logDrivers.(d, idx);                         // Edot, B, age, flux: LOG positions too
        ~swapWt.(idx);
        ~lastL0 = d;                              // legend previews restore to this
        if (~previewOn.not) { ~cookL0.(d) };      // a held legend preview wins over live
        ~freeAllL1.value;                         // back at the population: tear down L1 voices

        ~tick = ~tick + 1;
        if ((~tick <= 5) or: { ~tick % 100 == 0 }) {
            ("[darkpulsar] #" ++ ~tick ++ "  idx=" ++ idx
             ++ "  pitch=" ++ d[\pitch].round(0.01) ++ "  loud=" ++ d[\loud].round(0.01)).postln;
        };
    };

    // --- L1: scrub phase -> polyphonic real-rate audification (spotlight) ------
    if (p[\pitch].isNil and: { p[\phase].notNil }) {
        var childIdx = (p[\original_idx] ? -1).asInteger;
        var parentIdx = if (childIdx >= 0) { (childIdx / ~nBins).floor.asInteger } { ~curIdx };
        ~cookL1.(parentIdx, (p[\phase] ? 0));

        ~l1tick = ~l1tick + 1;
        if ((~l1tick <= 6) or: { ~l1tick % 100 == 0 }) {
            ("[darkpulsar] L1 #" ++ ~l1tick ++ "  voices=" ++ ~psVoices.size
             ++ "  parent=" ++ parentIdx ++ "  phase=" ++ (p[\phase] ? 0).round(0.01)).postln;
        };
    };
}, '/dark_sonification');

// =================================================================================
//  STANDALONE NAVIGATION - /dark_nav (relayed by the viz bridge when NO darkui GUI is
//  in the loop). Makes the viz a SELF-CONTAINED INSTRUMENT: clicking a pulsar plays its
//  grain cloud, drilling plays its real-rate pulse — same ~cookL0/~cookL1 as live nav, so
//  it sounds identical. Fixed vectors (msg[1] = tag):
//    ["l0", idx, pitch, energy, cutoff, field, age, loud]   -> grain cloud (~cookL0)
//    ["l1", parentIdx, phase]                                -> real-rate pulse (~cookL1)
OSCdef(\darkPulsarNav, { |msg|
    var tag = msg[1].asString;
    if (tag == "l0") {
        var idx = (msg[2] ? -1).asInteger;
        var d = Dictionary.new;
        ~l0Drivers.do { |k, i| d[k] = (msg[i + 3] ? 0.5).asFloat.clip(0, 1) };
        d[\pitch] = ~logPosForIdx.(idx, d[\pitch]);   // LOG period position (exact, by index)
        ~logDrivers.(d, idx);                         // Edot, B, age, flux: LOG positions too
        ~swapWt.(idx);
        ~lastL0 = d;
        if (~previewOn.not) { ~cookL0.(d) };
        ~freeAllL1.value;
    };
    if (tag == "l1") {
        var parentIdx = (msg[2] ? -1).asInteger;
        var phase = (msg[3] ? 0).asFloat;
        ~swapWt.(parentIdx);
        ~cookL1.(parentIdx, phase);
    };
}, '/dark_nav');

// =================================================================================
//  PERCEPTUAL LEGEND - /dark_legend (preview channel; previews ALWAYS sound, even when
//  the live grain cloud is muted). ~previewOn locks out live nav while a chip is held;
//  releasing (cmd "end") restores ~lastL0. Commands (msg[1] = cmd):
//    ["iso", driverKey, value]   -> grain cloud, ONE driver at less/more, rest neutral
//    ["row", p,e,c,f,a,l, label] -> grain cloud at a full 6-driver vector (exemplar/mean)
//    ["solo", "grain"|"pulse"]   -> hear ONE voice alone (layer isolation)
//    ["mute", 0|1]               -> gate the LIVE grain cloud (previews still sound)
//    ["end"]                     -> release: restore the live timbre
// =================================================================================
OSCdef(\darkLegend, { |msg|
    var cmd = msg[1].asString;
    if (cmd == "iso") {
        var driver = msg[2].asSymbol;
        var value  = (msg[3] ? 0.5).asFloat.clip(0, 1);
        // start from the SELECTED pulsar's live drivers (so a hold = "this pulsar with
        // ONE feature pushed lower/higher", matching dark_skyr), then push the one feature.
        var d = (~lastL0 ? Dictionary.newFrom([\pitch, 0.5, \energy, 0.5, \cutoff, 0.5,
            \field, 0.5, \age, 0.5, \loud, 0.3])).copy;
        d[driver] = value;                      // ...this pulsar, with one feature lower/higher
        if (~legPulse.notNil) { ~legPulse.set(\gate, 0); ~legPulse = nil };
        ~freeAllL1.value;
        ~previewOn = true; ~cookL0.(d);
    };
    if (cmd == "row") {
        var d = Dictionary.new;
        ~l0Drivers.do { |k, i| d[k] = (msg[i + 2] ? 0.5).asFloat.clip(0, 1) };  // msg[2..7]
        d[\pitch] = ~linToLogPos.(d[\pitch]);    // page sends MinMax-linear means -> LOG position
        ~logDrivers.(d, -1);                     // ... and the same for Edot, B, age, flux
        if (~legPulse.notNil) { ~legPulse.set(\gate, 0); ~legPulse = nil };
        ~freeAllL1.value;
        ~previewOn = true; ~cookL0.(d);
    };
    if (cmd == "solo") {
        var layer = msg[2].asString;
        ~previewOn = true;
        if (layer == "grain") {
            if (~legPulse.notNil) { ~legPulse.set(\gate, 0); ~legPulse = nil };
            ~freeAllL1.value;
            ~cookL0.(~lastL0);                  // the L0 grain cloud, alone
        };
        if (layer == "pulse") {
            var pidx = if (~curIdx >= 0) { ~curIdx } { 0 };
            ~grainVoice.set(\amp, 0);           // silence the grain cloud
            if (~legPulse.isNil and: { ~spinHz.notNil }) {
                ~legPulse = Synth(\pulsarAudif, [            // this pulsar at its real rate
                    \profbuf, ~profAA, \bufOff, pidx * ~aaStride,
                    \nb, (if (~aaNbins.notNil) { ~aaNbins[pidx] } { ~nBins }),
                    \freq, ~spinHz[pidx], \spot, 0.5, \pan, 0, \amp, ~l1Amp, \masBus, ~masterBus
                ], ~grainVoice, \addAfter);
            };
        };
    };
    if (cmd == "mute") {
        ~liveMute = ((msg[2] ? 0).asInteger == 1);
        if (~previewOn.not) { ~cookL0.(~lastL0) };  // re-apply live with the new mute state
    };
    if (cmd == "end") {
        ~previewOn = false;
        if (~legPulse.notNil) { ~legPulse.set(\gate, 0); ~legPulse = nil };
        ~cookL0.(~lastL0);                          // restore the live timbre (respects mute)
    };
}, '/dark_legend');

// =================================================================================
//  MASTER gain / mute - /dark_master (the web controller's Vol + Mute). A TRUE global
//  cut: ~masterBus (synths.scd) is multiplied into EVERY voice, so this silences the
//  grain cloud, all L1 voices, AND legend previews — distinct from the legend's
//  ~liveMute (live grain only). Drives SC directly, so it works in standalone AND GUI
//  modes alike (the GUI's own master is in-house-only and inert for OSC-only designs).
// =================================================================================
~masterVol = 0.8; ~masterMuted = false;
~applyMaster = { if (~masterBus.notNil) { ~masterBus.set(if (~masterMuted) { 0 } { ~masterVol }) } };
OSCdef(\darkMaster, { |msg|
    var cmd = msg[1].asString;
    if (cmd == "vol")  { ~masterVol = (msg[2] ? 0.8).asFloat.clip(0, 1); ~applyMaster.value };
    if (cmd == "mute") { ~masterMuted = ((msg[2] ? 0).asInteger == 1); ~applyMaster.value };
}, '/dark_master');

"[darkpulsar] OSCdef \\darkPulsar listening on /dark_sonification (live nav via ~cookL0/~cookL1)".postln;
"[darkpulsar] OSCdef \\darkPulsarNav listening on /dark_nav (standalone viz nav, no GUI)".postln;
"[darkpulsar] OSCdef \\darkLegend listening on /dark_legend (perceptual-legend previews)".postln;
"[darkpulsar] OSCdef \\darkMaster listening on /dark_master (web controller Vol + Mute)".postln;
)
