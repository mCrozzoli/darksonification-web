// GENERATED by web_implementation/build/build_web.py from sc/darkpulsar_synths.scd — do not edit here.
// Source sha256 220250bec63fd7c7; 1 substitution(s) + the fork wrap, listed in build_info.json.
// darkpulsar - profile buffer + the two voices that read it.
//
// THE SOUND DESIGN: each pulsar's 1024-bin pulse profile (its REAL averaged emission
// shape) is the shared sound material. ../assets/profiles.wav holds all 1297 profiles
// concatenated (offset = pulsar position * 1024); on each pulsar change the parser
// copies that pulsar's 1024 samples into ~wt (the live buffer). Two voices read ~wt:
//   L0 = \pulsarGrains : a Helmuth-style GRAIN CLOUD whose grains play snippets of the
//        profile, driven by the pulsar's PHYSICS (period/Edot/age/flux/DM/B-field), so
//        navigating the population morphs the texture and you HEAR its structure. The
//        period (since 2026-10-03) and Edot, B, age and flux (since 2026-10-04) are read
//        on LOG scales; DM stays linear.
//   L1 = \pulsarAudif  : REAL-RATE AUDIFICATION (after the Jodrell Bank "Sounds of Pulsars":
//        radio intensity -> audio amplitude): the AVERAGED profile, in order, shaping noise
//        at the pulsar's TRUE spin rate (every rotation identical), plus a SPOTLIGHT
//        scrub that brings forward the part of the rotation under the line.
// SUPERSEDED, kept below for reference only (not instantiated): \pulsarVoice (the original
// single-cycle wavetable, replaced by the L0 grain cloud) and \pulsarSynth (Curtis-Roads
// pulsar synthesis, the L1 voice until 2026-10-03 — see lab/findings/06 erratum).
fork {   // WEB BUILD: the desktop loads this file inside waitForBoot's Routine (its block ends with s.sync)
var dir = "/web"; var assets = "/web/assets";   /* WEB BUILD: nowExecutingPath is nil in a tab (build_web.py) */
~nBins = 1024;

// --- master gain / mute: a control bus EVERY voice multiplies by, so /dark_master
// (the web controller's Vol + Mute) is a true global cut. Distinct from the legend's
// ~liveMute (which only gates the live grain cloud). Allocate once; never realloc on
// reload or live voices read a stale bus index.
~masterBus = Bus.control(s, 1);
~masterBus.set(0.8);                   // vol 0.8, unmuted (matches the virtual controller)

~profiles = Buffer.read(s, (assets +/+ "profiles.wav").standardizePath, action: { |b|
    ("[darkpulsar] profiles loaded: " ++ b.numFrames ++ " samples (~"
     ++ (b.numFrames / ~nBins).asInteger ++ " pulsars)").postln;
});
~wt = Buffer.alloc(s, ~nBins, 1);     // the L0 grain cloud's live (active) profile

// --- L1 REAL-RATE AUDIFICATION assets (built by lab/code/export_audification.py) ---
//   spin_hz.wav      each pulsar's TRUE spin frequency 1/P in Hz (profile block order)
//   aa_nbins.wav     bins per rotation each pulsar is read with (fast ones band-limited)
//   profiles_aa.wav  anti-aliased profiles, one ~aaStride block per pulsar (wrap-padded)
// The two small ones go into language FloatArrays so the parser can look up EACH selected
// parent synchronously (the L1 OSC tick carries only intensity/phase). spin_hz also gives
// L0 its LOG-scale period position (~periodLogPos: 0 = fastest .. 1 = slowest).
~aaStride = 1032;
~profAA = Buffer.read(s, (assets +/+ "profiles_aa.wav").standardizePath, action: { |b|
    ("[darkpulsar] anti-aliased profiles loaded: "
     ++ (b.numFrames / ~aaStride).asInteger ++ " pulsars").postln;
});
~spinHz = nil; ~periodLogPos = nil;
Buffer.read(s, (assets +/+ "spin_hz.wav").standardizePath, action: { |b|
    b.loadToFloatArray(action: { |arr|
        var periods = arr.collect { |f| 1.0 / f };
        ~pMin = periods.minItem; ~pMax = periods.maxItem;
        ~lnPmin = ~pMin.log; ~lnPmax = ~pMax.log;
        ~periodLogPos = periods.collect { |p| (p.log - ~lnPmin) / (~lnPmax - ~lnPmin) };
        ~spinHz = arr;
        ("[darkpulsar] spin rates loaded: " ++ arr.size ++ " pulsars, "
         ++ arr.minItem.round(0.001) ++ " .. " ++ arr.maxItem.round(0.1) ++ " Hz").postln;
        b.free;
    });
});
~aaNbins = nil;
Buffer.read(s, (assets +/+ "aa_nbins.wav").standardizePath, action: { |b|
    b.loadToFloatArray(action: { |arr| ~aaNbins = arr; b.free });
});

// --- L0's Edot, B, age and flux on LOG scales (built by lab/code/export_driver_scales.py) ---
//   drivers_logpos.wav   4 x N log positions, in blocks: energy (Edot), field (B), age, loud (S1400)
//   drivers_lnrange.wav  ln min, ln max per driver (to convert a value that has no index)
// The parser looks each pulsar up by index (exact); see ~logDrivers in parse_darkpulsar.scd.
~drvLog = nil; ~drvLnMin = nil; ~drvLnMax = nil;
Buffer.read(s, (assets +/+ "drivers_logpos.wav").standardizePath, action: { |b|
    b.loadToFloatArray(action: { |arr|
        ~drvLog = arr;
        ("[darkpulsar] log driver positions loaded: " ++ (arr.size / 4).asInteger
         ++ " pulsars (Edot, B, age, flux)").postln;
        b.free;
    });
});
Buffer.read(s, (assets +/+ "drivers_lnrange.wav").standardizePath, action: { |b|
    b.loadToFloatArray(action: { |arr|
        ~drvLnMin = [arr[0], arr[2], arr[4], arr[6]];
        ~drvLnMax = [arr[1], arr[3], arr[5], arr[7]];
        b.free;
    });
});

SynthDef(\pulsarVoice, { |out = 0, wtbuf = 0, freq = 110, amp = 0.0,
                          cutoff = 6000, rq = 0.6, pan = 0|
    var phase, sig;
    // Phasor cycles the 1024-frame wavetable `freq` times per second.
    phase = Phasor.ar(0, ~nBins * freq / SampleRate.ir, 0, ~nBins);
    sig = BufRd.ar(1, wtbuf, phase, loop: 1, interpolation: 4);   // cubic
    sig = LeakDC.ar(sig);                                          // drop the pulse DC
    sig = RLPF.ar(sig, cutoff.varlag(0.08).clip(200, 18000), rq.varlag(0.08));
    sig = sig * amp.varlag(0.08);
    sig = sig.tanh;                                               // gentle safety drive
    Out.ar(out, Pan2.ar(sig, pan.varlag(0.1)));
}).add;

// L0 voice: Helmuth-style GRAIN CLOUD (replaces \pulsarVoice). The grains play
// snippets of the active pulsar's profile (~wt), and the cloud's character is driven
// by that pulsar's PHYSICS — so each pulsar is a distinct texture and moving through
// the population morphs them. Mapping (after Helmuth, "Letting Pulsars Sing"); the
// parser sets these from the OSC features we already send:
//   period -> dens (MSP => dense tone, slow pulsar => sparse audible ticks)
//   Edot   -> rate (grain pitch/brightness)    age -> dur (young grainy / old smooth)
//   flux   -> amp        DM -> cutoff (distant/scattered => duller)   B-field -> rq
SynthDef(\pulsarGrains, { |out = 0, wtbuf = 0, dens = 18, rate = 1.0, dur = 0.02,
                          amp = 0.0, cutoff = 8000, rq = 0.5, masBus = 0|
    var trig, pos, r, maxDur, gdur, grain, sig;
    r = rate.varlag(0.1).clip(0.25, 4.0);
    trig = Impulse.ar(dens.varlag(0.1).clip(1, 200));
    // the profile buffer is only ~23 ms (1024 samp); clamp each grain to at most one
    // playthrough at the current rate so GrainBuf never reads silence past the end.
    maxDur = BufDur.kr(wtbuf) / r;
    gdur = dur.varlag(0.1).clip(0.003, 0.3).min(maxDur * 0.98);
    // a wandering read-position into the profile + per-grain jitter => cloud texture
    pos  = (LFNoise1.kr(2.5).range(0, 1) + TRand.ar(-0.12, 0.12, trig)).wrap(0, 1);
    grain = GrainBuf.ar(2, trig, gdur, wtbuf, r, pos, 4, TRand.ar(-0.7, 0.7, trig)); // self-panned, stereo
    grain = LeakDC.ar(grain);
    sig = RLPF.ar(grain, cutoff.varlag(0.08).clip(200, 18000), rq.varlag(0.08));
    sig = (sig * amp.varlag(0.1)).tanh;
    sig = sig * In.kr(masBus).lag(0.05);          // master gain / mute
    Out.ar(out, sig);
}).add;

// SUPERSEDED (2026-10-03) — the former L1 voice, kept for reference, not instantiated.
// It mapped a MinMax-normalized period onto 300->3 Hz, which put 93% of pulsars above
// 100 Hz, and its scrub (duty) ignored the profile under the line. Replaced by
// \pulsarAudif below. Former header:
// L1 voice: Curtis Roads PULSAR SYNTHESIS — now POLYPHONIC (one per selected parent).
// One pulsaret per fundamental period (the audified rotation rate); the pulsaret is
// the pulse profile read once over duration d = duty/fund, windowed by a half-sine.
// The duty cycle is the L1 scrub: small => a short clicky pulsaret with a high formant
// (formant = fund/duty), duty=1 => a sustained tone. Sweeping `fund` across ~20 Hz is
// the rhythm<->pitch continuum, here straight from the pulsar's period.
//
// For polyphony each voice reads ITS OWN parent's 1024-sample slice of the SHARED
// profiles buffer via `bufOff` (= parentPosition * nBins) — so N parents layer as N
// distinct timbres at N distinct periods, instead of collapsing into one voice. A
// gated ASR env (doneAction:2) lets the parser free a voice cleanly when its parent
// is deselected.
SynthDef(\pulsarSynth, { |out = 0, profbuf = 0, bufOff = 0, fund = 20, duty = 0.3,
                          amp = 0.0, cutoff = 8000, rq = 0.5, pan = 0, gate = 1, masBus = 0|
    var f, d, trig, ramp, win, pulsaret, env, eg, sig, pdur, span, start;
    f = fund.varlag(0.1).clip(0.5, 2000);
    d = duty.varlag(0.08).clip(0.04, 1.0);
    trig = Impulse.ar(f);
    // ramp 0..1 over the pulsaret duration (d/f seconds); >1 afterwards = silence
    ramp = Sweep.ar(trig, f / d);
    win  = ramp < 1;                                     // pulsaret gate (duty fraction)
    // ANTI-ALIAS + PULSE-CENTRED READ.  The pulsaret lasts d/f seconds.  Traversing all
    // ~nBins of the profile inside a pulsaret SHORTER than the profile decimates it with
    // no lowpass — which aliased into a harsh digital "crush" for every millisecond
    // pulsar (measured: 38% of the energy above 8 kHz at the minimum duty).  It was also
    // the wrong content: these profiles are ~97.5% off-pulse NOISE, with a median pulse
    // just 25 bins wide, and 99.3% of them peak within +/-64 bins of centre.
    // So: traverse at most 1:1 (never faster than the profile's own rate), windowed on
    // the CENTRE — a short pulsaret then plays the PULSE itself, cleanly, and a long one
    // opens out towards the whole rotation.
    pdur  = (d / f) * SampleRate.ir;                     // pulsaret length, in samples
    span  = min(~nBins, pdur);                           // bins traversed: <= 1:1, no aliasing
    start = (~nBins - span) * 0.5;                       // centred on the pulse
    pulsaret = BufRd.ar(1, profbuf, bufOff + start + (ramp.clip(0, 1) * span), loop: 0, interpolation: 4);
    env = sin(ramp.clip(0, 1) * pi);                     // half-sine pulsaret window
    sig = pulsaret * env * win;
    sig = LeakDC.ar(sig);
    sig = RLPF.ar(sig, cutoff.varlag(0.08).clip(200, 18000), rq.varlag(0.08));
    eg  = EnvGen.kr(Env.asr(0.05, 1, 0.2), gate, doneAction: 2);   // gate=0 -> 0.2s release + free
    sig = (sig * amp.varlag(0.08) * eg).tanh;
    sig = sig * In.kr(masBus).lag(0.05);          // master gain / mute
    Out.ar(out, Pan2.ar(sig, pan.varlag(0.1)));
}).add;

// L1 voice: REAL-RATE AUDIFICATION (the Jodrell Bank approach) + a SPOTLIGHT scrub.
// POLYPHONIC: one per selected parent, each reading its own ~aaStride block (\bufOff).
// The averaged pulse profile is an INTENSITY envelope (power vs rotation phase), so it
// shapes a NOISE carrier — radio emission is noise-like — and repeats at the pulsar's
// TRUE spin rate: slow pulsars tick, fast ones become tones, as in the radio-astronomy
// recordings, and each tick / cycle carries the real pulse shape (width, components,
// interpulse, scattering tail). (Played directly as a waveform, a typical pulse would be
// a sub-bass thud under ~70 Hz.) Fast pulsars read a band-limited copy with `nb` bins per
// rotation, so the envelope is never read faster than one bin per sample (no aliasing).
// SPOTLIGHT (the L1 scrub): the part of each rotation within `width` of the scrub phase
// `spot` plays at full level, the rest at `base` — dragging across the profile brings
// forward whatever lies under the line.
// THE ROTATION YOU HEAR (2026-10-05): the voice reports its own phase 20 times a second (SendReply,
// replyID = the pulsar's `idx`; -1 = a voice nobody draws, e.g. the legend's pulse solo). The parser relays
// it to the viz bridge and the page draws it as a dot riding the profile, so the picture shows the sound's
// clock, not only the spotlight's. Nothing audible changes.
SynthDef(\pulsarAudif, { |out = 0, profbuf = 0, bufOff = 0, nb = 1024, freq = 1, amp = 0.0,
                          spot = 0.5, width = 0.06, base = 0.3, pan = 0, gate = 1, masBus = 0, idx = -1|
    var ph, env, dist, win, sig, eg;
    ph   = Phasor.ar(0, freq / SampleRate.ir, 0, 1);                  // rotation phase, real rate
    SendReply.kr(Impulse.kr(20) * (idx >= 0), '/dp_l1ph', A2K.kr(ph), idx);   // -> the page's playhead
    env  = BufRd.ar(1, profbuf, bufOff + (ph * nb), loop: 0, interpolation: 4).clip(0, 1);
    dist = ((ph - spot.lag(0.05) + 0.5).wrap(0, 1) - 0.5).abs;        // circular distance to the line
    win  = (1 - (dist / width)).clip(0, 1);                            // triangle spotlight
    sig  = WhiteNoise.ar * env * (base + ((1 - base) * win));
    sig  = HPF.ar(LPF.ar(sig, 9000), 40);
    eg   = EnvGen.kr(Env.asr(0.05, 1, 0.3), gate, doneAction: 2);     // gate=0 -> release + free
    sig  = (sig * amp.lag(0.08) * eg).tanh;
    sig  = sig * In.kr(masBus).lag(0.05);                              // master gain / mute
    Out.ar(out, Pan2.ar(sig, pan.lag(0.1)));
}).add;
s.sync;

~grainVoice = Synth(\pulsarGrains, [\wtbuf, ~wt, \amp, 0, \masBus, ~masterBus]);   // L0 grain cloud, silent
// L1 voices are allocated ON DEMAND (one \pulsarAudif per selected parent) by the
// parser, added after ~grainVoice; see parse_darkpulsar.scd (~psVoices dictionary).
"[darkpulsar] synths loaded; L0 grain-cloud + on-demand polyphonic L1 voices ready".postln;
~webSynthsReady = true;   // WEB BUILD: engine.js waits for this, not for a post line
}
