~drvLnMax = [88.9941483, 31.9447155, 24.1561184, 6.95654535];
// derived exactly as darkpulsar_synths.scd's spin_hz callback derives them
~periodLogPos = nil;
{
    var periods = ~spinHz.collect { |f| 1.0 / f };
    ~pMin = periods.minItem; ~pMax = periods.maxItem;
    ~lnPmin = ~pMin.log; ~lnPmax = ~pMax.log;
    ~periodLogPos = periods.collect { |p| (p.log - ~lnPmin) / (~lnPmax - ~lnPmin) };
}.value;
~webTablesReady = true;
("[web] tables: " ++ ~spinHz.size ++ " pulsars, spin " ++ ~spinHz.minItem.round(0.001) ++ " .. " ++ ~spinHz.maxItem.round(0.1)
 ++ " Hz, log drivers " ++ (~drvLog.size / 4).asInteger ++ " × 4").postln;
)
