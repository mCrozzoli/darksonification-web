// GENERATED by web_implementation/build/build_web.py from sc/hugur_synths.scd (sha256 20b73fac08eac0f1) with sc/hugur_synthdefs.scd (sha256 fe419909d76ba5ae) inlined — do not edit here.
// 0 substitution(s) + the fork wrap + the inlining, listed in build_info.json.
// dark_hugur synths — sci-fi bed (DESIGN_SKETCH §8, lab/RUNNER_CONTRACT.md)
// The six SynthDefs are ONE file, hugur_synthdefs.scd, whose value is their Array (nothing added there): the live
// show (this file), the NRT render (slides/render/render_hugur_clips.scd) and the web build all read that one copy
// (WEB_P1_DESIGN.md §3 S1, 2026-10-08). This file adds them to the default server.
// Shape contract with web_implementation/build/build_web.py: one `(` line, one `)` line, no s.sync (fork_wrap turns
// the block into a fork and ADDS the s.sync + ~webSynthsReady); the `var dir` line and the one `~defs = …` read line
// are the anchors the build replaces by the synthdefs file's text (the WASM sclang has no file access).
fork {   // WEB BUILD: the s.sync below needs a Routine (the desktop covers the d_recv race with hugur_boot.scd's 1.wait)
// WEB BUILD: the loader's `var dir = …` line (the running file's folder) is dropped here — no file access in a tab
~synths = ~synths ? Dictionary.new;
// WEB BUILD: sc/hugur_synthdefs.scd is inlined here in place of its read line — the WASM sclang has no file access
~defs = (
// dark_hugur — the six SynthDefs, ONE copy (WEB_P1_DESIGN.md §3 S1; the bodies moved verbatim from hugur_synths.scd,
// which was identical to the render's copy — comment-stripped diff, 2026-10-08).
//
// The value of this file is the Array of the six SynthDefs, NOT added: every reader decides what to do with them —
//   sc/hugur_synths.scd                  ~defs = this file's value; ~defs.do(_.add)                   (the live show)
//   slides/render/render_hugur_clips.scd ~defs.do { |d| score.add([0.0, [\d_recv, d.asBytes]]) }     (the NRT clips)
//   web_implementation (build_web.py)    this text inlined into hugur_synths.scd in place of the read  (the WASM sclang has no file access)
// so it holds no `var`, no `.add`, no `s`, no path or read idiom (the build counts those), and no line that is only
// `(` or `)` (fork_wrap counts those).
//
// Layers: subBed (never stops) · pad (field-colored, spectral) · whisper (formant noise)
// · ping (comm blip) · shepard (query glide) · tok (L1 token events).
// Persistent voices use .lag()-ed params + .set() morphing (skyr convention); per-event
// synths are fire-and-forget (doneAction: 2). Master = per-synth \master param, set by
// ~applyMaster (darkquake convention). No pattern is freed on L0<->L1 — level 1 ducks.
[
// ---------------------------------------------------------------- sub bed --
// the bed ACROSS the fields (WEB_PLAN §13.2, Miguel 2026-10-12): three statistics of the window's eight feelings
//   bright  (feel, driver 16)   how much feeling overall: two upper partials, 110 and 165 Hz, open the floor
//   spread  (focus, driver 17)  one feeling or many: every tone gets a detuned twin — beating, a wider window of frequencies
//   flutter (change, driver 18) how fast the feeling moves along the story: the floor trembles, faster the more it moves
SynthDef(\hugurSub, { |gate = 1, amp = 0.20, master = 0.8, duck = 0, bright = 0, spread = 0, flutter = 0|
    var env = EnvGen.kr(Env.asr(4, 1, 6), gate, doneAction: 2);
    var wob = SinOsc.kr(0.05, 0, 0.15, 0.85);
    var sp  = spread.lag(3) * 0.02;
    var tone = { |f, a| (SinOsc.ar(f * (1 - sp)) + SinOsc.ar(f * (1 + sp))) * 0.5 * a };
    var sig = tone.(41.25, 0.6) + tone.(55.0, 0.45) + tone.(82.5, 0.12);
    var top = ((SinOsc.ar(110.0) * 0.25) + (SinOsc.ar(165.0) * 0.12)) * bright.lag(3);
    var fl  = flutter.lag(2);
    var trem = 1 - (fl * 0.5 * LFNoise2.kr(2 + (fl * 6)).range(0, 1));
    var dk  = 1 - (duck.lag(0.8) * 0.65);
    sig = LeakDC.ar(sig + top) * trem * wob * amp.lag(0.6) * master.lag(0.3) * dk * env;
    Out.ar(0, sig ! 2);
}),

// -------------------------------------------------------- pad (the field) --
// One persistent voice; ALL affect coloration arrives via .set from ~applyDrivers.
// Each field carries a SIGNATURE (a difference in KIND, not degree — Juslin&Laukka):
//   anger    -> rough:  saturation + fast AM bite
//   body     -> swell:  inharmonic partial rising in slow pressure waves
//   fear     -> shiver: irregular fast flutter (amp + pitch micro-jitter)
//   grief    -> dark + sigh (slow falling semitone contour)
//   tears    -> darkest + heavy sigh (the weeping contour)
//   laughter -> bright + grains: staccato plinks scattered on top
//   shame    -> fifth:  grave parallel fifth below the root (ceremonial weight)
//   silence  -> gap:    the bed literally opens gaps
// plus grammar: unstable=subjunctive vibrato, fold=middle-voice comb,
// presence=query closeness (dry/close vs distant/wet)
SynthDef(\hugurPad, { |gate = 1, amp = 0.16, master = 0.8, duck = 0,
                      root = 110, dark = 0, heat = 0, bright = 0,
                      unstable = 0, fold = 0, gap = 0, presence = 0.4,
                      rough = 0, swell = 0, shiver = 0, grains = 0,
                      fifth = 0, sigh = 0|
    var env = EnvGen.kr(Env.asr(3, 1, 5), gate, doneAction: 2);
    var rt  = root.lag(4);
    var sighMod = 1 - (sigh.lag(2) * 0.055 * SinOsc.kr(0.09).range(0, 1));
    var vib = SinOsc.kr(4.3 + (unstable.lag(2) * 2), 0, unstable.lag(2) * 0.02);
    var shv = shiver.lag(1.5);
    var flutter = 1 - (shv * 0.45 * LFNoise2.kr(11).range(0, 1));
    var jitter = 1 + (shv * 0.009 * LFNoise1.kr(9));
    var dtn = 1 + (heat.lag(2) * 0.012) + (swell.lag(2) * 0.018);
    var sig = Mix.fill(5, { |i|
        var f = rt * sighMod * jitter * (i + 1).sqrt * (dtn ** i) * (1 + vib);
        Saw.ar(f * [0.999, 1.001]).sum * (0.5 ** i);
    }) * 0.14;
    var cut, rq, roughAmt, roughSig, grAmt, plink;
    // shame/honor: grave parallel fifth below (sub-root + its fifth)
    sig = sig + (Saw.ar(rt * sighMod * [0.5, 0.7495]).sum * (fifth.lag(2) * 0.11));
    // body: inharmonic partial breathing in slow pressure waves
    sig = sig + (SinOsc.ar(rt * 1.618 * sighMod)
                 * (swell.lag(2) * LFTri.kr(0.13).range(0.15, 1) * 0.16));
    cut = (rt * (3 + (bright.lag(2) * 8)) * (1 - (dark.lag(3) * 0.72))).clip(80, 8000);
    rq  = (0.55 - (heat.lag(2) * 0.35)).clip(0.15, 0.8);
    sig = RLPF.ar(sig, cut, rq);
    // anger: roughness — saturated, bitten by fast AM
    roughAmt = rough.lag(1.5);
    roughSig = ((sig * (1 + (roughAmt * 6))).tanh)
               * (1 - (SinOsc.ar(33).range(0, 0.5) * roughAmt));
    sig = (sig * (1 - (roughAmt * 0.8))) + (roughSig * (roughAmt * 0.8));
    // laughter: bright staccato plinks scattered over the bed
    grAmt = grains.lag(1);
    plink = SinOsc.ar(rt * sighMod * (4 + LFNoise0.kr(5).range(0, 4)).round(1))
            * Decay2.kr(Dust.kr(2 + (grAmt * 6)), 0.004, 0.14) * (grAmt * 0.3);
    sig = sig + plink;
    sig = sig * flutter;
    sig = sig + (CombL.ar(sig, 0.05, 0.031, fold.lag(2) * 2.5) * (fold.lag(2) * 0.6));
    // silence field: the bed opens GAPS (fast enough to hear in a short hold)
    sig = sig * (1 - (gap.lag(1) * LFPulse.kr(0.7, 0, 0.42).lag(0.12) * 0.95));
    sig = XFade2.ar(
        FreeVerb2.ar(sig, sig, 0.85, 0.92, 0.6),
        sig, (presence.lag(2) * 2) - 1);
    sig = LeakDC.ar(sig) * amp.lag(1) * master.lag(0.3) * (1 - (duck.lag(0.8) * 0.6)) * env;
    Out.ar(0, sig ! 2);
}),

// ------------------------------------------------- whisper (direct speech) --
// Formant-filtered noise = voiceless vowels: speech-adjacent, zero semantics.
// vowelMix morphs a-formants (grief, dark) <-> i-formants (laughter, bright).
SynthDef(\hugurWhisper, { |gate = 1, amp = 0, master = 0.8, vowelMix = 0.5|
    var env = EnvGen.kr(Env.asr(1.5, 1, 2.5), gate, doneAction: 2);
    var n = PinkNoise.ar(1);
    var f1 = LinLin.kr(vowelMix.lag(3), 0, 1, 750, 290);
    var f2 = LinLin.kr(vowelMix.lag(3), 0, 1, 1200, 2250);
    var f3 = 2800;
    var sig = (BPF.ar(n, f1.lag(0.5), 0.12) * 1.4)
            + (BPF.ar(n, f2.lag(0.5), 0.10) * 0.8)
            + (BPF.ar(n, f3, 0.14) * 0.35);
    var breath = LFNoise2.kr(0.4).range(0.5, 1);
    sig = sig * breath * amp.lag(1.2).clip(0, 0.5) * master.lag(0.3) * env;
    Out.ar(0, sig ! 2);
}),

// --------------------------------------------- ping (transmission received) --
// The dative-experiencer gesture: an exogenous blip that bends the space.
SynthDef(\hugurPing, { |freq = 1180, amp = 0.18, master = 0.8, pan = 0|
    var env = EnvGen.kr(Env.perc(0.004, 0.9, curve: -6), doneAction: 2);
    var sig = SinOsc.ar(freq * EnvGen.kr(Env([1.02, 1, 0.985], [0.02, 0.6])),
                        SinOsc.ar(freq * 1.5) * 2.2) * env;
    sig = sig + CombL.ar(sig, 0.4, 0.31, 2.4, 0.35);
    Out.ar(0, Pan2.ar(sig * amp * master, pan));
}),

// ---------------------------------------------------- shepard (query glide) --
SynthDef(\hugurShepard, { |amp = 0.14, master = 0.8, dur = 2.5, sim = 0.5|
    var env = EnvGen.kr(Env.sine(dur), doneAction: 2);
    var sweep = Line.kr(0, 1, dur);
    var sig = Mix.fill(6, { |i|
        var oct = (i + sweep).mod(6);
        var f = 55 * (2 ** oct);
        var win = (1 - ((oct - 3).abs / 3)).max(0) ** 2;   // raised-cos spectral window
        SinOsc.ar(f) * win;
    }) * 0.2;
    sig = LPF.ar(sig, 3200);
    Out.ar(0, (sig * env * amp * (0.4 + (sim * 0.6)) * master) ! 2);
}),

// ------------------------------------------------------- tok (L1 playback) --
// pitch01 = register by PoS class; keyword = accent (+7 st, brighter, longer);
// inQuote = formant color (a mouth); seedField >= 0 = field-tinted ring mod.
SynthDef(\hugurTok, { |pitch01 = 0.5, dur = 0.3, kw = 0, quote = 0,
                      fieldRatio = 0, amp = 0.16, master = 0.8|
    var midi = 40 + (pitch01 * 26) + (kw * 7);
    var f = midi.midicps;
    var env = EnvGen.kr(
        Env.perc(0.008 + (kw * 0.01), dur * (1.6 + (kw * 1.2)), curve: -5),
        doneAction: 2);
    var sig = (SinOsc.ar(f) * 0.7) + (Pulse.ar(f, 0.32) * (0.12 + (kw * 0.22)));
    sig = Select.ar(quote, [sig, BPF.ar(sig * 2.4, 900, 0.4) + (sig * 0.4)]);
    sig = Select.ar((fieldRatio > 0).asInteger,
                    [sig, sig * (1 + (SinOsc.ar(f * fieldRatio) * 0.5))]);
    sig = sig * env * (amp + (kw * 0.10)) * master;
    Out.ar(0, Pan2.ar(sig, LFNoise1.kr(1) * 0.3));
})
]
);
~defs.do(_.add);
"[dark_hugur] synths added.".postln;
s.sync;   // WEB BUILD: every SynthDef.add above has reached scsynth
~webSynthsReady = true;   // WEB BUILD: engine.js waits for this, not for a post line
}
