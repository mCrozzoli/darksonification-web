// dark_hugur OSC parser — lab/RUNNER_CONTRACT.md
// The cooking lives in hugur_cook.scd (~cookDrivers: the 16 drivers → pad params + layer amps, server-free; the NRT
// render and the web read the same file — WEB_P1_DESIGN.md §3 S2, 2026-10-08). ~applyDrivers below is the thin
// APPLIER: cook, multiply by the SOUND faders (~layerGain, /dark/layer), set the three voices, fire the ping. Live
// nav (/dark/drivers), legend previews (/dark/legend iso|site) and query focus all route through it (C5 §19.2).
// Driver vector (19 floats, 0..1, brain-normalized; v3, 2026-10-12):
//   0 anger 1 body 2 fear 3 grief 4 laughter 5 shame_honor 6 silence 7 tears
//   8 subj 9 middle 10 neg 11 litotes 12 experiencer 13 speech 14 pos 15 sim · 16 feel 17 focus 18 change (the bed)
// Shape contract with web_implementation/build/build_web.py: the `var dir` line and the one `(dir +/+
// "hugur_cook.scd")…` read line below are the anchors the build replaces by the cook file's text.

(
// WEB BUILD: the loader's `var dir = …` line (the running file's folder) is dropped here — no file access in a tab
// WEB BUILD: sc/hugur_cook.scd is inlined here in place of its read line (// ~fieldRing · ~layerGain · ~cookDrivers · ~pingDue · ~pingArgs) — the WASM sclang has no file access
(
// dark_hugur — the cooking, server-free (WEB_P1_DESIGN.md §3 S2, 2026-10-08): the 16-float driver vector becomes
// the pad's parameters and the three layer amplitudes HERE and nowhere else (C5 §19.2). parse_hugur.scd reads this
// file and applies the result to the running voices (~applyDrivers, the thin applier); the NRT render reads it to
// spawn its voices with the same numbers; the web build inlines this text into the parser. So: no Synth, no `s`,
// no `var` at the top, no path or read idiom — tables and functions only. Every number is the live cooking's of
// 2026-08-31 (parse_hugur.scd L27–82 then), the whisper-solo floor included.
//
// Driver vector (19 floats, 0..1, brain-normalized; lab/RUNNER_CONTRACT.md v3):
//   0 anger 1 body 2 fear 3 grief 4 laughter 5 shame_honor 6 silence 7 tears
//   8 subj 9 middle 10 neg 11 litotes 12 experiencer 13 speech 14 pos 15 sim
//   16 feel 17 focus 18 change — the bed's statistics across the eight fields (WEB_PLAN §13.1, 2026-10-12)
// (driver 10, neg, is bound and never read — as in the live cooking since July: a design question, not fixed here)

// tok tint per field index: the L1 step's ring-mod ratio (/dark/l1/tok's seedFieldIdx; -1 = none)
~fieldRing = [1.5, 0.5, 2.7, 0.75, 3.1, 1.25, 0.25, 0.66];

// the SOUND faders (/dark/layer s name f gain, 0..1): bed = the sub, pad, whisper, events = ping · shepard · tok.
// Kept across a re-evaluation like the parser's state (~masterVol …). Nothing here multiplies: the readers do.
~layerGain = ~layerGain ? (bed: 1, pad: 0.28, whisper: 0.5, events: 0.84);   // the defaults Miguel set by ear (2026-10-12; brain.py / hugur_brain.js / the page mirror them)

// ---------------------------------------------------------------- THE cooking --
// v = the 16 drivers; solo = \all | \bed | \pad | \whisper (the legend's hold-to-solo). Returns an Event:
//   pad                       the 15 (name, value) pairs the applier sets on \hugurPad, \amp (= padAmp) included
//   padAmp · subAmp · whAmp   the three layer amplitudes BEFORE the faders (~layerGain) and the master
//   vowelMix                  the whisper's a <-> i morph
//   exp                       the raw experiencer driver (the ping gate's input)
//   root                      the pad's root in Hz
//   sub                       the bed's three controls from the statistics: [\bright, feel, \spread, focus, \flutter, change]
~cookDrivers = { |v, solo = \all|
    var anger = v[0], body = v[1], fear = v[2], grief = v[3], laugh = v[4];
    var shame = v[5], silence = v[6], tears = v[7];
    var subj = v[8], middle = v[9], neg = v[10], lito = v[11];
    var exp = v[12], speech = v[13], pos = v[14], sim = v[15];
    var feel = (v[16] ? 0).clip(0, 1), focus = (v[17] ? 0).clip(0, 1), change = (v[18] ? 0).clip(0, 1);   // v3; a 16-vector reads 0

    // one SIGNATURE per field (kind, not degree): anger=rough bite, body=swelling
    // pressure, fear=shiver, grief/tears=dark falling sigh, laughter=bright plinks,
    // shame=grave fifth, silence=gaps
    var dark     = ((grief * 0.55) + (tears * 0.75)).clip(0, 1);
    var sigh     = ((grief * 0.7) + (tears * 0.9)).clip(0, 1);
    var heat     = anger.clip(0, 1);
    var rough    = anger.clip(0, 1);
    var swell    = body.clip(0, 1);
    var shiver   = fear.clip(0, 1);
    var bright   = laugh.clip(0, 1);
    var grains   = laugh.clip(0, 1);
    var fifth    = shame.clip(0, 1);
    var unstable = ((subj * 0.7) + (fear * 0.2)).clip(0, 1);
    var fold     = middle.clip(0, 1);
    var gap      = max(silence, lito * 0.5).clip(0, 1);
    var presence = (0.35 + (sim * 0.6)).clip(0, 1);
    var root     = (42 + (pos * 10) - (shame * 2)).midicps;
    var padAmp   = if ((solo == \all) or: { solo == \pad }) { 0.16 } { 0 };
    var subAmp   = if ((solo == \all) or: { solo == \bed }) { 0.20 } { 0 };
    // a soloed conditional layer must DEMO audibly (C5 §19.2): under whisper solo
    // the speech share is floored, else soloing on plain narration teaches silence
    var whAmp    = case
        { solo == \whisper } { (max(speech, 0.6) * 0.40).clip(0, 0.4) }
        { solo == \all }     { (speech * 0.40).clip(0, 0.4) }
        { 0 };
    (                                                   // the cooked values
        pad: [\root, root, \dark, dark, \heat, heat, \bright, bright,
              \unstable, unstable, \fold, fold, \gap, gap,
              \presence, presence, \amp, padAmp,
              \rough, rough, \swell, swell, \shiver, shiver,
              \grains, grains, \fifth, fifth, \sigh, sigh],
        padAmp: padAmp, subAmp: subAmp, whAmp: whAmp,
        vowelMix: (((laugh - grief) + 1) * 0.5).clip(0, 1),
        exp: exp, root: root,
        sub: [\bright, feel, \spread, focus, \flutter, change]
    )                                                   // ← ~cookDrivers' value
};

// dative experiencer: exogenous strike (transmission received). Rate-limited: a landing pings, but a fast DRAG
// across experiencer-heavy sites must not machine-gun the blip (the PM spectrum reads as scratch).
// now / lastAt in seconds (Main.elapsedTime live); the NRT render stages its own two strikes instead.
~pingDue = { |exp, lastExp, now, lastAt|
    (exp > 0.45) and: { exp > (lastExp + 0.15) } and: { (now - lastAt) > 0.4 }
};
// the ping's freq and amp from the experiencer driver; events = the events fader (1 = the live numbers, ×1 exact)
~pingArgs = { |exp, events = 1|
    [\freq, 980 + (exp * 700), \amp, (0.12 + (exp * 0.1)) * events]
};
);

~masterVol = ~masterVol ? 0.8;
~masterMuted = ~masterMuted ? false;
~solo = ~solo ? \all;
~previewOn = ~previewOn ? false;
~lastDrivers = ~lastDrivers ? (0 ! 19);
~lastApplied = ~lastApplied ? ~lastDrivers;   // what the voices play now: the live site, or a held legend preview
~lastExp = ~lastExp ? 0;
~lastPingAt = ~lastPingAt ? 0;

~applyMaster = {
    var m = if (~masterMuted) { 0 } { ~masterVol };
    [\sub, \pad, \whisper].do { |k|
        if (~synths[k].notNil) { ~synths[k].set(\master, m) };
    };
};

// ------------------------------------------------------ the thin applier --
// cook → × faders → .set. The numbers are hugur_cook.scd's; every fader at 1 leaves them untouched (×1 is exact).
~applyDrivers = { |v|
    var c = ~cookDrivers.(v, ~solo);
    var pad, ai;
    ~lastApplied = v;
    if (~synths[\pad].notNil) {
        pad = c[\pad].copy;
        ai = pad.indexOf(\amp);
        pad[ai + 1] = pad[ai + 1] * ~layerGain[\pad];
        ~synths[\pad].set(*pad);
    };
    if (~synths[\sub].notNil) { ~synths[\sub].set(\amp, c[\subAmp] * ~layerGain[\bed], *c[\sub]) };   // + bright · spread · flutter (v3)
    if (~synths[\whisper].notNil) {
        ~synths[\whisper].set(\amp, c[\whAmp] * ~layerGain[\whisper], \vowelMix, c[\vowelMix]);
    };
    // dative experiencer: exogenous strike (transmission received), rate-limited — the gate is hugur_cook.scd's
    if (~pingDue.(c[\exp], ~lastExp, Main.elapsedTime, ~lastPingAt)) {
        ~lastPingAt = Main.elapsedTime;
        Synth(\hugurPing, ~pingArgs.(c[\exp], ~layerGain[\events])
                          ++ [\master, if (~masterMuted) { 0 } { ~masterVol }, \pan, 1.0.rand2]);
    };
    ~lastExp = c[\exp];
};

// ----------------------------------------------------------------- OSCdefs --
OSCdef(\hugurDrivers).free; OSCdef(\hugurLevel).free;
OSCdef(\hugurL1Start).free; OSCdef(\hugurL1Tok).free; OSCdef(\hugurL1End).free;
OSCdef(\hugurQuery).free; OSCdef(\hugurLegend).free;
OSCdef(\hugurMaster).free; OSCdef(\hugurMute).free; OSCdef(\hugurLayer).free;

OSCdef(\hugurDrivers, { |msg|
    var vals = msg[2..20].collect(_.asFloat);           // msg[1] = siteId; 19 floats (v3) — a 16-float sender leaves the bed's three at 0
    ~lastDrivers = vals;
    if (~previewOn.not) { ~applyDrivers.(vals) };
}, '/dark/drivers');

OSCdef(\hugurLevel, { |msg|
    var lvl = msg[1].asInteger;                          // duck (pause spirit), never free
    [\sub, \pad].do { |k| if (~synths[k].notNil) { ~synths[k].set(\duck, lvl) } };
}, '/dark/level');

OSCdef(\hugurL1Start, { |msg|
    ("[hugur] L1 start site %  (% tokens)".format(msg[1], msg[2])).postln;
}, '/dark/l1/start');

OSCdef(\hugurL1Tok, { |msg|
    // [t, pitch01, dur, isKeyword, seedFieldIdx, inQuote]
    var pitch = msg[2].asFloat, dur = msg[3].asFloat;
    var kw = msg[4].asInteger, seed = msg[5].asInteger, quote = msg[6].asInteger;
    Synth(\hugurTok, [
        \pitch01, pitch, \dur, dur, \kw, kw, \quote, quote,
        \fieldRatio, if (seed >= 0) { ~fieldRing.clipAt(seed) } { 0 },
        \amp, 0.16 * ~layerGain[\events],                // 0.16 = \hugurTok's default amp, × the events fader
        \master, if (~masterMuted) { 0 } { ~masterVol }]);
}, '/dark/l1/tok');

OSCdef(\hugurL1End, { "[hugur] L1 end".postln }, '/dark/l1/end');

OSCdef(\hugurQuery, { |msg|
    Synth(\hugurShepard, [\sim, msg[1].asFloat.clip(0, 1),
                          \amp, 0.14 * ~layerGain[\events],   // 0.14 = \hugurShepard's default amp, × the events fader
                          \master, if (~masterMuted) { 0 } { ~masterVol }]);
}, '/dark/query');

OSCdef(\hugurLegend, { |msg|
    var cmd = msg[1].asString;
    case
    { (cmd == "iso") or: { cmd == "site" } } {
        ~previewOn = true;
        ~applyDrivers.(msg[2..20].collect(_.asFloat));
    }
    { cmd == "solo" } {
        ~solo = msg[2].asString.asSymbol;
        ~applyDrivers.(~lastDrivers);
    }
    { cmd == "end" } {
        ~previewOn = false;
        ~solo = \all;
        ~applyDrivers.(~lastDrivers);
    };
}, '/dark/legend');

OSCdef(\hugurMaster, { |msg|
    ~masterVol = msg[1].asFloat.clip(0, 1);
    ~applyMaster.();
}, '/dark/master');

OSCdef(\hugurMute, { |msg|
    ~masterMuted = (msg[1].asInteger == 1);
    ~applyMaster.();
}, '/dark/mute');

OSCdef(\hugurLayer, { |msg|
    // [s name, f gain]: name ∈ bed | pad | whisper | events, gain clipped 0..1 (the SOUND faders). A running voice
    // follows at once: the vector it plays (live site or held preview) is re-applied; ~lastExp is already that
    // vector's experiencer, so the re-apply never fires a ping. An unknown name is ignored.
    var name, gain;
    if (msg.size >= 3) {
        name = msg[1].asString.asSymbol;
        gain = msg[2].asFloat.clip(0, 1);
        if (~layerGain.includesKey(name)) {
            ~layerGain[name] = gain;
            ~applyDrivers.(~lastApplied);
        };
    };
}, '/dark/layer');

// -------------------------------------------------- persistent bed spawn --
if (~synths[\sub].isNil)     { ~synths[\sub] = Synth(\hugurSub) };
if (~synths[\pad].isNil)     { ~synths[\pad] = Synth(\hugurPad) };
if (~synths[\whisper].isNil) { ~synths[\whisper] = Synth(\hugurWhisper) };
~applyMaster.();
~applyDrivers.(~lastDrivers);

("[dark_hugur] READY — /dark/* on sclang langPort " ++ NetAddr.langPort).postln;
)
